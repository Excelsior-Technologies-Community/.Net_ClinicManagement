@model ClinicManagementSystem.Models.PaymentModel

@{
    ViewData["Title"] = "View Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="row mb-4">

        <div class="col-lg-12">

            <div class="card border-0 shadow">

                <div class="card-body bg-primary text-white rounded">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fa-solid fa-credit-card me-2"></i>

                                Payment Details

                            </h2>

                            <p class="mb-0">

                                View complete payment information.

                            </p>

                        </div>

                        <a asp-action="ManagePayments"
                           class="btn btn-light">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <!-- Doctor Information -->

        <div class="col-lg-4 mb-4">

            <div class="card shadow border-0 h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-user-doctor me-2"></i>

                        Doctor Information

                    </h5>

                </div>

                <div class="card-body text-center">

                    @if (!string.IsNullOrEmpty(Model.DoctorImage))
                    {
                        <img src="~/Department/@Model.DoctorImage"
                             class="rounded-circle doctor-img mb-3"
                             style="width:170px;height:170px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/no-image.png"
                             class="rounded-circle doctor-img mb-3"
                             style="width:170px;height:170px;object-fit:cover;" />
                    }

                    <h4 class="fw-bold text-primary">

                        Dr. @Model.DoctorName

                    </h4>

                    <hr />

                    <table class="table table-borderless mb-0">

                        <tr>

                            <th width="40%">

                                Department

                            </th>

                            <td>

                                @Model.DepartmentName

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Appointment No

                            </th>

                            <td>

                                @Model.AppointmentNo

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Appointment Date

                            </th>

                            <td>

                                @(Model.AppointmentDate?.ToString("dd MMM yyyy"))

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Appointment Time

                            </th>

                            <td>

                                @(Model.AppointmentTime?.ToString(@"hh\:mm"))

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Customer & Payment Information -->

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-header bg-info text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>

                        Payment Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Customer Name

                            </label>

                            <input class="form-control"
                                   value="@Model.CustomerName"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Mobile Number

                            </label>

                            <input class="form-control"
                                   value="@Model.MobileNo"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Email Address

                            </label>

                            <input class="form-control"
                                   value="@Model.Email"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Payment ID

                            </label>

                            <input class="form-control"
                                   value="@Model.PaymentId"
                                   readonly />

                        </div>

                        <hr class="my-3" />

                        <h5 class="text-primary mb-3">

                            <i class="fa-solid fa-wallet me-2"></i>

                            Payment Summary

                        </h5>
                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Amount

                            </label>

                            <input class="form-control fw-bold text-success"
                                   value="₹ @Model.Amount.ToString("N2")"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Payment Method

                            </label>

                            <input class="form-control"
                                   value="@Model.PaymentMethod"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Transaction ID

                            </label>

                            <input class="form-control"
                                   value="@Model.TransactionId"
                                   readonly />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Payment Date

                            </label>

                            <input class="form-control"
                                   value="@(Model.PaymentDate?.ToString("dd MMM yyyy hh:mm tt"))"
                                   readonly />

                        </div>

                        <div class="col-md-12 mb-4">

                            <label class="form-label fw-bold">

                                Payment Status

                            </label>

                            <br />

                            @if (Model.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success fs-6 px-4 py-2">

                                    <i class="fa-solid fa-circle-check me-2"></i>

                                    Paid

                                </span>
                            }
                            else if (Model.PaymentStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark fs-6 px-4 py-2">

                                    <i class="fa-solid fa-clock me-2"></i>

                                    Pending

                                </span>
                            }
                            else if (Model.PaymentStatus == "Failed")
                            {
                                <span class="badge bg-danger fs-6 px-4 py-2">

                                    <i class="fa-solid fa-circle-xmark me-2"></i>

                                    Failed

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6 px-4 py-2">

                                    @Model.PaymentStatus

                                </span>
                            }

                        </div>

                        <!-- Receipt Summary -->

                        <div class="col-12">

                            <div class="card border-success shadow-sm">

                                <div class="card-header bg-success text-white">

                                    <h5 class="mb-0">

                                        <i class="fa-solid fa-receipt me-2"></i>

                                        Payment Receipt Summary

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="40%">

                                                Appointment Number

                                            </th>

                                            <td>

                                                @Model.AppointmentNo

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Customer

                                            </th>

                                            <td>

                                                @Model.CustomerName

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Doctor

                                            </th>

                                            <td>

                                                Dr. @Model.DoctorName

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Department

                                            </th>

                                            <td>

                                                @Model.DepartmentName

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Amount Paid

                                            </th>

                                            <td class="fw-bold text-success">

                                                ₹ @Model.Amount.ToString("N2")

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Payment Method

                                            </th>

                                            <td>

                                                @Model.PaymentMethod

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Transaction ID

                                            </th>

                                            <td>

                                                @Model.TransactionId

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <div class="col-12 text-center mt-4">

                            <a asp-action="ManagePayments"
                               class="btn btn-secondary px-5 me-2">

                                <i class="fa-solid fa-arrow-left me-2"></i>

                                Back

                            </a>

                            <a asp-action="DownloadReceipt"
                               asp-route-id="@Model.PaymentId"
                               class="btn btn-success px-5">

                                <i class="fa-solid fa-download me-2"></i>

                                Download Receipt

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            transition: .35s;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
            }

        .bg-primary {
            background: linear-gradient(135deg,#0d6efd,#4f8cff) !important;
        }

        .bg-success {
            background: linear-gradient(135deg,#198754,#20c997) !important;
        }

        .bg-info {
            background: linear-gradient(135deg,#0dcaf0,#3dbdf5) !important;
        }

        .doctor-img {
            width: 170px;
            height: 170px;
            object-fit: cover;
            border: 5px solid #fff;
            transition: .35s;
        }

            .doctor-img:hover {
                transform: scale(1.08);
            }

        .form-control {
            min-height: 48px;
            border-radius: 10px;
            background: #fff;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        .table th {
            color: #555;
            width: 40%;
        }

        .table td {
            font-weight: 500;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .badge {
            font-size: 14px;
        }

        .text-success {
            color: #198754 !important;
        }

        @@media(max-width:991px) {

            .doctor-img {
                width: 150px;
                height: 150px;
            }
        }

        @@media(max-width:768px) {

            .doctor-img {
                width: 130px;
                height: 130px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            h2 {
                font-size: 24px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',
                title:'Success',
                text:'@TempData["Success"]',
                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',
                title:'Error',
                text:'@TempData["Error"]',
                confirmButtonColor:'#dc3545'

            });

        </script>
    }

}