@model ClinicManagementSystem.Models.AppointmentModel

@{
    ViewData["Title"] = "View Appointment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="row mb-4">

        <div class="col-12">

            <div class="card shadow border-0">

                <div class="card-body bg-primary text-white rounded">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1">
                                <i class="fa-solid fa-calendar-check me-2"></i>
                                Appointment Details
                            </h2>

                            <p class="mb-0">
                                Complete appointment information with doctor and customer details.
                            </p>

                        </div>

                        <a asp-action="ManageAppointments"
                           class="btn btn-light">

                            <i class="fa fa-arrow-left me-2"></i>
                            Back

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <!-- Doctor Information -->

        <div class="col-lg-4 mb-4">

            <div class="card shadow border-0 h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-user-doctor me-2"></i>

                        Doctor Information

                    </h5>

                </div>

                <div class="card-body text-center">

                    @if (!string.IsNullOrEmpty(Model.DoctorImage))
                    {
                        <img src="~/Department/@Model.DoctorImage"
                             class="img-fluid rounded-circle shadow mb-3 doctor-img"
                             style="width:170px;height:170px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/no-image.png"
                             class="img-fluid rounded-circle shadow mb-3 doctor-img"
                             style="width:170px;height:170px;object-fit:cover;" />
                    }

                    <h4 class="fw-bold text-primary">

                        Dr. @Model.DoctorName

                    </h4>

                    <hr />

                    <table class="table table-borderless mb-0">

                        <tr>

                            <th width="45%">
                                Department
                            </th>

                            <td>
                                @Model.DepartmentName
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Qualification
                            </th>

                            <td>
                                @Model.Qualification
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Specialization
                            </th>

                            <td>
                                @Model.Specialization
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Experience
                            </th>

                            <td>
                                @Model.Experience Years
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Available Time
                            </th>

                            <td>

                                @(Model.AvailableFrom.HasValue
                                                                ? Model.AvailableFrom.Value.ToString(@"hh\:mm")
                                                                : "-")

                                -

                                @(Model.AvailableTo.HasValue
                                                                ? Model.AvailableTo.Value.ToString(@"hh\:mm")
                                                                : "-")

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- Customer Information -->

        <div class="col-lg-8 mb-4">

            <div class="card shadow border-0">

                <div class="card-header bg-info text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-user me-2"></i>

                        Customer Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-secondary">

                                Customer Name

                            </label>

                            <div class="form-control bg-light">

                                @Model.CustomerName

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-secondary">

                                Mobile Number

                            </label>

                            <div class="form-control bg-light">

                                @Model.MobileNo

                            </div>

                        </div>

                        <div class="col-md-12">

                            <label class="fw-bold text-secondary">

                                Email Address

                            </label>

                            <div class="form-control bg-light">

                                @Model.Email

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Appointment Information -->

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-notes-medical me-2"></i>

                Appointment Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row">
                <!-- Appointment No -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Appointment No
                    </label>

                    <div class="form-control bg-light">
                        @Model.AppointmentNo
                    </div>

                </div>

                <!-- Appointment Date -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Appointment Date
                    </label>

                    <div class="form-control bg-light">

                        @(Model.AppointmentDate.HasValue
                                                ? Model.AppointmentDate.Value.ToString("dd MMM yyyy")
                                                : "-")

                    </div>

                </div>

                <!-- Appointment Time -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Appointment Time
                    </label>

                    <div class="form-control bg-light">

                        @(Model.AppointmentTime.HasValue
                                                ? Model.AppointmentTime.Value.ToString(@"hh\:mm")
                                                : "-")

                    </div>

                </div>

                <!-- Consultation Fee -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Consultation Fee
                    </label>

                    <div class="form-control bg-light text-success fw-bold">
                        ₹@Model.ConsultationFee
                    </div>

                </div>

                <!-- Appointment Status -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Appointment Status
                    </label>

                    <div>

                        @switch (Model.AppointmentStatus)
                        {
                            case "Pending":
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                    Pending
                                </span>
                                break;

                            case "Approved":
                                <span class="badge bg-info fs-6 px-3 py-2">
                                    Approved
                                </span>
                                break;

                            case "Confirmed":
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    Confirmed
                                </span>
                                break;

                            case "Completed":
                                <span class="badge bg-success fs-6 px-3 py-2">
                                    Completed
                                </span>
                                break;

                            case "Rejected":
                                <span class="badge bg-danger fs-6 px-3 py-2">
                                    Rejected
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                    Cancelled
                                </span>
                                break;
                        }

                    </div>

                </div>

                <!-- Payment Status -->
                <div class="col-md-4 mb-3">

                    <label class="fw-bold text-secondary">
                        Payment Status
                    </label>

                    <div>

                        @switch (Model.PaymentStatus)
                        {
                            case "Pending":
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                    Pending
                                </span>
                                break;

                            case "Paid":
                                <span class="badge bg-success fs-6 px-3 py-2">
                                    Paid
                                </span>
                                break;

                            case "Failed":
                                <span class="badge bg-danger fs-6 px-3 py-2">
                                    Failed
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                    @Model.PaymentStatus
                                </span>
                                break;
                        }

                    </div>

                </div>

                <!-- Symptoms -->
                <div class="col-md-12 mb-3">

                    <label class="fw-bold text-secondary">
                        Symptoms
                    </label>

                    <textarea class="form-control bg-light"
                              rows="4"
                              readonly>@Model.Symptoms</textarea>

                </div>

                <!-- Customer Remark -->
                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Customer Remark
                    </label>

                    <textarea class="form-control bg-light"
                              rows="4"
                              readonly>@Model.CustomerRemark</textarea>

                </div>

                <!-- Admin Remark -->
                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Admin Remark
                    </label>

                    <textarea class="form-control bg-light"
                              rows="4"
                              readonly>@Model.AdminRemark</textarea>

                </div>

                <!-- Prescription -->
                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Prescription
                    </label>

                    <div>

                        @if (!string.IsNullOrEmpty(Model.PrescriptionFile))
                        {
                            <a href="~/Prescription/@Model.PrescriptionFile"
                               target="_blank"
                               class="btn btn-success">

                                <i class="fa-solid fa-download me-2"></i>

                                Download Prescription

                            </a>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                Prescription Not Uploaded
                            </span>
                        }

                    </div>

                </div>

                <!-- Booking Date -->
                <div class="col-md-3 mb-3">

                    <label class="fw-bold text-secondary">
                        Created Date
                    </label>

                    <div class="form-control bg-light">

                        @Model.CreatedDate.ToString("dd MMM yyyy")

                    </div>

                </div>

                <!-- Updated Date -->
                <div class="col-md-3 mb-3">

                    <label class="fw-bold text-secondary">
                        Updated Date
                    </label>

                    <div class="form-control bg-light">

                        @(Model.UpdatedDate.HasValue
                                                ? Model.UpdatedDate.Value.ToString("dd MMM yyyy")
                                                : "-")

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- Action Buttons -->
    <div class="row mt-4">

        <div class="col-12 text-center">

            <a asp-action="ManageAppointments"
               class="btn btn-secondary px-4 me-2">

                <i class="fa fa-arrow-left me-2"></i>

                Back

            </a>

            <a asp-action="EditAppointment"
               asp-route-id="@Model.AppointmentId"
               class="btn btn-warning px-4 me-2">

                <i class="fa fa-edit me-2"></i>

                Edit

            </a>

            @if (Model.AppointmentStatus == "Pending")
            {
                <a asp-action="ApproveAppointment"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-success px-4 me-2"
                   onclick="return confirm('Are you sure you want to approve this appointment?');">

                    <i class="fa fa-check me-2"></i>

                    Approve

                </a>

                <a asp-action="RejectAppointment"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-danger px-4 me-2"
                   onclick="return confirm('Are you sure you want to reject this appointment?');">

                    <i class="fa fa-times me-2"></i>

                    Reject

                </a>
            }

            @if (Model.AppointmentStatus == "Approved")
            {
                <a asp-action="UploadPrescription"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-info text-white px-4 me-2">

                    <i class="fa fa-upload me-2"></i>

                    Upload Prescription

                </a>

                <a asp-action="CompleteAppointment"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-success px-4"
                   onclick="return confirm('Complete this appointment?');">

                    <i class="fa fa-check-double me-2"></i>

                    Complete

                </a>
            }

        </div>

    </div>

</div>

@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            transition: .35s;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
            }

        .card-header {
            font-weight: 600;
            font-size: 18px;
        }

        .bg-primary {
            background: linear-gradient(135deg,#0d6efd,#4f8cff) !important;
        }

        .bg-success {
            background: linear-gradient(135deg,#198754,#20c997) !important;
        }

        .bg-info {
            background: linear-gradient(135deg,#0dcaf0,#36c5f0) !important;
        }

        .bg-dark {
            background: linear-gradient(135deg,#212529,#495057) !important;
        }

        .doctor-img {
            transition: .4s;
            border: 5px solid #fff;
        }

            .doctor-img:hover {
                transform: scale(1.08);
            }

        .table th {
            color: #555;
            width: 40%;
            font-weight: 600;
        }

        .form-control {
            border-radius: 10px;
            min-height: 45px;
        }

        textarea.form-control {
            resize: none;
        }

        .badge {
            font-size: 14px;
            border-radius: 30px;
            padding: 10px 18px;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        @@media(max-width:992px) {

            .doctor-img {
                width: 140px !important;
                height: 140px !important;
            }
        }

        @@media(max-width:768px) {

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            .d-flex {
                flex-direction: column;
                gap: 15px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        setTimeout(function(){

            $(".alert").fadeOut();

        },3000);

    </script>

}