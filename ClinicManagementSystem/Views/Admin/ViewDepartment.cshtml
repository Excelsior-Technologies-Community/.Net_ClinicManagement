@model ClinicManagementSystem.Models.DepartmentModel
@{
    ViewData["Title"] = "View Department";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa fa-eye"></i> Department Details</h4>

            <div>
                <a asp-action="EditDepartment" asp-route-id="@Model.DepartmentId" class="btn btn-warning btn-sm">
                    <i class="fa fa-edit"></i> Edit
                </a>

                <a asp-action="ManageDepartment" class="btn btn-dark btn-sm">
                    <i class="fa fa-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.DepartmentImage))
                    {
                        <img src="~/Department/@Model.DepartmentImage"
                             class="img-fluid rounded shadow border"
                             style="width:250px;height:250px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/Admin/images/no-image.png"
                             class="img-fluid rounded shadow border"
                             style="width:250px;height:250px;object-fit:cover;" />
                    }

                </div>

                <div class="col-md-8">

                    <table class="table table-bordered">

                        <tr>
                            <th width="220">Department ID</th>
                            <td>@Model.DepartmentId</td>
                        </tr>

                        <tr>
                            <th>Department Name</th>
                            <td>@Model.DepartmentName</td>
                        </tr>

                        <tr>
                            <th>Description</th>
                            <td>@Model.DepartmentDescription</td>
                        </tr>

                        <tr>
                            <th>Display Order</th>
                            <td>@Model.DisplayOrder</td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>Created Date</th>
                            <td>@Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")</td>
                        </tr>

                        <tr>
                            <th>Updated Date</th>
                            <td>
                                @(Model.UpdatedDate.HasValue
                                                                ? Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                                : "-")
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>
