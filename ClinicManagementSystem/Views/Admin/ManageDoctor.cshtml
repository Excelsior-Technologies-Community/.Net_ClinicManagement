@model IEnumerable<ClinicManagementSystem.Models.DoctorModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Manage Doctor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fa fa-user-md"></i> Doctor Management</h3>
        <a asp-action="AddDoctor" class="btn btn-primary"><i class="fa fa-plus"></i> Add Doctor</a>
    </div>
    <div class="card shadow mb-3">
        <div class="card-body">
            <form method="get" asp-action="ManageDoctor">
                <div class="row">
                    <div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search doctor" /></div>
                    <div class="col-md-4"><select class="form-select" name="departmentId" asp-items="@(ViewBag.DepartmentList as List<SelectListItem>)"></select></div>
                    <div class="col-md-3"><button class="btn btn-success w-100">Search</button></div>
                </div>
            </form>
        </div>
    </div>
    <div class="card shadow">
        <div class="card-body table-responsive">
            <table id="doctorTable" class="table table-bordered table-hover align-middle">
                <thead class="table-dark"><tr><th>#</th><th>Photo</th><th>Name</th><th>Department</th><th>Qualification</th><th>Experience</th><th>Fee</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                    @{
                        int sr = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.DoctorImage))
                                {
                                    <img src="~/Department/@item.DoctorImage" style="width:60px;height:60px;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {

                                    <img src="~/Admin/images/no-image.png" style="width:60px;height:60px;border-radius:50%;" />
                                }
                            </td>
                            <td><b>@item.DoctorName</b><br /><small>@item.Specialization</small></td>
                            <td>@item.DepartmentName</td>
                            <td>@item.Qualification</td>
                            <td>@item.Experience Years</td>
                            <td>₹ @item.ConsultationFee</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {

                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="ViewDoctor" asp-route-id="@item.DoctorId" class="btn btn-info btn-sm"><i class="fa fa-eye"></i></a>
                                <a asp-action="EditDoctor" asp-route-id="@item.DoctorId" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i></a>
                                <a asp-action="ChangeDoctorStatus" asp-route-id="@item.DoctorId" class="btn btn-secondary btn-sm"><i class="fa fa-sync"></i></a>
                                <a asp-action="DeleteDoctor" asp-route-id="@item.DoctorId" class="btn btn-danger btn-sm btn-delete"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                        sr++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(function(){
    $('#doctorTable').DataTable();
    $('.btn-delete').click(function(e){e.preventDefault();let u=$(this).attr('href');Swal.fire({title:'Delete Doctor?',icon:'warning',showCancelButton:true}).then(r=>{if(r.isConfirmed)location=u;});});
    });
</script>
