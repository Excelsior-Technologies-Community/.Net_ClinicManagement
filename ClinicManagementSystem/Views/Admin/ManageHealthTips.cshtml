@model List<ClinicManagementSystem.Models.HealthTipModel>

@{
    ViewData["Title"] = "Manage Health Tips";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->

    <div class="row mb-4">

        <div class="col-lg-12">

            <div class="card shadow border-0">

                <div class="card-body bg-primary text-white rounded">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fa-solid fa-notes-medical me-2"></i>

                                Manage Health Tips

                            </h2>

                            <p class="mb-0">

                                Add, manage and publish health tips & medical blogs.

                            </p>

                        </div>

                        <div>

                            <a asp-action="AddHealthTip"
                               class="btn btn-light">

                                <i class="fa-solid fa-plus me-2"></i>

                                Add Health Tip

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Success -->
@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["Success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
}

    <!-- Error -->
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fa-solid fa-circle-xmark me-2"></i>

            @TempData["Error"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
}

    <!-- Search -->

    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="ManageHealthTips">

                <div class="row">

                    <div class="col-md-10">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by Title, Category or Author..." />

                    </div>

                    <div class="col-md-2 d-grid">

                        <button class="btn btn-primary">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Health Tips Table -->

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-list me-2"></i>

                Health Tips List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-primary">

                        <tr>

                            <th width="60">#</th>

                            <th width="90">Image</th>

                            <th>Title</th>

                            <th>Category</th>

                            <th>Author</th>

                            <th>Featured</th>

                            <th>Status</th>

                            <th>Order</th>

                            <th width="200">Action</th>

                        </tr>

                    </thead>

                    <tbody>

@{

    int sr = 1;

}
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr No -->

                                    <td class="text-center">

                                        @sr

                                    </td>

                                    <!-- Image -->

                                    <td class="text-center">

                                        @if (!string.IsNullOrEmpty(item.TipImage))
                                        {
                                            <img src="~/HealthTips/@item.TipImage"
                                                 asp-append-version="true"
                                                 class="rounded shadow-sm"
                                                 width="70"
                                                 height="70"
                                                 style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <img src="~/images/no-image.png"
                                                 class="rounded border"
                                                 width="70"
                                                 height="70"
                                                 style="object-fit:cover;" />
                                        }

                                </td>

                                <!-- Title -->

                                <td>

                                    <strong class="text-primary">

                                        @item.Title

                                    </strong>

                                    <br />

                                    <small class="text-muted">

                                        @(item.ShortDescription.Length > 50
                                                                            ? item.ShortDescription.Substring(0, 50) + "..."
                                                                            : item.ShortDescription)

                                </small>

                                    </td>

                                    <!-- Category -->

                                    <td>

                                        <span class="badge bg-info">

                                            @item.Category

                                        </span>

                                    </td>

                                    <!-- Author -->

                                    <td>

                                        <i class="fa-solid fa-user-doctor text-success me-1"></i>

                                        @item.AuthorName

                                    </td>

                                    <!-- Featured -->

                                    <td class="text-center">

                                @if (item.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa-solid fa-star me-1"></i>

                                                Featured

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                Normal

                                            </span>
                                        }

                                    </td>

                                    <!-- Status -->

                                    <td class="text-center">

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-circle-check me-1"></i>

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="fa-solid fa-circle-xmark me-1"></i>

                                                Inactive

                                            </span>
                                        }

                                    </td>

                                    <!-- Display Order -->

                                    <td class="text-center">

                                        @item.DisplayOrder

                                    </td>

                                    <!-- Action -->

                                    <td class="text-center">

                                        <!-- View -->

                                        <a asp-action="ViewHealthTip"
                                           asp-route-id="@item.HealthTipId"
                                           class="btn btn-info btn-sm mb-1"
                                           title="View">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                        <!-- Edit -->

                                        <a asp-action="EditHealthTip"
                                           asp-route-id="@item.HealthTipId"
                                           class="btn btn-warning btn-sm mb-1"
                                           title="Edit">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>

                                        <!-- Status -->
                                        @if (item.IsActive)
                                        {
                                            <a asp-action="ChangeHealthTipStatus"
                                               asp-route-id="@item.HealthTipId"
                                               class="btn btn-secondary btn-sm mb-1"
                                               title="Deactivate">

                                                <i class="fa-solid fa-toggle-on"></i>

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="ChangeHealthTipStatus"
                                               asp-route-id="@item.HealthTipId"
                                               class="btn btn-success btn-sm mb-1"
                                               title="Activate">

                                                <i class="fa-solid fa-toggle-off"></i>

                                            </a>
                                        }

                                        <!-- Featured -->
                                        @if (item.IsFeatured)
                                        {
                                            <a asp-action="ChangeFeaturedStatus"
                                               asp-route-id="@item.HealthTipId"
                                               class="btn btn-warning btn-sm mb-1"
                                               title="Remove Featured">

                                                <i class="fa-solid fa-star"></i>

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="ChangeFeaturedStatus"
                                               asp-route-id="@item.HealthTipId"
                                               class="btn btn-outline-warning btn-sm mb-1"
                                               title="Make Featured">

                                                <i class="fa-regular fa-star"></i>

                                            </a>
                                        }

                                        <!-- Delete -->

                                        <a href="@Url.Action("DeleteHealthTip", "Admin", new { id = item.HealthTipId })"
                                           class="btn btn-danger btn-sm btn-delete"
                                           title="Delete">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <i class="fa-solid fa-notes-medical
                          fa-5x text-secondary mb-3"></i>

                                    <h4>

                                        No Health Tips Found

                                    </h4>

                                    <p class="text-muted mb-3">

                                        No health tips are available.

                                    </p>

                                    <a asp-action="AddHealthTip"
                                       class="btn btn-primary">

                                        <i class="fa-solid fa-plus me-2"></i>

                                        Add First Health Tip

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .card-header {
            font-weight: 600;
        }

        .table th {
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }

        .table td {
            vertical-align: middle;
        }

        .table tbody tr {
            transition: .3s;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }

        img {
            border-radius: 10px;
            transition: .3s;
        }

            img:hover {
                transform: scale(1.08);
            }

        .badge {
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 13px;
        }

        .btn {
            border-radius: 8px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .form-control {
            border-radius: 10px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        .alert {
            border-radius: 12px;
        }

        @@media(max-width:992px) {

            .table {
                min-width: 1400px;
            }
        }

        @@media(max-width:768px) {

            .btn {
                margin-bottom: 5px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            $(".btn-delete").click(function (e) {

                e.preventDefault();

                var url = $(this).attr("href");

                Swal.fire({

                    title: "Delete Health Tip?",

                    text: "This health tip will be moved to deleted records.",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonColor: "#dc3545",

                    cancelButtonColor: "#6c757d",

                    confirmButtonText: "Yes, Delete",

                    cancelButtonText: "Cancel"

                }).then((result) => {

                    if (result.isConfirmed) {

                        window.location.href = url;

                    }

                });

            });

        });

    </script>

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

}