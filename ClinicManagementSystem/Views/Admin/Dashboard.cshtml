@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h6>Total Doctors</h6>
                    <h2>25</h2>
                    <i class="fas fa-user-doctor fa-2x float-end"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <h6>Total Patients</h6>
                    <h2>180</h2>
                    <i class="fas fa-users fa-2x float-end"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <h6>Today's Appointments</h6>
                    <h2>15</h2>
                    <i class="fas fa-calendar-check fa-2x float-end"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <h6>Total Bills</h6>
                    <h2>96</h2>
                    <i class="fas fa-file-invoice-dollar fa-2x float-end"></i>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    Recent Appointments
                </div>

                <div class="card-body">

                    <table class="table table-bordered table-hover">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Rahul Patel</td>
                                <td>Dr. Mehta</td>
                                <td>28/07/2026</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>

                            <tr>
                                <td>2</td>
                                <td>Priya Shah</td>
                                <td>Dr. Patel</td>
                                <td>28/07/2026</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                            </tr>

                            <tr>
                                <td>3</td>
                                <td>Amit Kumar</td>
                                <td>Dr. Joshi</td>
                                <td>29/07/2026</td>
                                <td><span class="badge bg-info">Approved</span></td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-success text-white">
                    Quick Actions
                </div>

                <div class="list-group list-group-flush">
                    <a asp-controller="Admin" asp-action="AddDepartment" class="list-group-item list-group-item-action">
                        <i class="fas fa-building"></i> Add Department
                    </a>

                    <a asp-controller="Admin" asp-action="AddDoctor" class="list-group-item list-group-item-action">
                        <i class="fas fa-user-doctor"></i> Add Doctor
                    </a>

                    <a asp-controller="Admin" asp-action="ManagePatient" class="list-group-item list-group-item-action">
                        <i class="fas fa-users"></i> Manage Patients
                    </a>

                    <a asp-controller="Admin" asp-action="ManageAppointment" class="list-group-item list-group-item-action">
                        <i class="fas fa-calendar-check"></i> Appointments
                    </a>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

}
