@model ClinicManagementSystem.Models.HealthPackageTestModel

@{
    ViewData["Title"] = "Add Lab Test";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="fa-solid fa-vial text-primary me-2"></i>

                Add Lab Test

            </h3>

            <p class="text-muted mb-0">

                Add a laboratory test to this health package.

            </p>

        </div>

        <a asp-action="ManageHealthPackageTest"
           asp-route-id="@Model.HealthPackageId"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>

    </div>


    <!-- ================= ALERT ================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= FORM CARD ================= -->

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0 fw-bold">

                        <i class="fa-solid fa-flask me-2"></i>

                        Add Laboratory Test

                    </h5>

                </div>


                <div class="card-body p-4">

                    <!-- PACKAGE INFORMATION -->

                    <div class="bg-light rounded-3 p-3 mb-4">

                        <small class="text-muted d-block mb-1">
                            Health Package
                        </small>

                        <div class="fw-bold fs-5 text-dark">

                            <i class="fa-solid fa-heart-pulse
                                      text-primary me-2">
                            </i>

                            @ViewBag.PackageName

                        </div>

                    </div>


                    <form asp-action="AddHealthPackageTest"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="HealthPackageId" />


                        <!-- LAB TEST -->

                        <div class="mb-4">

                            <label asp-for="LabTestId"
                                   class="form-label fw-semibold">

                                Select Lab Test

                            </label>

                            <select asp-for="LabTestId"
                                    asp-items="ViewBag.TestList"
                                    class="form-select form-select-lg">

                                <option value="">

                                    -- Select Laboratory Test --

                                </option>

                            </select>

                        </div>


                        <!-- INFORMATION -->

                        <div class="alert alert-info">

                            <i class="fa-solid fa-circle-info me-2"></i>

                            Select an active laboratory test.
                            Tests already added to this package
                            will not appear in the list.

                        </div>


                        <!-- BUTTONS -->

                        <div class="d-flex justify-content-end gap-2 pt-3">

                            <a asp-action="ManageHealthPackageTest"
                               asp-route-id="@Model.HealthPackageId"
                               class="btn btn-light border px-4">

                                <i class="fa-solid fa-xmark me-1"></i>

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="fa-solid fa-plus me-1"></i>

                                Add Lab Test

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>