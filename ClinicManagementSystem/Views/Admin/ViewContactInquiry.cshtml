@model ClinicManagementSystem.Models.ContactInquiryModel

@{
    ViewData["Title"] = "View Contact Inquiry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow border-0">

                <div class="card-header bg-primary text-white">

                    <div class="d-flex justify-content-between align-items-center">

                        <h3 class="mb-0">

                            <i class="fa-solid fa-envelope-open-text me-2"></i>

                            Contact Inquiry Details

                        </h3>

                        <a asp-action="ManageContactInquiry"
                           class="btn btn-light">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back

                        </a>

                    </div>

                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Customer Information -->

                        <div class="col-md-6 mb-4">

                            <div class="card border-0 bg-light h-100">

                                <div class="card-body">

                                    <h5 class="text-primary mb-3">

                                        <i class="fa-solid fa-user me-2"></i>

                                        Customer Information

                                    </h5>

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="160">

                                                Full Name

                                            </th>

                                            <td>

                                                @Model.FullName

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Email Address

                                            </th>

                                            <td>

                                                @Model.Email

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Mobile Number

                                            </th>

                                            <td>

                                                @Model.MobileNo

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>

                        <!-- Inquiry Information -->

                        <div class="col-md-6 mb-4">

                            <div class="card border-0 bg-light h-100">

                                <div class="card-body">

                                    <h5 class="text-success mb-3">

                                        <i class="fa-solid fa-circle-info me-2"></i>

                                        Inquiry Information

                                    </h5>

                                    <table class="table table-borderless mb-0">

                                        <tr>

                                            <th width="160">

                                                Inquiry ID

                                            </th>

                                            <td>

                                                #@Model.InquiryId

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Subject

                                            </th>

                                            <td>

                                                @Model.Subject

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>

                                                Status

                                            </th>

                                            <td>

                                                @if (Model.IsReplied)
                                                {
                                                    <span class="badge bg-success">

                                                        <i class="fa-solid fa-circle-check me-1"></i>

                                                        Replied

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">

                                                        <i class="fa-solid fa-clock me-1"></i>

                                                        Pending

                                                    </span>
                                                }

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                        </div>
                        <div class="row">

                            <!-- Customer Inquiry -->

                            <div class="col-lg-12 mb-4">

                                <div class="card border-0 bg-light">

                                    <div class="card-body">

                                        <h5 class="text-primary mb-3">

                                            <i class="fa-solid fa-message me-2"></i>

                                            Customer Inquiry

                                        </h5>

                                        <div class="border rounded p-3 bg-white">

                                            @Model.Message

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- Admin Reply -->

                            <div class="col-lg-12 mb-4">

                                <div class="card border-0 bg-light">

                                    <div class="card-body">

                                        <h5 class="text-success mb-3">

                                            <i class="fa-solid fa-reply me-2"></i>

                                            Admin Reply

                                        </h5>

                                        @if (!string.IsNullOrWhiteSpace(Model.ReplyMessage))
                                        {
                                            <div class="alert alert-success mb-0">

                                                <i class="fa-solid fa-circle-check me-2"></i>

                                                @Model.ReplyMessage

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mb-0">

                                                <i class="fa-solid fa-clock me-2"></i>

                                                No reply has been provided yet.

                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>

                            <!-- Inquiry Details -->

                            <div class="col-lg-12">

                                <div class="card border-0 bg-light">

                                    <div class="card-body">

                                        <h5 class="text-dark mb-3">

                                            <i class="fa-solid fa-calendar-days me-2"></i>

                                            Inquiry Details

                                        </h5>

                                        <table class="table table-bordered">

                                            <tr>

                                                <th width="220">

                                                    Submitted On

                                                </th>

                                                <td>

                                                    @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")

                                                </td>

                                            </tr>

                                            <tr>

                                                <th>

                                                    Last Updated

                                                </th>

                                                <td>

                                                    @if (Model.UpdatedDate != null)
                                                    {
                                                        @Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">

                                                            Not Updated

                                                        </span>
                                                    }

                                                </td>

                                            </tr>

                                        </table>

                                        <div class="text-center mt-4">

                                            <a asp-action="ManageContactInquiry"
                                               class="btn btn-secondary px-4 me-2">

                                                <i class="fa-solid fa-arrow-left me-2"></i>

                                                Back

                                            </a>

                                            @if (!Model.IsReplied)
                                            {
                                                <a asp-action="ReplyContactInquiry"
                                                   asp-route-id="@Model.InquiryId"
                                                   class="btn btn-primary px-4">

                                                    <i class="fa-solid fa-reply me-2"></i>

                                                    Reply Inquiry

                                                </a>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
@section Styles{

        <style>

            body {
                background: #f5f7fb;
            }

            .card {
                border: none;
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 10px 25px rgba(0,0,0,.08);
            }

            .card-header {
                font-weight: 600;
            }

            .card.bg-light {
                border-radius: 12px;
            }

            .table th {
                width: 220px;
                background: #f8f9fa;
                font-weight: 600;
                vertical-align: middle;
            }

            .table td {
                vertical-align: middle;
            }

            .badge {
                padding: 8px 15px;
                border-radius: 20px;
                font-size: 13px;
            }

            .border.rounded {
                border-radius: 12px !important;
                line-height: 28px;
                background: #fff;
                white-space: pre-line;
            }

            .btn {
                border-radius: 10px;
                transition: .3s;
            }

                .btn:hover {
                    transform: translateY(-2px);
                }

            .alert {
                border-radius: 12px;
            }

            @@media(max-width:768px) {

                .table th {
                    width: 130px;
                    font-size: 14px;
                }

                .table td {
                    font-size: 14px;
                }

                .btn {
                    width: 100%;
                    margin-bottom: 10px;
                }
            }

        </style>

}

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
            <script>

                Swal.fire({

                    icon:'success',

                    title:'Success',

                    text:'@TempData["Success"]',

                    confirmButtonColor:'#198754'

                });

            </script>
    }

    @if (TempData["Error"] != null)
    {
            <script>

                Swal.fire({

                    icon:'error',

                    title:'Error',

                    text:'@TempData["Error"]',

                    confirmButtonColor:'#dc3545'

                });

            </script>
    }

        <script>

            $(document).ready(function(){

                $(".card").hide().fadeIn(500);

            });

        </script>

}
