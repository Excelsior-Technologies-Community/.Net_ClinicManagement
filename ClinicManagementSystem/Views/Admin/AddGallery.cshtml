@model ClinicManagementSystem.Models.GalleryModel

@{
    ViewData["Title"] = "Add Gallery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h3 class="mb-0">

                    <i class="fa-solid fa-images me-2"></i>

                    Add Gallery

                </h3>

                <a asp-action="ManageGallery"
                   class="btn btn-light">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back

                </a>

            </div>

        </div>

        <div class="card-body">

            <form asp-action="AddGallery"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Gallery Title -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="GalleryTitle"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="GalleryTitle"
                               class="form-control"
                               placeholder="Enter Gallery Title" />

                        <span asp-validation-for="GalleryTitle"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Category -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="GalleryCategory"
                               class="form-label fw-bold">
                        </label>

                        <select asp-for="GalleryCategory"
                                class="form-select">

                            <option value="">Select Category</option>

                            <option>Reception</option>

                            <option>Consultation Room</option>

                            <option>Laboratory</option>

                            <option>Pharmacy</option>

                            <option>Medical Equipment</option>

                            <option>Operation Theatre</option>

                            <option>Doctors</option>

                            <option>Staff</option>

                            <option>Health Camp</option>

                            <option>Events</option>

                            <option>Clinic Building</option>

                        </select>

                        <span asp-validation-for="GalleryCategory"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Image Upload -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="ImageFile"
                               class="form-label fw-bold">

                            Gallery Image

                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="PreviewImage(this)" />

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Display Order -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="DisplayOrder"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="DisplayOrder"
                               class="form-control" />

                        <span asp-validation-for="DisplayOrder"
                              class="text-danger">
                        </span>

                    </div>
                    <!-- Description -->

                    <div class="col-md-12 mb-3">

                        <label asp-for="Description"
                               class="form-label fw-bold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter Gallery Description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Active Status -->

                    <div class="col-md-6 mb-4">

                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-bold">

                                Active Gallery

                            </label>

                        </div>

                    </div>

                    <!-- Image Preview -->

                    <div class="col-md-6 mb-4 text-center">

                        <label class="form-label fw-bold d-block">

                            Image Preview

                        </label>

                        <img id="PreviewImage"
                             src="~/images/no-image.png"
                             class="img-thumbnail shadow"
                             style="width:220px;height:170px;object-fit:cover;border-radius:12px;" />

                    </div>

                </div>

                <hr />

                <!-- Buttons -->

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-success px-5">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Save Gallery

                    </button>

                    <button type="reset"
                            class="btn btn-warning px-5 ms-2">

                        <i class="fa-solid fa-rotate-right me-2"></i>

                        Reset

                    </button>

                    <a asp-action="ManageGallery"
                       class="btn btn-secondary px-5 ms-2">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .card-header {
            border-radius: 18px 18px 0 0 !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
            border-radius: 10px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.25);
            }

        textarea {
            resize: none;
        }

        .img-thumbnail {
            transition: .4s;
        }

            .img-thumbnail:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 25px rgba(0,0,0,.20);
            }

        .btn {
            border-radius: 10px;
            transition: .30s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .form-check-input {
            width: 22px;
            height: 22px;
            cursor: pointer;
        }

        .form-check-label {
            margin-left: 8px;
            cursor: pointer;
        }

        @@media(max-width:768px) {

            #PreviewImage {
                width: 170px !important;
                height: 140px !important;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function PreviewImage(input)
        {
            if (input.files && input.files[0])
            {
                var reader = new FileReader();

                reader.onload = function(e)
                {
                    $("#PreviewImage").attr("src", e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

    </script>

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

}