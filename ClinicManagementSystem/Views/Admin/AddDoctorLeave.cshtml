@model ClinicManagementSystem.Models.DoctorLeaveModel

@{
    ViewData["Title"] = "Add Doctor Leave";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->

    <div class="row mb-4">

        <div class="col-lg-12">

            <div class="card shadow border-0">

                <div class="card-body bg-primary text-white rounded">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fa-solid fa-calendar-plus me-2"></i>

                                Add Doctor Leave

                            </h2>

                            <p class="mb-0">

                                Add a new leave record for a doctor.

                            </p>

                        </div>

                        <div>

                            <a asp-action="ManageDoctorLeave"
                               class="btn btn-light">

                                <i class="fa-solid fa-arrow-left me-2"></i>

                                Back

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Add Form -->

    <div class="card shadow border-0">

        <div class="card-body">

            <form asp-action="AddDoctorLeave"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Doctor -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="DoctorId"
                               class="form-label fw-bold">

                            Doctor

                        </label>

                        <select asp-for="DoctorId"
                                asp-items="Model.DoctorList"
                                class="form-select">

                            <option value="">-- Select Doctor --</option>

                        </select>

                        <span asp-validation-for="DoctorId"
                              class="text-danger"></span>

                    </div>

                    <!-- Leave From -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="LeaveFromDate"
                               class="form-label fw-bold">

                            Leave From Date

                        </label>

                        <input asp-for="LeaveFromDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="LeaveFromDate"
                              class="text-danger"></span>

                    </div>

                    <!-- Leave To -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="LeaveToDate"
                               class="form-label fw-bold">

                            Leave To Date

                        </label>

                        <input asp-for="LeaveToDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="LeaveToDate"
                              class="text-danger"></span>

                    </div>

                    <!-- Leave Reason -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="LeaveReason"
                               class="form-label fw-bold">

                            Leave Reason

                        </label>

                        <textarea asp-for="LeaveReason"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter Leave Reason"></textarea>

                        <span asp-validation-for="LeaveReason"
                              class="text-danger"></span>

                    </div>
                    <!-- Active Status -->

                    <div class="col-md-12 mb-4">

                        <label class="form-label fw-bold d-block">

                            Leave Status

                        </label>

                        <div class="form-check form-switch mt-2">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Active

                            </label>

                        </div>

                        <small class="text-muted">

                            Only active leave records will be considered while booking appointments.

                        </small>

                    </div>

                </div>

                <hr />

                <!-- Action Buttons -->

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-success px-5">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Save Leave

                    </button>

                    <button type="reset"
                            class="btn btn-warning px-5 ms-2">

                        <i class="fa-solid fa-rotate-right me-2"></i>

                        Reset

                    </button>

                    <a asp-action="ManageDoctorLeave"
                       class="btn btn-secondary px-5 ms-2">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .card-header {
            font-weight: 600;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        textarea {
            resize: none;
        }

        .form-check-input {
            width: 50px;
            height: 25px;
            cursor: pointer;
        }

        .form-check-label {
            margin-left: 8px;
            font-weight: 600;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .alert {
            border-radius: 12px;
        }

        .text-danger {
            font-size: 14px;
        }

        @@media(max-width:768px) {

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

    <script>

        $(document).ready(function(){

            $(".card").hide().fadeIn(500);

            
            $("#LeaveFromDate").change(function(){

                var fromDate = $(this).val();

                $("#LeaveToDate").attr("min", fromDate);

                if($("#LeaveToDate").val() < fromDate)
                {
                    $("#LeaveToDate").val(fromDate);
                }

            });

        });

    </script>

}