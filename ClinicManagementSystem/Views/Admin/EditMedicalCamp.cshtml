@model ClinicManagementSystem.Models.MedicalCampModel

@{
    ViewData["Title"] = "Edit Medical Camp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="card border-0 shadow mb-4">

        <div class="card-body text-white rounded"
             style="background:linear-gradient(135deg,#f59e0b,#ef4444);">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>

                    <h2 class="fw-bold mb-2">

                        <i class="fa-solid fa-pen-to-square me-2"></i>

                        Edit Medical Camp

                    </h2>

                    <p class="mb-0">

                        Update medical camp information and registration details.

                    </p>

                </div>

                <div>

                    <a asp-action="ManageMedicalCamp"
                       class="btn btn-light">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Edit Form -->

    <div class="card border-0 shadow">

        <div class="card-body p-4">

            <form asp-action="EditMedicalCamp"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="CampId"
                       type="hidden" />

                <input asp-for="CampImage"
                       type="hidden" />

                <input asp-for="CampBanner"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row">

                    <!-- Camp Title -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="CampTitle"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-heading text-primary me-1"></i>

                            Camp Title

                        </label>

                        <input asp-for="CampTitle"
                               class="form-control"
                               placeholder="Enter Camp Title" />

                        <span asp-validation-for="CampTitle"
                              class="text-danger"></span>

                    </div>


                    <!-- Camp Date -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="CampDate"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-calendar-days text-primary me-1"></i>

                            Camp Date

                        </label>

                        <input asp-for="CampDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="CampDate"
                              class="text-danger"></span>

                    </div>


                    <!-- Doctor -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="DoctorId"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-user-doctor text-primary me-1"></i>

                            Doctor

                        </label>

                        <select asp-for="DoctorId"
                                asp-items="Model.DoctorList"
                                class="form-select">

                            <option value="">

                                -- Select Doctor --

                            </option>

                        </select>

                        <span asp-validation-for="DoctorId"
                              class="text-danger"></span>

                    </div>


                    <!-- Department -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="DepartmentId"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-building-user text-primary me-1"></i>

                            Department

                        </label>

                        <select asp-for="DepartmentId"
                                asp-items="Model.DepartmentList"
                                class="form-select">

                            <option value="">

                                -- Select Department --

                            </option>

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="text-danger"></span>

                    </div>


                    <!-- Description -->

                    <div class="col-12 mb-4">

                        <label asp-for="CampDescription"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-align-left text-primary me-1"></i>

                            Camp Description

                        </label>

                        <textarea asp-for="CampDescription"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Enter complete medical camp description"></textarea>

                        <span asp-validation-for="CampDescription"
                              class="text-danger"></span>

                    </div>


                    <!-- Venue -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="Venue"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-location-dot text-danger me-1"></i>

                            Venue

                        </label>

                        <input asp-for="Venue"
                               class="form-control"
                               placeholder="Enter Camp Venue" />

                        <span asp-validation-for="Venue"
                              class="text-danger"></span>

                    </div>


                    <!-- Organizer -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="Organizer"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-user-tie text-primary me-1"></i>

                            Organizer

                        </label>

                        <input asp-for="Organizer"
                               class="form-control"
                               placeholder="Enter Organizer Name" />

                    </div>
                    <!-- Start Time -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="StartTime"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-clock text-primary me-1"></i>

                            Start Time

                        </label>

                        <input asp-for="StartTime"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>

                    </div>


                    <!-- End Time -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="EndTime"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-clock text-danger me-1"></i>

                            End Time

                        </label>

                        <input asp-for="EndTime"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="EndTime"
                              class="text-danger"></span>

                    </div>


                    <!-- Registration Fee -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="RegistrationFee"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-indian-rupee-sign text-success me-1"></i>

                            Registration Fee

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                ₹

                            </span>

                            <input asp-for="RegistrationFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0 = Free Camp" />

                        </div>

                        <span asp-validation-for="RegistrationFee"
                              class="text-danger"></span>

                    </div>


                    <!-- Maximum Participants -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="MaxParticipants"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-users text-primary me-1"></i>

                            Maximum Participants

                        </label>

                        <input asp-for="MaxParticipants"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter Maximum Participants" />

                        <span asp-validation-for="MaxParticipants"
                              class="text-danger"></span>

                    </div>


                    <!-- Available Seats -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="AvailableSeats"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-chair text-success me-1"></i>

                            Available Seats

                        </label>

                        <input asp-for="AvailableSeats"
                               type="number"
                               class="form-control bg-light"
                               readonly />

                        <small class="text-muted">

                            Available seats are calculated automatically.

                        </small>

                    </div>


                    <!-- Contact Number -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="ContactNumber"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-phone text-success me-1"></i>

                            Contact Number

                        </label>

                        <input asp-for="ContactNumber"
                               class="form-control"
                               placeholder="Enter Contact Number" />

                        <span asp-validation-for="ContactNumber"
                              class="text-danger"></span>

                    </div>


                    <!-- Email -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="Email"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-envelope text-danger me-1"></i>

                            Email Address

                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter Email Address" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>


                    <!-- Benefits -->

                    <div class="col-12 mb-4">

                        <label asp-for="Benefits"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-circle-check text-success me-1"></i>

                            Camp Benefits

                        </label>

                        <textarea asp-for="Benefits"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter benefits of this medical camp"></textarea>

                    </div>



                    <div class="col-12 mb-4">

                        <label asp-for="Instructions"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>

                            Important Instructions

                        </label>

                        <textarea asp-for="Instructions"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter important instructions for participants"></textarea>

                    </div>
                    <!-- Camp Image -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="CampImageFile"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-image text-primary me-1"></i>

                            Camp Image

                        </label>

                        <input asp-for="CampImageFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        <small class="text-muted">
                            Select a new image only if you want to replace the existing image.
                        </small>

                        <div class="mt-3">

                            @if (!string.IsNullOrWhiteSpace(Model.CampImage))
                            {
                                <img id="campImagePreview"
                                     src="~/MedicalCamp/@Model.CampImage"
                                     class="img-thumbnail camp-image-preview"
                                     alt="Camp Image" />
                            }
                            else
                            {
                                <img id="campImagePreview"
                                     class="img-thumbnail camp-image-preview d-none"
                                     alt="Camp Image" />
                            }

                        </div>

                    </div>


                    <!-- Camp Banner -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="CampBannerFile"
                               class="form-label fw-bold">

                            <i class="fa-solid fa-panorama text-primary me-1"></i>

                            Camp Banner

                        </label>

                        <input asp-for="CampBannerFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        <small class="text-muted">
                            Select a new banner only if you want to replace the existing banner.
                        </small>

                        <div class="mt-3">

                            @if (!string.IsNullOrWhiteSpace(Model.CampBanner))
                            {
                                <img id="campBannerPreview"
                                     src="~/MedicalCamp/@Model.CampBanner"
                                     class="img-thumbnail camp-banner-preview"
                                     alt="Camp Banner" />
                            }
                            else
                            {
                                <img id="campBannerPreview"
                                     class="img-thumbnail camp-banner-preview d-none"
                                     alt="Camp Banner" />
                            }

                        </div>

                    </div>


                    <!-- Featured Status -->

                    <div class="col-md-6 mb-4">

                        <div class="status-box">

                            <div class="form-check form-switch">

                                <input asp-for="IsFeatured"
                                       class="form-check-input"
                                       id="IsFeatured" />

                                <label asp-for="IsFeatured"
                                       class="form-check-label fw-bold">

                                    <i class="fa-solid fa-star text-warning me-2"></i>

                                    Featured Medical Camp

                                </label>

                            </div>

                            <small class="text-muted">

                                Featured camps can be highlighted on the customer side.

                            </small>

                        </div>

                    </div>


                    <!-- Active Status -->

                    <div class="col-md-6 mb-4">

                        <div class="status-box">

                            <div class="form-check form-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       id="IsActive" />

                                <label asp-for="IsActive"
                                       class="form-check-label fw-bold">

                                    <i class="fa-solid fa-circle-check text-success me-2"></i>

                                    Active Medical Camp

                                </label>

                            </div>

                            <small class="text-muted">

                                Inactive camps will not be displayed to customers.

                            </small>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Buttons -->

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-success px-5 me-2">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Update Medical Camp

                    </button>

                    <a asp-action="ManageMedicalCamp"
                       class="btn btn-secondary px-5">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 11px 14px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.18);
            }

        textarea {
            resize: none;
        }

        .btn {
            border-radius: 10px;
            font-weight: 600;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .camp-image-preview {
            width: 180px;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
        }

        .camp-banner-preview {
            width: 280px;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
        }

        .status-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 18px;
        }

        .form-check-input {
            width: 48px;
            height: 24px;
            cursor: pointer;
        }

        .form-check-label {
            cursor: pointer;
        }

        .form-switch .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .img-thumbnail {
            border: 2px solid #e9ecef;
            padding: 4px;
        }

        @@media(max-width:768px) {

            .camp-image-preview {
                width: 150px;
                height: 130px;
            }

            .camp-banner-preview {
                width: 100%;
                height: 150px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        $(document).ready(function () {

            //=========================================
            // Camp Image Preview
            //=========================================

            $("#CampImageFile").on("change", function () {

                var file = this.files[0];

                if (file) {

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        $("#campImagePreview")
                            .removeClass("d-none")
                            .attr("src", e.target.result);

                    };

                    reader.readAsDataURL(file);
                }

            });


            //=========================================
            // Camp Banner Preview
            //=========================================

            $("#CampBannerFile").on("change", function () {

                var file = this.files[0];

                if (file) {

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        $("#campBannerPreview")
                            .removeClass("d-none")
                            .attr("src", e.target.result);

                    };

                    reader.readAsDataURL(file);
                }

            });

        });

    </script>


    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon: 'success',

                title: 'Success',

                text: '@TempData["Success"]',

                confirmButtonColor: '#198754'

            });

        </script>
    }


    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon: 'error',

                title: 'Error',

                text: '@TempData["Error"]',

                confirmButtonColor: '#dc3545'

            });

        </script>
    }

}