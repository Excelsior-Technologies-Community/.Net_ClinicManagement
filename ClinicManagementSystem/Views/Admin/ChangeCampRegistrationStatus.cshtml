@model ClinicManagementSystem.Models.CampRegistrationModel

@{
    ViewData["Title"] = "Change Camp Registration Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4 change-status-page">

    <!-- =========================================
         Page Header
    ========================================== -->

    <div class="page-header mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <a asp-action="ViewCampRegistration"
                   asp-route-id="@Model.CampRegistrationId"
                   class="back-link">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back to Registration Details

                </a>

                <div class="header-badge mt-3">

                    <i class="fa-solid fa-rotate me-2"></i>

                    Registration Status Management

                </div>

                <h1 class="fw-bold mt-3 mb-2">

                    Change Registration Status

                </h1>

                <p class="mb-0">

                    Update the registration status and add an
                    administrative remark for this medical camp registration.

                </p>

            </div>


            <div class="col-lg-4 text-lg-end d-none d-lg-block">

                <div class="header-icon">

                    <i class="fa-solid fa-clipboard-check"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Registration Summary Cards
    ========================================== -->

    <div class="row g-3 mb-4">


        <!-- Registration Number -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon blue">

                    <i class="fa-solid fa-hashtag"></i>

                </div>

                <div>

                    <span>
                        Registration Number
                    </span>

                    <strong>
                        @Model.RegistrationNo
                    </strong>

                </div>

            </div>

        </div>


        <!-- Customer -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon purple">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <span>
                        Customer
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.CustomerName)
                                                ? "Not Available"
                                                : Model.CustomerName)
                    </strong>

                </div>

            </div>

        </div>


        <!-- Medical Camp -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon green">

                    <i class="fa-solid fa-kit-medical"></i>

                </div>

                <div>

                    <span>
                        Medical Camp
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.CampTitle)
                                                ? "Not Available"
                                                : Model.CampTitle)
                    </strong>

                </div>

            </div>

        </div>


        <!-- Current Status -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon orange">

                    <i class="fa-solid fa-circle-info"></i>

                </div>

                <div>

                    <span>
                        Current Status
                    </span>

                    @if (Model.RegistrationStatus == "Confirmed")
                    {
                        <b class="status-badge confirmed">

                            <i class="fa-solid fa-circle-check me-1"></i>

                            Confirmed

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Pending")
                    {
                        <b class="status-badge pending">

                            <i class="fa-solid fa-clock me-1"></i>

                            Pending

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Cancelled")
                    {
                        <b class="status-badge cancelled">

                            <i class="fa-solid fa-circle-xmark me-1"></i>

                            Cancelled

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Completed")
                    {
                        <b class="status-badge completed">

                            <i class="fa-solid fa-check-double me-1"></i>

                            Completed

                        </b>
                    }
                    else
                    {
                        <b class="status-badge pending">

                            @(string.IsNullOrWhiteSpace(Model.RegistrationStatus)
                                                    ? "Not Set"
                                                    : Model.RegistrationStatus)

                    </b>
                                        }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Main Content
    ========================================== -->

    <div class="row g-4">


        <!-- =========================================
             Left Side - Registration Information
        ========================================== -->

        <div class="col-xl-7">

            <div class="information-card">

                <!-- Card Header -->

                <div class="card-header-custom">

                    <div>

                        <h5>

                            <i class="fa-solid fa-file-medical me-2"></i>

                            Registration Information

                        </h5>

                        <p>
                            Review registration details before changing status.
                        </p>

                    </div>

                </div>


                <!-- Information Body -->

                <div class="card-body-custom">

                    <div class="row g-3">


                        <!-- Participant Name -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon blue">

                                    <i class="fa-solid fa-user"></i>

                                </div>

                                <div>

                                    <small>
                                        Participant Name
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(
                                                                                Model.ParticipantName)
                                                                                ? "Not Available"
                                                                                : Model.ParticipantName)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Mobile -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon green">

                                    <i class="fa-solid fa-phone"></i>

                                </div>

                                <div>

                                    <small>
                                        Mobile Number
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(
                                                                                Model.MobileNo)
                                                                                ? "Not Available"
                                                                                : Model.MobileNo)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Email -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon red">

                                    <i class="fa-solid fa-envelope"></i>

                                </div>

                                <div>

                                    <small>
                                        Email Address
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(
                                                                                Model.Email)
                                                                                ? "Not Available"
                                                                                : Model.Email)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Gender -->

                        <div class="col-md-3">

                            <div class="info-box">

                                <div class="info-icon purple">

                                    <i class="fa-solid fa-venus-mars"></i>

                                </div>

                                <div>

                                    <small>
                                        Gender
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(Model.Gender)
                                                                                ? "N/A"
                                                                                : Model.Gender)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Age -->

                        <div class="col-md-3">

                            <div class="info-box">

                                <div class="info-icon cyan">

                                    <i class="fa-solid fa-calendar"></i>

                                </div>

                                <div>

                                    <small>
                                        Age
                                    </small>

                                    <strong>

                                        @(Model.Age.HasValue
                                                                                ? Model.Age.Value + " Years"
                                                                                : "N/A")

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Camp Date -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon blue">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </div>

                                <div>

                                    <small>
                                        Camp Date
                                    </small>

                                    <strong>
                                        @if (Model.CampDate.HasValue)
                                        {
                                            @Model.CampDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <text>Not Available</text>
                                        }
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Camp Time -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon orange">

                                    <i class="fa-solid fa-clock"></i>

                                </div>

                                <div>

                                    <small>
                                        Camp Time
                                    </small>

                                    <strong>
                                        @if (Model.StartTime.HasValue)
                                        {
                                            @DateTime.Today.Add(Model.StartTime.Value).ToString("hh:mm tt")

                                            if (Model.EndTime.HasValue)
                                            {
                                                <text> - </text>
                                                @DateTime.Today.Add(Model.EndTime.Value).ToString("hh:mm tt")
                                            }
                                        }
                                        else
                                        {
                                            <text>Not Available</text>
                                        }
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Venue -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon red">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>

                                <div>

                                    <small>
                                        Venue
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(Model.Venue)
                                                                                ? "Not Available"
                                                                                : Model.Venue)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Organizer -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon purple">

                                    <i class="fa-solid fa-user-tie"></i>

                                </div>

                                <div>

                                    <small>
                                        Organizer
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(Model.Organizer)
                                                                                ? "Not Available"
                                                                                : Model.Organizer)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Payment -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon green">

                                    <i class="fa-solid fa-credit-card"></i>

                                </div>

                                <div>

                                    <small>
                                        Payment Status
                                    </small>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                                                                ? "Not Available"
                                                                                : Model.PaymentStatus)

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Amount -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon orange">

                                    <i class="fa-solid fa-indian-rupee-sign"></i>

                                </div>

                                <div>

                                    <small>
                                        Registration Amount
                                    </small>

                                    <strong>
                                        ₹ @Model.Amount.ToString("N2")
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Health Concern -->

                        <div class="col-12">

                            <div class="health-box">

                                <div class="health-icon">

                                    <i class="fa-solid fa-notes-medical"></i>

                                </div>

                                <div>

                                    <small>
                                        Health Concern
                                    </small>

                                    <p>

                                        @(string.IsNullOrWhiteSpace(
                                                                                Model.HealthConcern)
                                                                                ? "No health concern was provided."
                                                                                : Model.HealthConcern)

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Right Side - Status Update Preview
        ========================================== -->

        <div class="col-xl-5">

            <div class="status-update-card">

                <div class="status-card-header">

                    <div class="status-card-icon">

                        <i class="fa-solid fa-sliders"></i>

                    </div>

                    <div>

                        <h5>
                            Update Registration
                        </h5>

                        <p>
                            Select the new registration status.
                        </p>

                    </div>

                </div>


                <!-- Current Status -->

                <div class="current-status-box">

                    <small>
                        Current Registration Status
                    </small>

                    <div class="current-status">

                        @if (Model.RegistrationStatus == "Confirmed")
                        {
                            <span class="status-badge confirmed">

                                <i class="fa-solid fa-circle-check me-1"></i>

                                Confirmed

                            </span>
                        }
                        else if (Model.RegistrationStatus == "Pending")
                        {
                            <span class="status-badge pending">

                                <i class="fa-solid fa-clock me-1"></i>

                                Pending

                            </span>
                        }
                        else if (Model.RegistrationStatus == "Cancelled")
                        {
                            <span class="status-badge cancelled">

                                <i class="fa-solid fa-circle-xmark me-1"></i>

                                Cancelled

                            </span>
                        }
                        else if (Model.RegistrationStatus == "Completed")
                        {
                            <span class="status-badge completed">

                                <i class="fa-solid fa-check-double me-1"></i>

                                Completed

                            </span>
                        }
                        else
                        {
                            <span class="status-badge pending">

                                @(string.IsNullOrWhiteSpace(
                                                            Model.RegistrationStatus)
                                                            ? "Not Set"
                                                            : Model.RegistrationStatus)

                        </span>
                                                }

                    </div>

                </div>
                <!-- =========================================
                     Status Update Form
                ========================================== -->

                <form asp-action="ChangeCampRegistrationStatus"
                      method="post"
                      id="changeStatusForm">

                    @Html.AntiForgeryToken()

                    <!-- Hidden Registration ID -->

                    <input type="hidden"
                           asp-for="CampRegistrationId" />


                    <!-- =========================================
                         New Status
                    ========================================== -->

                    <div class="form-section">

                        <label asp-for="RegistrationStatus"
                               class="form-label">

                            <i class="fa-solid fa-list-check me-2"></i>

                            Select New Status

                            <span class="required">*</span>

                        </label>

                        <div class="status-select-wrapper">

                            <i class="fa-solid fa-circle-chevron-down"></i>

                            <select asp-for="RegistrationStatus"
                                    class="form-select status-select"
                                    id="registrationStatus">

                                <option value="">
                                    -- Select Registration Status --
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                                <option value="Confirmed">
                                    Confirmed
                                </option>

                                <option value="Completed">
                                    Completed
                                </option>

                                <option value="Cancelled">
                                    Cancelled
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="RegistrationStatus"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- =========================================
                         Status Information
                    ========================================== -->

                    <div id="statusInfo"
                         class="status-info-box">

                        <div class="status-info-icon">

                            <i class="fa-solid fa-circle-info"></i>

                        </div>

                        <div>

                            <strong id="statusInfoTitle">
                                Select a status
                            </strong>

                            <p id="statusInfoText">
                                Choose the appropriate registration
                                status from the dropdown above.
                            </p>

                        </div>

                    </div>


                    <!-- =========================================
                         Admin Remark
                    ========================================== -->

                    <div class="form-section">

                        <label asp-for="AdminRemark"
                               class="form-label">

                            <i class="fa-solid fa-comment-medical me-2"></i>

                            Admin Remark

                            <span class="optional">
                                Optional
                            </span>

                        </label>

                        <textarea asp-for="AdminRemark"
                                  id="adminRemark"
                                  class="form-control remark-textarea"
                                  rows="5"
                                  maxlength="500"
                                  placeholder="Enter an administrative remark or note about this registration..."></textarea>

                        <div class="textarea-footer">

                            <small>

                                <i class="fa-solid fa-circle-info me-1"></i>

                                This remark will be stored with the registration.

                            </small>

                            <span id="remarkCounter">
                                0 / 500
                            </span>

                        </div>

                    </div>


                    <!-- =========================================
                         Important Notice
                    ========================================== -->

                    <div class="important-notice">

                        <div class="notice-icon">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                        </div>

                        <div>

                            <strong>
                                Important
                            </strong>

                            <p>
                                Changing the registration status will
                                immediately update the registration record.
                                Please verify the selected status before
                                saving.
                            </p>

                        </div>

                    </div>


                    <!-- =========================================
                         Action Buttons
                    ========================================== -->

                    <div class="form-actions">

                        <a asp-action="ViewCampRegistration"
                           asp-route-id="@Model.CampRegistrationId"
                           class="btn btn-outline-secondary">

                            <i class="fa-solid fa-xmark me-2"></i>

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-primary"
                                id="updateStatusBtn">

                            <i class="fa-solid fa-check me-2"></i>

                            Update Status

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- =========================================
         Status History / Guidelines
    ========================================== -->

    <div class="status-guidelines mt-4">

        <div class="guidelines-header">

            <div class="guidelines-icon">

                <i class="fa-solid fa-list-check"></i>

            </div>

            <div>

                <h5>
                    Registration Status Guidelines
                </h5>

                <p>
                    Use the following statuses according to the
                    registration progress.
                </p>

            </div>

        </div>


        <div class="row g-3 mt-1">


            <!-- Pending -->

            <div class="col-lg-3 col-md-6">

                <div class="guideline-card pending-card">

                    <div class="guideline-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <div>

                        <strong>
                            Pending
                        </strong>

                        <p>
                            Registration is received and waiting
                            for confirmation.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Confirmed -->

            <div class="col-lg-3 col-md-6">

                <div class="guideline-card confirmed-card">

                    <div class="guideline-icon">

                        <i class="fa-solid fa-circle-check"></i>

                    </div>

                    <div>

                        <strong>
                            Confirmed
                        </strong>

                        <p>
                            Participant registration has been
                            successfully confirmed.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Completed -->

            <div class="col-lg-3 col-md-6">

                <div class="guideline-card completed-card">

                    <div class="guideline-icon">

                        <i class="fa-solid fa-check-double"></i>

                    </div>

                    <div>

                        <strong>
                            Completed
                        </strong>

                        <p>
                            Participant has completed the medical
                            camp registration process.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Cancelled -->

            <div class="col-lg-3 col-md-6">

                <div class="guideline-card cancelled-card">

                    <div class="guideline-icon">

                        <i class="fa-solid fa-circle-xmark"></i>

                    </div>

                    <div>

                        <strong>
                            Cancelled
                        </strong>

                        <p>
                            Registration has been cancelled and
                            is no longer active.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- =========================================
         JavaScript
    ========================================== -->

    <script>

        $(document).ready(function () {

            // =========================================
            // Elements
            // =========================================

            var statusSelect =
                $("#registrationStatus");

            var statusInfo =
                $("#statusInfo");

            var statusInfoTitle =
                $("#statusInfoTitle");

            var statusInfoText =
                $("#statusInfoText");

            var remark =
                $("#adminRemark");

            var remarkCounter =
                $("#remarkCounter");

            var form =
                $("#changeStatusForm");

            var updateButton =
                $("#updateStatusBtn");


            // =========================================
            // Status Information
            // =========================================

            function updateStatusInformation() {

                var status =
                    statusSelect.val();


                statusInfo
                    .removeClass(
                        "status-pending status-confirmed status-completed status-cancelled"
                    );


                if (status === "Pending") {

                    statusInfo.addClass(
                        "status-pending"
                    );

                    statusInfoTitle.text(
                        "Pending Registration"
                    );

                    statusInfoText.text(
                        "This registration will remain pending and will require confirmation from the administration."
                    );

                }
                else if (status === "Confirmed") {

                    statusInfo.addClass(
                        "status-confirmed"
                    );

                    statusInfoTitle.text(
                        "Confirm Registration"
                    );

                    statusInfoText.text(
                        "The participant's registration will be marked as confirmed and accepted for the medical camp."
                    );

                }
                else if (status === "Completed") {

                    statusInfo.addClass(
                        "status-completed"
                    );

                    statusInfoTitle.text(
                        "Complete Registration"
                    );

                    statusInfoText.text(
                        "Use this status when the participant has completed the medical camp registration process."
                    );

                }
                else if (status === "Cancelled") {

                    statusInfo.addClass(
                        "status-cancelled"
                    );

                    statusInfoTitle.text(
                        "Cancel Registration"
                    );

                    statusInfoText.text(
                        "The registration will be marked as cancelled. Please provide a suitable remark when cancelling."
                    );

                }
                else {

                    statusInfoTitle.text(
                        "Select a status"
                    );

                    statusInfoText.text(
                        "Choose the appropriate registration status from the dropdown above."
                    );

                }

            }


            // =========================================
            // Status Change
            // =========================================

            statusSelect.on(
                "change",
                function () {

                    updateStatusInformation();

                }
            );


            // =========================================
            // Remark Character Counter
            // =========================================

            function updateRemarkCounter() {

                var length =
                    remark.val().length;

                remarkCounter.text(
                    length + " / 500"
                );


                if (length >= 450) {

                    remarkCounter.addClass(
                        "counter-warning"
                    );

                }
                else {

                    remarkCounter.removeClass(
                        "counter-warning"
                    );

                }

            }


            remark.on(
                "input",
                function () {

                    updateRemarkCounter();

                }
            );


            // =========================================
            // Form Submit
            // =========================================

            form.on(
                "submit",
                function (e) {

                    e.preventDefault();


                    var selectedStatus =
                        statusSelect.val();


                    if (!selectedStatus) {

                        Swal.fire({

                            icon: "warning",

                            title: "Select Status",

                            text:
                                "Please select a registration status before updating.",

                            confirmButtonColor:
                                "#0d6efd"

                        });

                        statusSelect.focus();

                        return;

                    }


                    // =========================================
                    // Cancel Confirmation
                    // =========================================

                    if (
                        selectedStatus === "Cancelled"
                    ) {

                        Swal.fire({

                            icon: "warning",

                            title: "Cancel Registration?",

                            text:
                                "Are you sure you want to cancel this medical camp registration?",

                            showCancelButton: true,

                            confirmButtonText:
                                "Yes, Cancel Registration",

                            cancelButtonText:
                                "Keep Registration",

                            confirmButtonColor:
                                "#dc3545",

                            cancelButtonColor:
                                "#6c757d"

                        }).then(function (result) {

                            if (result.isConfirmed) {

                                submitForm();

                            }

                        });

                    }
                    else {

                        var statusText =
                            selectedStatus;


                        Swal.fire({

                            icon: "question",

                            title: "Update Registration?",

                            text:
                                "Change registration status to " +
                                statusText +
                                "?",

                            showCancelButton: true,

                            confirmButtonText:
                                "Yes, Update",

                            cancelButtonText:
                                "Cancel",

                            confirmButtonColor:
                                "#0d6efd",

                            cancelButtonColor:
                                "#6c757d"

                        }).then(function (result) {

                            if (result.isConfirmed) {

                                submitForm();

                            }

                        });

                    }

                }
            );


            // =========================================
            // Submit Form
            // =========================================

            function submitForm() {

                updateButton.prop(
                    "disabled",
                    true
                );


                updateButton.html(
                    '<span class="spinner-border spinner-border-sm me-2"></span>' +
                    'Updating...'
                );


                // Native submit
                form.off("submit");

                form.submit();

            }


            // =========================================
            // Initialize
            // =========================================

            updateStatusInformation();

            updateRemarkCounter();

        });

    </script>


    <!-- =========================================
         Success Message
    ========================================== -->
    @if (TempData["Success"] != null)
    {
        <script>

            $(document).ready(function () {

                Swal.fire({

                    icon: "success",

                    title: "Success",

                    text:
                        "@TempData["Success"]",

                    confirmButtonColor:
                        "#0d6efd",

                    timer: 2500,

                    timerProgressBar: true

                });

            });

        </script>
    }


    <!-- =========================================
         Error Message
    ========================================== -->
