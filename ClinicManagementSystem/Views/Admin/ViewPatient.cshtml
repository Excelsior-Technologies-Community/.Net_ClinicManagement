@model ClinicManagementSystem.Models.CustomerModel
@{
    ViewData["Title"] = "View Patient Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var profileImg = !string.IsNullOrEmpty(Model.ProfileImage)
        ? Url.Content("~/CustomerProfile/" + Model.ProfileImage)
        : "https://cdn-icons-png.flaticon.com/512/3135/3135715.png";
}

<div class="container-fluid">
    <div class="card shadow border-0">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa fa-user"></i> Patient Details</h4>
            <div>
                <a asp-action="ManagePatient" class="btn btn-dark btn-sm">
                    <i class="fa fa-arrow-left"></i> Back to Patient List
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3">
                    <img src="@profileImg"
                         class="img-fluid rounded-circle shadow border p-1"
                         style="width: 220px; height: 220px; object-fit: cover;"
                         alt="@Model.FullName" />
                    <h5 class="mt-3 fw-bold">@Model.FullName</h5>
                    <p class="text-muted mb-1"><i class="fa fa-envelope text-primary"></i> @Model.Email</p>
                    <p class="text-muted"><i class="fa fa-phone text-success"></i> @Model.MobileNo</p>
                </div>

                <div class="col-md-8">
                    <table class="table table-bordered table-striped align-middle">
                        <tr>
                            <th width="200">Patient ID</th>
                            <td>#@Model.CustomerId</td>
                        </tr>
                        <tr>
                            <th>Full Name</th>
                            <td>@Model.FullName</td>
                        </tr>
                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>
                        <tr>
                            <th>Date of Birth</th>
                            <td>@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "-")</td>
                        </tr>
                        <tr>
                            <th>Blood Group</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.BloodGroup))
                                {
                                    <span class="badge bg-danger">@Model.BloodGroup</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Email Address</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Mobile Number</th>
                            <td>@Model.MobileNo</td>
                        </tr>
                        <tr>
                            <th>Address</th>
                            <td>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</td>
                        </tr>
                        <tr>
                            <th>City / State / Pincode</th>
                            <td>
                                @(string.IsNullOrEmpty(Model.City) ? "-" : Model.City) / 
                                @(string.IsNullOrEmpty(Model.State) ? "-" : Model.State) / 
                                @(string.IsNullOrEmpty(Model.Pincode) ? "-" : Model.Pincode)
                            </td>
                        </tr>
                        <tr>
                            <th>Account Status</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Registered Date</th>
                            <td>@Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")</td>
                        </tr>
                        <tr>
                            <th>Last Updated</th>
                            <td>
                                @(Model.UpdatedDate.HasValue ? Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt") : "-")
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
