            .table-card-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .record-count {
                width: 100%;
            }
        }

    </style>
    <!-- =========================================
         JavaScript
    ========================================== -->

    <script>

        $(document).ready(function () {

            // =========================================
            // Filter Elements
            // =========================================

            var searchInput =
                $("#registrationSearch");

            var campFilter =
                $("#campFilter");

            var statusFilter =
                $("#statusFilter");

            var paymentFilter =
                $("#paymentFilter");

            var rows =
                $(".registration-row");

            var totalRows =
                rows.length;


            // =========================================
            // Apply Filters
            // =========================================

            function applyFilters() {

                var search =
                    searchInput.val()
                        .toLowerCase()
                        .trim();

                var camp =
                    campFilter.val()
                        .toLowerCase()
                        .trim();

                var status =
                    statusFilter.val()
                        .toLowerCase()
                        .trim();

                var payment =
                    paymentFilter.val()
                        .toLowerCase()
                        .trim();


                var visibleCount = 0;


                rows.each(function () {

                    var row =
                        $(this);

                    var registration =
                        String(
                            row.data("registration") || ""
                        ).toLowerCase();

                    var customer =
                        String(
                            row.data("customer") || ""
                        ).toLowerCase();

                    var mobile =
                        String(
                            row.data("mobile") || ""
                        ).toLowerCase();

                    var campName =
                        String(
                            row.data("camp") || ""
                        ).toLowerCase();

                    var rowStatus =
                        String(
                            row.data("status") || ""
                        ).toLowerCase();

                    var rowPayment =
                        String(
                            row.data("payment") || ""
                        ).toLowerCase();


                    // =========================================
                    // Search Match
                    // =========================================

                    var searchMatch =
                        search === "" ||
                        registration.includes(search) ||
                        customer.includes(search) ||
                        mobile.includes(search) ||
                        campName.includes(search);


                    // =========================================
                    // Camp Match
                    // =========================================

                    var campMatch =
                        camp === "" ||
                        campName === camp;


                    // =========================================
                    // Status Match
                    // =========================================

                    var statusMatch =
                        status === "" ||
                        rowStatus === status;


                    // =========================================
                    // Payment Match
                    // =========================================

                    var paymentMatch =
                        payment === "" ||
                        rowPayment === payment;


                    // =========================================
                    // Final Match
                    // =========================================

                    if (
                        searchMatch &&
                        campMatch &&
                        statusMatch &&
                        paymentMatch
                    ) {

                        row.show();

                        visibleCount++;

                    }
                    else {

                        row.hide();

                    }

                });


                // =========================================
                // Update Count
                // =========================================

                $("#visibleRecordCount")
                    .text(visibleCount);

                $("#footerRecordCount")
                    .text(visibleCount);


                // =========================================
                // No Result Message
                // =========================================

                $("#filterNoResult").remove();


                if (visibleCount === 0) {

                    $("#registrationTable tbody")
                        .append(`

                            <tr id="filterNoResult">

                                <td colspan="9">

                                    <div class="empty-state">

                                        <div class="empty-icon">

                                            <i class="fa-solid fa-magnifying-glass"></i>

                                        </div>

                                        <h5>
                                            No Registrations Found
                                        </h5>

                                        <p>
                                            No registration matches your
                                            selected search or filter criteria.
                                        </p>

                                    </div>

                                </td>

                            </tr>

                        `);

                }

            }


            // =========================================
            // Search Event
            // =========================================

            searchInput.on(
                "keyup",
                function () {

                    applyFilters();

                }
            );


            // =========================================
            // Camp Filter
            // =========================================

            campFilter.on(
                "change",
                function () {

                    applyFilters();

                }
            );


            // =========================================
            // Status Filter
            // =========================================

            statusFilter.on(
                "change",
                function () {

                    applyFilters();

                }
            );


            // =========================================
            // Payment Filter
            // =========================================

            paymentFilter.on(
                "change",
                function () {

                    applyFilters();

                }
            );


            // =========================================
            // Reset Filters
            // =========================================

            $("#clearFilters").on(
                "click",
                function () {

                    searchInput.val("");

                    campFilter.val("");

                    statusFilter.val("");

                    paymentFilter.val("");


                    applyFilters();


                    // Small visual feedback

                    $(this)
                        .addClass("active");

                    setTimeout(
                        function () {

                            $("#clearFilters")
                                .removeClass("active");

                        },
                        300
                    );

                }
            );


            // =========================================
            // View Registration
            // =========================================

            $(".action-btn.view").on(
                "click",
                function () {

                    var id =
                        $(this).data("id");


                    if (!id) {

                        Swal.fire({

                            icon: "error",

                            title: "Invalid Registration",

                            text:
                                "Registration details could not be loaded."

                        });

                        return;

                    }


                       window.location.href =
        '@Url.Action("ViewCampRegistration")' +
        '?id=' +
        id;

                }
            );


            // =========================================
            // Change Registration Status
            // =========================================

            $(".action-btn.status").on(
                "click",
                function () {

                    var id =
                        $(this).data("id");


                    if (!id) {

                        Swal.fire({

                            icon: "error",

                            title: "Invalid Registration",

                            text:
                                "Registration ID was not found."

                        });

                        return;

                    }


                    window.location.href =
                        '@Url.Action("ChangeCampRegistrationStatus")' +
                        '?id=' +
                        id;

                }
            );


            // =========================================
            // Row Hover
            // =========================================

            $(".registration-row").on(
                "mouseenter",
                function () {

                    $(this).addClass(
                        "registration-row-hover"
                    );

                }
            );


            $(".registration-row").on(
                "mouseleave",
                function () {

                    $(this).removeClass(
                        "registration-row-hover"
                    );

                }
            );


            // =========================================
            // Initialize
            // =========================================

            applyFilters();

        });

    </script>


    <!-- =========================================
         Success / Error Messages
    ========================================== -->
    @if (TempData["Success"] != null)
    {
        <script>

            $(document).ready(function () {

                Swal.fire({

                    icon: "success",

                    title: "Success",

                    text:
                        "@TempData["Success"]",

                    confirmButtonColor:
                        "#0d6efd",

                    timer: 2500,

                    timerProgressBar: true

                });

            });

        </script>
    }


    @if (TempData["Error"] != null)
    {
        <script>

            $(document).ready(function () {

                Swal.fire({

                    icon: "error",

                    title: "Error",

                    text:
                        "@TempData["Error"]",

                    confirmButtonColor:
                        "#dc3545"

                });

            });

        </script>
    }


