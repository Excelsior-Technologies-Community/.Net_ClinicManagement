@model List<ClinicManagementSystem.Models.HealthPackageModel>

@{
    ViewData["Title"] = "Manage Health Packages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-heart-pulse text-primary me-2"></i>
                Health Packages
            </h3>

            <p class="text-muted mb-0">
                Manage preventive health checkup packages.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="AddHealthPackage"
           class="btn btn-primary px-4">

            <i class="fa-solid fa-plus me-1"></i>
            Add Health Package

        </a>

    </div>


    <!-- ================= ALERTS ================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= SUMMARY ================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-primary bg-opacity-10
                                text-primary p-3 me-3">

                        <i class="fa-solid fa-box-heart fa-lg"></i>

                    </div>

                    <div>
                        <small class="text-muted">
                            Total Packages
                        </small>

                        <h4 class="fw-bold mb-0">
                            @(Model?.Count ?? 0)
                        </h4>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-success bg-opacity-10
                                text-success p-3 me-3">

                        <i class="fa-solid fa-circle-check fa-lg"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Active Packages
                        </small>

                        <h4 class="fw-bold mb-0">
                            @(Model?.Count(x => x.IsActive && !x.IsDeleted) ?? 0)
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-warning bg-opacity-10
                                text-warning p-3 me-3">

                        <i class="fa-solid fa-tags fa-lg"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Discount Packages
                        </small>

                        <h4 class="fw-bold mb-0">

                            @(Model?.Count(x =>
                                x.OriginalPrice > x.DiscountPrice) ?? 0)

                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= TABLE ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="fa-solid fa-list text-primary me-2"></i>
                        Health Package List
                    </h5>

                    <small class="text-muted">
                        View and manage all health packages
                    </small>

                </div>

                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @(Model?.Count ?? 0) Packages
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    #
                                </th>

                                <th>
                                    Package
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Validity
                                </th>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int srNo = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- NUMBER -->

                                    <td class="px-4 fw-semibold">
                                        @srNo
                                    </td>


                                    <!-- PACKAGE -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrWhiteSpace(item.PackageImage))
                                            {
                                                <img src="~/HealthPackageImages/@item.PackageImage"
                                                     alt="@item.PackageName"
                                                     style="width:65px;
                                                            height:65px;
                                                            object-fit:cover;
                                                            border-radius:12px;"
                                                     class="me-3 border" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center
                                                            justify-content-center
                                                            bg-primary bg-opacity-10
                                                            text-primary me-3"
                                                     style="width:65px;
                                                            height:65px;
                                                            border-radius:12px;">

                                                    <i class="fa-solid fa-heart-pulse fa-lg"></i>

                                                </div>
                                            }

                                            <div>

                                                <div class="fw-bold text-dark">
                                                    @item.PackageName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <small class="text-muted">

                                                        @{
                                                            string description =
                                                                item.Description.Length > 55
                                                                ? item.Description.Substring(0, 55) + "..."
                                                                : item.Description;
                                                        }

                                                        @description

                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Category))
                                        {
                                            <span class="badge bg-info bg-opacity-10
                                                         text-info border border-info
                                                         px-3 py-2">

                                                @item.Category

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- PRICE -->

                                    <td>

                                        @if (item.OriginalPrice > item.DiscountPrice)
                                        {
                                            <div>

                                                <span class="text-muted text-decoration-line-through">
                                                    ₹@item.OriginalPrice.ToString("N2")
                                                </span>

                                                <br />

                                                <strong class="text-success">
                                                    ₹@item.DiscountPrice.ToString("N2")
                                                </strong>

                                            </div>
                                        }
                                        else
                                        {
                                            <strong class="text-success">
                                                ₹@item.DiscountPrice.ToString("N2")
                                            </strong>
                                        }

                                    </td>


                                    <!-- VALIDITY -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Validity))
                                        {
                                            <span>
                                                <i class="fa-regular fa-calendar
                                                          text-primary me-1"></i>

                                                @item.Validity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- DISPLAY ORDER -->

                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @item.DisplayOrder
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="fa-solid fa-check me-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- VIEW -->

                                            <a asp-controller="Admin"
                                               asp-action="ViewHealthPackage"
                                               asp-route-id="@item.HealthPackageId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>


                                            <!-- EDIT -->

                                            <a asp-controller="Admin"
                                               asp-action="EditHealthPackage"
                                               asp-route-id="@item.HealthPackageId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>


                                            <!-- STATUS -->

                                            <a asp-controller="Admin"
                                               asp-action="ChangeHealthPackageStatus"
                                               asp-route-id="@item.HealthPackageId"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Change Status">

                                                <i class="fa-solid fa-power-off"></i>

                                            </a>

                                            <a asp-controller="Admin"
   asp-action="ManageHealthPackageTest"
   asp-route-id="@item.HealthPackageId"
   class="btn btn-sm btn-outline-success"
   title="Manage Lab Tests">

    <i class="fa-solid fa-vials"></i>

</a>
                                            <!-- DELETE -->

                                            <a asp-controller="Admin"
                                               asp-action="DeleteHealthPackage"
                                               asp-route-id="@item.HealthPackageId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this health package?');">

                                                <i class="fa-solid fa-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                srNo++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ================= EMPTY STATE ================= -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <div class="d-inline-flex align-items-center
                                    justify-content-center
                                    bg-primary bg-opacity-10
                                    text-primary rounded-circle"
                             style="width:80px;height:80px;">

                            <i class="fa-solid fa-heart-pulse fa-2x"></i>

                        </div>

                    </div>

                    <h5 class="fw-bold">
                        No Health Packages Found
                    </h5>

                    <p class="text-muted mb-4">
                        No health packages have been added yet.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AddHealthPackage"
                       class="btn btn-primary px-4">

                        <i class="fa-solid fa-plus me-1"></i>
                        Add First Health Package

                    </a>

                </div>
            }

        </div>


        <!-- ================= FOOTER ================= -->

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-0 py-3">

                <small class="text-muted">

                    <i class="fa-solid fa-circle-info me-1"></i>

                    Showing
                    <strong>@Model.Count</strong>
                    health package(s).

                </small>

            </div>
        }

    </div>

</div>