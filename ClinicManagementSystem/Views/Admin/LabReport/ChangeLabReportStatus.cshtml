@model ClinicManagementSystem.Models.LabReportModel
@{
    ViewData["Title"] = "Change Lab Report Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0 text-primary"><i class="fas fa-toggle-on me-2"></i>Change Lab Report Status</h3>
        <small class="text-muted">Report Number: <strong class="text-dark">@Model.ReportNo</strong></small>
    </div>
    <a asp-action="ManageLabReport" class="btn btn-secondary shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="fas fa-file-medical-alt me-2"></i>Update Report Status</h5>
                <span class="badge bg-light text-dark">#@Model.ReportNo</span>
            </div>
            <div class="card-body p-4">
                <div class="p-3 bg-light rounded border mb-4">
                    <p class="mb-1"><strong>Patient Name:</strong> @Model.PatientName</p>
                    <p class="mb-1"><strong>Test Name:</strong> <span class="text-primary fw-bold">@Model.TestName</span></p>
                    <p class="mb-0"><strong>Booking Reference:</strong> @Model.BookingNo</p>
                </div>

                <form asp-action="ChangeLabReportStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.LabReportId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Report Status <span class="text-danger">*</span></label>
                        <select name="reportStatus" class="form-select" required>
                            <!option value="Completed" @(Model.ReportStatus == "Completed" ? "selected" : "")>Completed</!option>
                            <!option value="Draft" @(Model.ReportStatus == "Draft" ? "selected" : "")>Draft</!option>
                            <!option value="Pending" @(Model.ReportStatus == "Pending" ? "selected" : "")>Pending</!option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Technician Remark / Findings</label>
                        <textarea name="reportRemark" class="form-control" rows="4" placeholder="Enter findings, notes, or remarks...">@Model.ReportRemark</textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="ManageLabReport" class="btn btn-secondary"><i class="fas fa-times me-1"></i> Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
