@model ClinicManagementSystem.Models.HealthPackageTestModel

@{
    ViewData["Title"] = "View Package Test";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="fa-solid fa-vial text-primary me-2"></i>

                Lab Test Details

            </h3>

            <p class="text-muted mb-0">
                View laboratory test information included in the package.
            </p>

        </div>

        <a asp-action="ManageHealthPackageTest"
           asp-route-id="@Model.HealthPackageId"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>

    </div>


    <!-- Main Card -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0 fw-bold">

                <i class="fa-solid fa-flask me-2"></i>

                @Model.TestName

            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Test Icon -->

                <div class="col-lg-4">

                    <div class="bg-primary bg-opacity-10
                                rounded-4
                                d-flex
                                align-items-center
                                justify-content-center"
                         style="height:250px;">

                        <i class="fa-solid fa-vials text-primary"
                           style="font-size:80px;">
                        </i>

                    </div>

                </div>


                <!-- Details -->

                <div class="col-lg-8">

                    <div class="row g-3">

                        <!-- Package -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Health Package
                                </small>

                                <div class="fw-bold">

                                    <i class="fa-solid fa-heart-pulse
                                              text-primary me-1">
                                    </i>

                                    @Model.PackageName

                                </div>

                            </div>

                        </div>


                        <!-- Test Name -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Lab Test
                                </small>

                                <div class="fw-bold">
                                    @Model.TestName
                                </div>

                            </div>

                        </div>


                        <!-- Category -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Test Category
                                </small>

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.TestCategory))
                                {
                                    <span class="badge bg-info text-dark px-3 py-2">
                                        @Model.TestCategory
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Available
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- Sample -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Sample Type
                                </small>

                                <div class="fw-semibold">

                                    <i class="fa-solid fa-droplet
                                              text-danger me-1">
                                    </i>

                                    @(string.IsNullOrWhiteSpace(
                                        Model.SampleType)
                                        ? "Not Available"
                                        : Model.SampleType)

                                </div>

                            </div>

                        </div>


                        <!-- Price -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Test Price
                                </small>

                                <div class="fw-bold text-success fs-5">

                                    ₹@Model.Price.ToString("N2")

                                </div>

                            </div>

                        </div>


                        <!-- Status -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block mb-1">
                                    Status
                                </small>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">

                                        <i class="fa-solid fa-check me-1"></i>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">

                                        Inactive

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Created Date -->

            <div class="row">

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted d-block mb-1">
                            Added Date
                        </small>

                        @if (Model.CreatedDate.HasValue)
                        {
                            <span class="fw-semibold">

                                @Model.CreatedDate.Value
                                    .ToString("dd MMM yyyy, hh:mm tt")

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Available
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted d-block mb-1">
                            Mapping ID
                        </small>

                        <span class="fw-semibold">
                            #@Model.PackageTestId
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Footer -->

        <div class="card-footer bg-white p-3">

            <div class="d-flex justify-content-end">

                <a asp-action="ManageHealthPackageTest"
                   asp-route-id="@Model.HealthPackageId"
                   class="btn btn-secondary">

                    <i class="fa-solid fa-arrow-left me-1"></i>

                    Back to Package Tests

                </a>

            </div>

        </div>

    </div>

</div>