@model ClinicManagementSystem.Models.CampRegistrationModel

@{
    ViewData["Title"] = "View Camp Registration";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4 view-registration-page">

    <!-- =========================================
         Page Header
    ========================================== -->

    <div class="page-header mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <a asp-action="ManageCampRegistration"
                   class="back-link">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back to Registrations

                </a>

                <div class="header-badge mt-3">

                    <i class="fa-solid fa-file-medical me-2"></i>

                    Registration Details

                </div>

                <h1 class="fw-bold mt-3 mb-2">

                    @Model.RegistrationNo

                </h1>

                <p class="mb-0">

                    View complete medical camp registration
                    and participant information.

                </p>

            </div>


            <div class="col-lg-4 text-lg-end d-none d-lg-block">

                <div class="header-icon">

                    <i class="fa-solid fa-clipboard-check"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Registration Summary
    ========================================== -->

    <div class="row g-3 mb-4">

        <!-- Registration Number -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon blue">

                    <i class="fa-solid fa-hashtag"></i>

                </div>

                <div>

                    <span>
                        Registration Number
                    </span>

                    <strong>
                        @Model.RegistrationNo
                    </strong>

                </div>

            </div>

        </div>


        <!-- Registration Date -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon purple">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div>

                    <span>
                        Registration Date
                    </span>

                    <strong>

                        @Model.RegistrationDate
                        .ToString("dd MMM yyyy")

                    </strong>

                </div>

            </div>

        </div>


        <!-- Registration Status -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon green">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <span>
                        Registration Status
                    </span>

                    @if (Model.RegistrationStatus == "Confirmed")
                    {
                        <b class="status-badge confirmed">

                            <i class="fa-solid fa-circle-check me-1"></i>

                            Confirmed

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Pending")
                    {
                        <b class="status-badge pending">

                            <i class="fa-solid fa-clock me-1"></i>

                            Pending

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Cancelled")
                    {
                        <b class="status-badge cancelled">

                            <i class="fa-solid fa-circle-xmark me-1"></i>

                            Cancelled

                        </b>
                    }
                    else if (Model.RegistrationStatus == "Completed")
                    {
                        <b class="status-badge completed">

                            <i class="fa-solid fa-check-double me-1"></i>

                            Completed

                        </b>
                    }
                    else
                    {
                        <b class="status-badge pending">

                            @Model.RegistrationStatus

                        </b>
                    }

                </div>

            </div>

        </div>


        <!-- Payment Status -->

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon orange">

                    <i class="fa-solid fa-credit-card"></i>

                </div>

                <div>

                    <span>
                        Payment Status
                    </span>

                    @if (Model.PaymentStatus == "Paid")
                    {
                        <b class="payment-badge paid">

                            <i class="fa-solid fa-circle-check me-1"></i>

                            Paid

                        </b>
                    }
                    else if (Model.PaymentStatus == "Pending")
                    {
                        <b class="payment-badge pending">

                            <i class="fa-solid fa-clock me-1"></i>

                            Pending

                        </b>
                    }
                    else if (Model.PaymentStatus == "NotRequired")
                    {
                        <b class="payment-badge free">

                            <i class="fa-solid fa-check me-1"></i>

                            Not Required

                        </b>
                    }
                    else
                    {
                        <b class="payment-badge">

                            @Model.PaymentStatus

                        </b>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Main Registration Card
    ========================================== -->

    <div class="registration-details-card">

        <!-- Card Header -->

        <div class="card-header-custom">

            <div>

                <h5>

                    <i class="fa-solid fa-file-medical me-2"></i>

                    Camp Registration Information

                </h5>

                <p>
                    Complete details of this registration.
                </p>

            </div>


            <div class="header-actions">

                <a asp-action="ManageCampRegistration"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left me-1"></i>

                    Back

                </a>

                <a asp-action="PrintCampRegistration"
                   asp-route-id="@Model.CampRegistrationId"
                   target="_blank"
                   class="btn btn-primary">

                    <i class="fa-solid fa-print me-1"></i>

                    Print

                </a>

            </div>

        </div>


        <!-- =========================================
             Medical Camp Information
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon camp-icon">

                    <i class="fa-solid fa-kit-medical"></i>

                </div>

                <div>

                    <h4>
                        Medical Camp Information
                    </h4>

                    <p>
                        Details of the registered medical camp.
                    </p>

                </div>

            </div>


            <!-- Camp Banner -->

            <div class="camp-banner-wrapper">

                @if (!string.IsNullOrWhiteSpace(Model.CampBanner))
                {
                    <img src="~/MedicalCamp/@Model.CampBanner"
                         class="camp-banner"
                         alt="@Model.CampTitle" />
                }
                else if (!string.IsNullOrWhiteSpace(Model.CampImage))
                {
                    <img src="~/MedicalCamp/@Model.CampImage"
                         class="camp-banner"
                         alt="@Model.CampTitle" />
                }
                else
                {
                    <div class="camp-placeholder">

                        <i class="fa-solid fa-kit-medical"></i>

                        <span>
                            Medical Camp
                        </span>

                    </div>
                }

            </div>


            <div class="row g-3 mt-1">


                <!-- Camp Title -->

                <div class="col-md-12">

                    <div class="detail-box">

                        <div class="detail-icon blue">

                            <i class="fa-solid fa-heading"></i>

                        </div>

                        <div>

                            <small>
                                Medical Camp
                            </small>

                            <strong>
                                @Model.CampTitle
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Camp Date -->

                <div class="col-md-4">

                    <div class="detail-box">

                        <div class="detail-icon blue">

                            <i class="fa-solid fa-calendar-days"></i>

                        </div>

                        <div>

                            <small>
                                Camp Date
                            </small>

                            <strong>

                                @Model.CampDate?
                                .ToString("dd MMM yyyy")

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Camp Time -->

                <div class="col-md-4">

                    <div class="detail-box">

                        <div class="detail-icon green">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <small>
                                Camp Time
                            </small>

                            <strong>

                                @if (Model.StartTime.HasValue)
                                {
                                    @DateTime.Today.Add(Model.StartTime.Value).ToString("hh:mm tt")

                                    if (Model.EndTime.HasValue)
                                    {
                                        <text> - </text>
                                        @DateTime.Today.Add(Model.EndTime.Value).ToString("hh:mm tt")
                                    }
                                }
                                else
                                {
                                    <text>Not Available</text>
                                }

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Venue -->

                <div class="col-md-4">

                    <div class="detail-box">

                        <div class="detail-icon red">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>

                        <div>

                            <small>
                                Venue
                            </small>

                            <strong>
                                @Model.Venue
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Doctor -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon purple">

                            <i class="fa-solid fa-user-doctor"></i>

                        </div>

                        <div>

                            <small>
                                Medical Specialist
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.DoctorName)
                                                                ? "Not Assigned"
                                                                : Model.DoctorName)
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Department -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon cyan">

                            <i class="fa-solid fa-building"></i>

                        </div>

                        <div>

                            <small>
                                Department
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.DepartmentName)
                                                                ? "Not Assigned"
                                                                : Model.DepartmentName)
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Organizer -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon orange">

                            <i class="fa-solid fa-user-tie"></i>

                        </div>

                        <div>

                            <small>
                                Organizer
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Organizer)
                                                                ? "Not Available"
                                                                : Model.Organizer)
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Registration Fee -->

                <div class="col-md-3">

                    <div class="detail-box">

                        <div class="detail-icon green">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                        </div>

                        <div>

                            <small>
                                Registration Fee
                            </small>

                            <strong>

                                @if (Model.RegistrationFee == 0)
                                {
                                    <span class="text-success">
                                        Free
                                    </span>
                                }
                                else
                                {
                                    <text>
                                        ₹ @Model.RegistrationFee.ToString("N2")
                                    </text>
                                }

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Available Seats -->

                <div class="col-md-3">

                    <div class="detail-box">

                        <div class="detail-icon blue">

                            <i class="fa-solid fa-chair"></i>

                        </div>

                        <div>

                            <small>
                                Available Seats
                            </small>

                            <strong>
                                @Model.AvailableSeats
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>
        <!-- =========================================
             Customer Information
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon customer-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h4>
                        Customer Information
                    </h4>

                    <p>
                        Account information of the registered customer.
                    </p>

                </div>

            </div>


            <div class="row g-3">


                <!-- Customer Name -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon blue">

                            <i class="fa-solid fa-user"></i>

                        </div>

                        <div>

                            <small>
                                Customer Name
                            </small>

                            <strong>
                                @Model.CustomerName
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Customer ID -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon purple">

                            <i class="fa-solid fa-id-card"></i>

                        </div>

                        <div>

                            <small>
                                Customer ID
                            </small>

                            <strong>
                                #@Model.CustomerId
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Participant Mobile -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon green">

                            <i class="fa-solid fa-phone"></i>

                        </div>

                        <div>

                            <small>
                                Mobile Number
                            </small>

                            <strong>
                                @Model.MobileNo
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Participant Email -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon red">

                            <i class="fa-solid fa-envelope"></i>

                        </div>

                        <div>

                            <small>
                                Email Address
                            </small>

                            <strong>
                                @Model.Email
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Participant Information
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon participant-section-icon">

                    <i class="fa-solid fa-people-group"></i>

                </div>

                <div>

                    <h4>
                        Participant Information
                    </h4>

                    <p>
                        Personal information provided during camp registration.
                    </p>

                </div>

            </div>


            <div class="row g-3">


                <!-- Participant Name -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon blue">

                            <i class="fa-solid fa-user"></i>

                        </div>

                        <div>

                            <small>
                                Participant Name
                            </small>

                            <strong>
                                @Model.ParticipantName
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Age -->

                <div class="col-md-3">

                    <div class="detail-box">

                        <div class="detail-icon cyan">

                            <i class="fa-solid fa-calendar"></i>

                        </div>

                        <div>

                            <small>
                                Age
                            </small>

                            <strong>

                                @(Model.Age.HasValue
                                                                ? Model.Age.Value.ToString() + " Years"
                                                                : "Not Provided")

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Gender -->

                <div class="col-md-3">

                    <div class="detail-box">

                        <div class="detail-icon purple">

                            <i class="fa-solid fa-venus-mars"></i>

                        </div>

                        <div>

                            <small>
                                Gender
                            </small>

                            <strong>

                                @(string.IsNullOrWhiteSpace(Model.Gender)
                                                                ? "Not Provided"
                                                                : Model.Gender)

                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Mobile -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon green">

                            <i class="fa-solid fa-mobile-screen-button"></i>

                        </div>

                        <div>

                            <small>
                                Participant Mobile
                            </small>

                            <strong>
                                @Model.MobileNo
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Email -->

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="detail-icon red">

                            <i class="fa-solid fa-at"></i>

                        </div>

                        <div>

                            <small>
                                Participant Email
                            </small>

                            <strong>
                                @Model.Email
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Health Concern -->

                <div class="col-12">

                    <div class="health-concern-box">

                        <div class="health-icon">

                            <i class="fa-solid fa-notes-medical"></i>

                        </div>

                        <div>

                            <small>
                                Health Concern
                            </small>

                            @if (!string.IsNullOrWhiteSpace(Model.HealthConcern))
                            {
                                <p>
                                    @Model.HealthConcern
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">
                                    No health concern was provided during registration.
                                </p>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Payment Information
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon payment-section-icon">

                    <i class="fa-solid fa-credit-card"></i>

                </div>

                <div>

                    <h4>
                        Payment Information
                    </h4>

                    <p>
                        Registration fee and payment details.
                    </p>

                </div>

            </div>


            <div class="payment-summary">


                <!-- Registration Fee -->

                <div class="payment-card">

                    <div class="payment-card-icon blue">

                        <i class="fa-solid fa-indian-rupee-sign"></i>

                    </div>

                    <div>

                        <small>
                            Registration Fee
                        </small>

                        @if (Model.RegistrationFee == 0)
                        {
                            <strong class="text-success">
                                Free
                            </strong>
                        }
                        else
                        {
                            <strong>
                                ₹ @Model.RegistrationFee.ToString("N2")
                            </strong>
                        }

                    </div>

                </div>


                <!-- Amount -->

                <div class="payment-card">

                    <div class="payment-card-icon green">

                        <i class="fa-solid fa-money-bill-wave"></i>

                    </div>

                    <div>

                        <small>
                            Paid / Payable Amount
                        </small>

                        <strong>
                            ₹ @Model.Amount.ToString("N2")
                        </strong>

                    </div>

                </div>


                <!-- Payment Status -->

                <div class="payment-card">

                    <div class="payment-card-icon orange">

                        <i class="fa-solid fa-wallet"></i>

                    </div>

                    <div>

                        <small>
                            Payment Status
                        </small>

                        @if (Model.PaymentStatus == "Paid")
                        {
                            <span class="payment-status paid">

                                <i class="fa-solid fa-circle-check me-1"></i>

                                Paid

                            </span>
                        }
                        else if (Model.PaymentStatus == "Pending")
                        {
                            <span class="payment-status pending">

                                <i class="fa-solid fa-clock me-1"></i>

                                Pending

                            </span>
                        }
                        else if (Model.PaymentStatus == "NotRequired")
                        {
                            <span class="payment-status free">

                                <i class="fa-solid fa-check me-1"></i>

                                Not Required

                            </span>
                        }
                        else
                        {
                            <span class="payment-status">

                                @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                                            ? "Not Available"
                                                            : Model.PaymentStatus)

                        </span>
                                                }

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Camp Description
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon description-section-icon">

                    <i class="fa-solid fa-circle-info"></i>

                </div>

                <div>

                    <h4>
                        Camp Description
                    </h4>

                    <p>
                        Information provided by the administrator.
                    </p>

                </div>

            </div>


            <div class="description-box">

                @if (!string.IsNullOrWhiteSpace(Model.CampDescription))
                {
                    <p>
                        @Model.CampDescription
                    </p>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No camp description is available.
                    </p>
                }

            </div>

        </div>


        <!-- =========================================
             Benefits & Instructions
        ========================================== -->

        <div class="details-section">

            <div class="row g-4">


                <!-- Benefits -->

                <div class="col-lg-6">

                    <div class="information-panel benefits-panel">

                        <div class="panel-heading">

                            <div class="panel-icon">

                                <i class="fa-solid fa-circle-check"></i>

                            </div>

                            <div>

                                <h5>
                                    Camp Benefits
                                </h5>

                                <small>
                                    Services and benefits available.
                                </small>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.Benefits))
                        {
                            <p>
                                @Model.Benefits
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No benefit information is available.
                            </p>
                        }

                    </div>

                </div>


                <!-- Instructions -->

                <div class="col-lg-6">

                    <div class="information-panel instructions-panel">

                        <div class="panel-heading">

                            <div class="panel-icon">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                            </div>

                            <div>

                                <h5>
                                    Important Instructions
                                </h5>

                                <small>
                                    Instructions for participants.
                                </small>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.Instructions))
                        {
                            <p>
                                @Model.Instructions
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No special instructions are available.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>
        <!-- =========================================
             Admin / Hospital Remark
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon remark-section-icon">

                    <i class="fa-solid fa-message"></i>

                </div>

                <div>

                    <h4>
                        Admin / Hospital Remark
                    </h4>

                    <p>
                        Internal note or remark related to this registration.
                    </p>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.AdminRemark))
            {
                <div class="remark-box">

                    <div class="remark-icon">

                        <i class="fa-solid fa-comment-medical"></i>

                    </div>

                    <div>

                        <small>
                            Admin Remark
                        </small>

                        <p>
                            @Model.AdminRemark
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="no-remark-box">

                    <i class="fa-regular fa-note-sticky"></i>

                    <span>
                        No admin remark has been added for this registration.
                    </span>

                </div>
            }

        </div>


        <!-- =========================================
             Registration Timeline
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon timeline-section-icon">

                    <i class="fa-solid fa-timeline"></i>

                </div>

                <div>

                    <h4>
                        Registration Timeline
                    </h4>

                    <p>
                        Registration record and last update information.
                    </p>

                </div>

            </div>


            <div class="timeline">


                <!-- Created -->

                <div class="timeline-item">

                    <div class="timeline-icon created">

                        <i class="fa-solid fa-plus"></i>

                    </div>

                    <div class="timeline-content">

                        <span>
                            Registration Created
                        </span>

                        <strong>

                            @if (Model.CreatedDate != DateTime.MinValue)
                            {
                                @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <text>Not Available</text>
                            }

                        </strong>
                    </div>

                </div>


                <!-- Registration -->

                <div class="timeline-item">

                    <div class="timeline-icon registered">

                        <i class="fa-solid fa-clipboard-check"></i>

                    </div>

                    <div class="timeline-content">

                        <span>
                            Registration Date
                        </span>

                        <strong>

                            @Model.RegistrationDate
                            .ToString("dd MMM yyyy, hh:mm tt")

                        </strong>

                    </div>

                </div>


                <!-- Updated -->
                @if (Model.UpdatedDate.HasValue)
                {
                    <div class="timeline-item">

                        <div class="timeline-icon updated">

                            <i class="fa-solid fa-pen"></i>

                        </div>

                        <div class="timeline-content">

                            <span>
                                Last Updated
                            </span>

                            <strong>

                                @Model.UpdatedDate.Value
                                .ToString("dd MMM yyyy, hh:mm tt")

                            </strong>

                        </div>

                    </div>
                }


                <!-- Current Status -->

                <div class="timeline-item">

                    <div class="timeline-icon current">

                        <i class="fa-solid fa-flag"></i>

                    </div>

                    <div class="timeline-content">

                        <span>
                            Current Status
                        </span>

                        <strong>
                            @Model.RegistrationStatus
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Registration Statistics
        ========================================== -->

        <div class="details-section">

            <div class="section-title">

                <div class="section-icon statistics-section-icon">

                    <i class="fa-solid fa-chart-simple"></i>

                </div>

                <div>

                    <h4>
                        Registration Statistics
                    </h4>

                    <p>
                        Current medical camp seat information.
                    </p>

                </div>

            </div>


            <div class="row g-3">


                <!-- Maximum Participants -->

                <div class="col-md-4">

                    <div class="stat-box">

                        <div class="stat-icon blue">

                            <i class="fa-solid fa-users"></i>

                        </div>

                        <div>

                            <small>
                                Maximum Participants
                            </small>

                            <strong>
                                @Model.MaxParticipants
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Available Seats -->

                <div class="col-md-4">

                    <div class="stat-box">

                        <div class="stat-icon green">

                            <i class="fa-solid fa-chair"></i>

                        </div>

                        <div>

                            <small>
                                Available Seats
                            </small>

                            <strong>
                                @Model.AvailableSeats
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Registration Amount -->

                <div class="col-md-4">

                    <div class="stat-box">

                        <div class="stat-icon orange">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                        </div>

                        <div>

                            <small>
                                Registration Amount
                            </small>

                            <strong>
                                ₹ @Model.Amount.ToString("N2")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Quick Actions
        ========================================== -->

        <div class="quick-action-card">

            <div>

                <h5>

                    <i class="fa-solid fa-bolt me-2"></i>

                    Quick Actions

                </h5>

                <p>
                    Manage this medical camp registration.
                </p>

            </div>


            <div class="quick-actions">

                <a asp-action="ManageCampRegistration"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back to List

                </a>


