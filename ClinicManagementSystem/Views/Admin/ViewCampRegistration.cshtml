                   asp-route-id="@Model.CampRegistrationId"
                   target="_blank"
                   class="btn btn-primary">

                    <i class="fa-solid fa-print me-2"></i>

                    Print Registration

                </a>


                <button type="button"
                        class="btn btn-success"
                        onclick="changeRegistrationStatus(@Model.CampRegistrationId)">

                    <i class="fa-solid fa-rotate me-2"></i>

                    Change Status

                </button>

            </div>

        </div>


        <!-- =========================================
             Page Footer
        ========================================== -->

        <div class="page-footer">

            <div>

                <i class="fa-solid fa-shield-heart"></i>

                <span>
                    Medical Camp Management System
                </span>

            </div>

            <small>
                Registration ID: #@Model.CampRegistrationId
            </small>

        </div>


    </div>


    <!-- =========================================
         JavaScript
    ========================================== -->

    <script>

        function changeRegistrationStatus(id) {

            if (!id) {

                Swal.fire({
                    icon: "error",
                    title: "Invalid Registration",
                    text: "Registration ID was not found."
                });

                return;
            }


            window.location.href =
                '@Url.Action("ChangeCampRegistrationStatus")'
                + '?id='
                + id;

        }

    </script>


