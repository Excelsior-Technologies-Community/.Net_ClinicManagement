@model ClinicManagementSystem.Models.MedicalCampModel

@{
    ViewData["Title"] = "View Medical Camp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="card border-0 shadow mb-4">

        <div class="card-body text-white"
             style="background:linear-gradient(135deg,#0d6efd,#2563eb);">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>

                    <h2 class="fw-bold mb-2">

                        <i class="fa-solid fa-kit-medical me-2"></i>

                        Medical Camp Details

                    </h2>

                    <p class="mb-0">

                        View complete information about this medical camp.

                    </p>

                </div>

                <div class="mt-2 mt-md-0">

                    <a asp-action="EditMedicalCamp"
                       asp-route-id="@Model.CampId"
                       class="btn btn-warning me-2">

                        <i class="fa-solid fa-pen-to-square me-2"></i>

                        Edit

                    </a>

                    <a asp-action="ManageMedicalCamp"
                       class="btn btn-light">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Camp Banner -->

    <div class="card border-0 shadow mb-4 overflow-hidden">

        @if (!string.IsNullOrWhiteSpace(Model.CampBanner))
        {
            <div class="camp-banner-container">

                <img src="~/MedicalCamp/@Model.CampBanner"
                     class="camp-banner"
                     alt="Medical Camp Banner" />

                <div class="banner-overlay">

                    <div class="banner-content">

                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark mb-2">

                                <i class="fa-solid fa-star me-1"></i>

                                Featured Camp

                            </span>
                        }

                        <h1 class="fw-bold">

                            @Model.CampTitle

                        </h1>

                        <p class="mb-0">

                            <i class="fa-solid fa-location-dot me-2"></i>

                            @Model.Venue

                        </p>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="no-banner">

                <i class="fa-solid fa-kit-medical fa-4x mb-3"></i>

                <h3 class="fw-bold">

                    @Model.CampTitle

                </h3>

                <p class="mb-0">

                    @Model.Venue

                </p>

            </div>
        }

    </div>


    <!-- Main Information -->

    <div class="row g-4">

        <!-- Camp Image -->

        <div class="col-lg-4">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center p-4">

                    @if (!string.IsNullOrWhiteSpace(Model.CampImage))
                    {
                        <img src="~/MedicalCamp/@Model.CampImage"
                             class="camp-image mb-4"
                             alt="Medical Camp Image" />
                    }
                    else
                    {
                        <div class="no-image mb-4">

                            <i class="fa-solid fa-image fa-4x"></i>

                            <p class="mt-2 mb-0">

                                No Image Available

                            </p>

                        </div>
                    }

                    <h3 class="fw-bold text-primary">

                        @Model.CampTitle

                    </h3>

                    <div class="mt-3">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success status-badge">

                                <i class="fa-solid fa-circle-check me-1"></i>

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger status-badge">

                                <i class="fa-solid fa-circle-xmark me-1"></i>

                                Inactive

                            </span>
                        }

                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark status-badge ms-1">

                                <i class="fa-solid fa-star me-1"></i>

                                Featured

                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- Basic Details -->

        <div class="col-lg-8">

            <div class="card border-0 shadow h-100">

                <div class="card-body p-4">

                    <h4 class="section-title text-primary mb-4">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        Camp Information

                    </h4>

                    <div class="row g-3">

                        <!-- Camp Date -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon bg-primary">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </div>

                                <div>

                                    <small class="text-muted">

                                        Camp Date

                                    </small>

                                    <h6 class="fw-bold mb-0">

                                        @Model.CampDate?.ToString("dd MMMM yyyy")

                                    </h6>

                                </div>

                            </div>

                        </div>


                        <!-- Camp Time -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon bg-success">

                                    <i class="fa-solid fa-clock"></i>

                                </div>

                                <div>

                                    <small class="text-muted">

                                        Camp Time

                                    </small>

                                    <h6 class="fw-bold mb-0">

                                        @Model.StartTime?.ToString(@"hh\:mm")

                                        -

                                        @Model.EndTime?.ToString(@"hh\:mm")

                                    </h6>

                                </div>

                            </div>

                        </div>


                        <!-- Doctor -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon bg-info">

                                    <i class="fa-solid fa-user-doctor"></i>

                                </div>

                                <div>

                                    <small class="text-muted">

                                        Doctor

                                    </small>

                                    <h6 class="fw-bold mb-0">

                                        @Model.DoctorName

                                    </h6>

                                </div>

                            </div>

                        </div>


                        <!-- Department -->

                        <div class="col-md-6">

                            <div class="info-box">

                                <div class="info-icon bg-warning text-dark">

                                    <i class="fa-solid fa-building"></i>

                                </div>

                                <div>

                                    <small class="text-muted">

                                        Department

                                    </small>

                                    <h6 class="fw-bold mb-0">

                                        @Model.DepartmentName

                                    </h6>

                                </div>

                            </div>

                        </div>


                        <!-- Venue -->

                        <div class="col-12">

                            <div class="info-box">

                                <div class="info-icon bg-danger">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>

                                <div>

                                    <small class="text-muted">

                                        Venue

                                    </small>

                                    <h6 class="fw-bold mb-0">

                                        @Model.Venue

                                    </h6>

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- Registration Details -->

                    <div class="card border-0 bg-light mt-4">

                        <div class="card-body p-4">

                            <h4 class="section-title text-success mb-4">

                                <i class="fa-solid fa-users me-2"></i>

                                Registration Details

                            </h4>

                            <div class="row g-3">

                                <!-- Registration Fee -->

                                <div class="col-md-4">

                                    <div class="detail-box">

                                        <i class="fa-solid fa-indian-rupee-sign text-success"></i>

                                        <small class="text-muted d-block">

                                            Registration Fee

                                        </small>

                                        @if (Model.RegistrationFee == 0)
                                        {
                                            <h5 class="fw-bold text-success mb-0">

                                                Free

                                            </h5>
                                        }
                                        else
                                        {
                                            <h5 class="fw-bold text-success mb-0">

                                                ₹ @Model.RegistrationFee.ToString("N2")

                                            </h5>
                                        }

                                    </div>

                                </div>


                                <!-- Maximum Participants -->

                                <div class="col-md-4">

                                    <div class="detail-box">

                                        <i class="fa-solid fa-user-group text-primary"></i>

                                        <small class="text-muted d-block">

                                            Maximum Participants

                                        </small>

                                        <h5 class="fw-bold mb-0">

                                            @Model.MaxParticipants

                                        </h5>

                                    </div>

                                </div>


                                <!-- Available Seats -->

                                <div class="col-md-4">

                                    <div class="detail-box">

                                        <i class="fa-solid fa-chair text-warning"></i>

                                        <small class="text-muted d-block">

                                            Available Seats

                                        </small>

                                        <h5 class="fw-bold mb-0">

                                            @Model.AvailableSeats

                                        </h5>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Contact Information -->

                    <div class="card border-0 shadow mt-4">

                        <div class="card-body p-4">

                            <h4 class="section-title text-primary mb-4">

                                <i class="fa-solid fa-address-book me-2"></i>

                                Contact Information

                            </h4>

                            <div class="row g-3">

                                <!-- Contact Number -->

                                <div class="col-md-6">

                                    <div class="contact-box">

                                        <i class="fa-solid fa-phone text-success"></i>

                                        <div>

                                            <small class="text-muted">

                                                Contact Number

                                            </small>

                                            <h6 class="fw-bold mb-0">

                                                @Model.ContactNumber

                                            </h6>

                                        </div>

                                    </div>

                                </div>


                                <!-- Email -->

                                <div class="col-md-6">

                                    <div class="contact-box">

                                        <i class="fa-solid fa-envelope text-danger"></i>

                                        <div>

                                            <small class="text-muted">

                                                Email Address

                                            </small>

                                            <h6 class="fw-bold mb-0">

                                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                                {
                                                    @Model.Email
                                                }
                                                else
                                                {
                                                    <span class="text-muted">

                                                        Not Available

                                                    </span>
                                                }

                                            </h6>

                                        </div>

                                    </div>

                                </div>


                                <!-- Organizer -->

                                <div class="col-12">

                                    <div class="contact-box">

                                        <i class="fa-solid fa-user-tie text-primary"></i>

                                        <div>

                                            <small class="text-muted">

                                                Organizer

                                            </small>

                                            <h6 class="fw-bold mb-0">

                                                @if (!string.IsNullOrWhiteSpace(Model.Organizer))
                                                {
                                                    @Model.Organizer
                                                }
                                                else
                                                {
                                                    <span class="text-muted">

                                                        Not Available

                                                    </span>
                                                }

                                            </h6>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Description -->

                    <div class="card border-0 shadow mt-4">

                        <div class="card-body p-4">

                            <h4 class="section-title text-primary mb-3">

                                <i class="fa-solid fa-align-left me-2"></i>

                                About This Medical Camp

                            </h4>

                            @if (!string.IsNullOrWhiteSpace(Model.CampDescription))
                            {
                                <p class="description-text mb-0">

                                    @Model.CampDescription

                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">

                                    No description available for this medical camp.

                                </p>
                            }

                        </div>

                    </div>


                    <!-- Benefits & Instructions -->

                    <div class="row g-4 mt-1">

                        <!-- Benefits -->

                        <div class="col-lg-6">

                            <div class="card border-0 shadow h-100">

                                <div class="card-body p-4">

                                    <h4 class="section-title text-success mb-3">

                                        <i class="fa-solid fa-circle-check me-2"></i>

                                        Camp Benefits

                                    </h4>

                                    @if (!string.IsNullOrWhiteSpace(Model.Benefits))
                                    {
                                        <div class="description-text">

                                            @Model.Benefits

                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">

                                            No benefits information available.

                                        </p>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Instructions -->

                        <div class="col-lg-6">

                            <div class="card border-0 shadow h-100">

                                <div class="card-body p-4">

                                    <h4 class="section-title text-warning mb-3">

                                        <i class="fa-solid fa-triangle-exclamation me-2"></i>

                                        Important Instructions

                                    </h4>

                                    @if (!string.IsNullOrWhiteSpace(Model.Instructions))
                                    {
                                        <div class="description-text">

                                            @Model.Instructions

                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">

                                            No instructions available.

                                        </p>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- Registration Progress -->

                    <div class="card border-0 shadow mt-4">

                        <div class="card-body p-4">

                            <h4 class="section-title text-primary mb-4">

                                <i class="fa-solid fa-chart-line me-2"></i>

                                Registration Progress

                            </h4>

                            @{
                                int registeredParticipants =
                                Model.MaxParticipants - Model.AvailableSeats;

                                if (registeredParticipants < 0)
                                {
                                    registeredParticipants = 0;
                                }

                                double registrationPercentage = 0;

                                if (Model.MaxParticipants > 0)
                                {
                                    registrationPercentage =
                                    ((double)registeredParticipants /
                                    Model.MaxParticipants) * 100;
                                }

                                if (registrationPercentage > 100)
                                {
                                    registrationPercentage = 100;
                                }
                            }

                            <div class="d-flex justify-content-between mb-2">

                                <span class="fw-bold">

                                    Registered:
                                    @registeredParticipants

                                </span>

                                <span class="fw-bold">

                                    Available:
                                    @Model.AvailableSeats

                                </span>

                            </div>

                            <div class="progress registration-progress">

                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     style="width:@registrationPercentage.ToString("0.##")%;">

                                    @registrationPercentage.ToString("0.#")%

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Status & Audit Information -->

                    <div class="card border-0 shadow mt-4">

                        <div class="card-body p-4">

                            <h4 class="section-title text-primary mb-4">

                                <i class="fa-solid fa-clock-rotate-left me-2"></i>

                                Record Information

                            </h4>

                            <div class="row g-3">

                                <!-- Created Date -->

                                <div class="col-md-6">

                                    <div class="audit-box">

                                        <i class="fa-solid fa-calendar-plus text-success"></i>

                                        <div>

                                            <small class="text-muted">

                                                Created Date

                                            </small>

                                            <h6 class="fw-bold mb-0">

                                                @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")

                                            </h6>

                                        </div>

                                    </div>

                                </div>


                                <!-- Updated Date -->

                                <div class="col-md-6">

                                    <div class="audit-box">

                                        <i class="fa-solid fa-calendar-check text-primary"></i>

                                        <div>

                                            <small class="text-muted">

                                                Last Updated

                                            </small>

                                            <h6 class="fw-bold mb-0">

                                                @if (Model.UpdatedDate.HasValue)
                                                {
                                                    @Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">

                                                        Not Updated

                                                    </span>
                                                }

                                            </h6>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Action Buttons -->

                    <div class="card border-0 shadow mt-4 mb-4">

                        <div class="card-body text-center p-4">

                            <a asp-action="EditMedicalCamp"
                               asp-route-id="@Model.CampId"
                               class="btn btn-warning btn-lg me-2">

                                <i class="fa-solid fa-pen-to-square me-2"></i>

                                Edit Camp

                            </a>

                            <a asp-action="ManageMedicalCamp"
                               class="btn btn-secondary btn-lg">

                                <i class="fa-solid fa-arrow-left me-2"></i>

                                Back to Medical Camps

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
        }

        .camp-banner-container {
            position: relative;
            height: 360px;
            overflow: hidden;
        }

        .camp-banner {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .banner-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: end;
            padding: 40px;
            background: linear-gradient( to top, rgba(0,0,0,.75), rgba(0,0,0,.05) );
        }

        .banner-content {
            color: #fff;
        }

            .banner-content h1 {
                font-size: 38px;
                margin-bottom: 8px;
            }

        .no-banner {
            height: 250px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg,#0d6efd,#2563eb);
            color: #fff;
            text-align: center;
        }

        .camp-image {
            width: 100%;
            max-width: 320px;
            height: 250px;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,.12);
        }

        .no-image {
            width: 100%;
            max-width: 320px;
            height: 250px;
            margin: auto;
            border-radius: 16px;
            background: #f1f3f5;
            color: #adb5bd;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .status-badge {
            padding: 9px 15px;
            border-radius: 20px;
            font-size: 13px;
        }

        .section-title {
            font-weight: 700;
            border-left: 5px solid #0d6efd;
            padding-left: 12px;
        }

        .info-box {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 18px;
            background: #f8f9fa;
            border-radius: 12px;
            height: 100%;
            transition: .3s;
        }

            .info-box:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,.08);
            }

        .info-icon {
            min-width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .detail-box {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            height: 100%;
        }

            .detail-box > i {
                font-size: 25px;
                margin-bottom: 10px;
            }

        .contact-box {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #f8f9fa;
            padding: 18px;
            border-radius: 12px;
        }

            .contact-box > i {
                font-size: 22px;
                width: 35px;
                text-align: center;
            }

        .description-text {
            color: #555;
            line-height: 1.8;
            white-space: pre-line;
        }

        .registration-progress {
            height: 25px;
            border-radius: 20px;
            background: #e9ecef;
            overflow: hidden;
        }

            .registration-progress .progress-bar {
                border-radius: 20px;
                font-weight: 600;
                transition: width .6s ease;
            }

        .audit-box {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 18px;
            background: #f8f9fa;
            border-radius: 12px;
        }

            .audit-box > i {
                font-size: 24px;
                width: 35px;
                text-align: center;
            }

        .btn {
            border-radius: 10px;
            font-weight: 600;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        @@media(max-width:768px) {

            .camp-banner-container {
                height: 280px;
            }

            .banner-overlay {
                padding: 25px;
            }

            .banner-content h1 {
                font-size: 27px;
            }

            .camp-image,
            .no-image {
                height: 220px;
            }

            .btn-lg {
                width: 100%;
                margin-bottom: 10px;
                margin-right: 0 !important;
            }
        }

        @@media(max-width:576px) {

            .camp-banner-container {
                height: 230px;
            }

            .banner-content h1 {
                font-size: 22px;
            }

            .banner-overlay {
                padding: 18px;
            }

            .section-title {
                font-size: 19px;
            }
        }

    </style>

}


@section Scripts {

    <script>

        $(document).ready(function () {

            // Registration progress animation

            var progressBar = $(".registration-progress .progress-bar");

            var width = progressBar.css("width");

            progressBar.css("width", "0");

            setTimeout(function () {

                progressBar.css("width", width);

            }, 300);

        });

    </script>

}