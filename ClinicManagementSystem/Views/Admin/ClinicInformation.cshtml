@model ClinicManagementSystem.Models.ClinicInformationModel

@{
    ViewData["Title"] = "Clinic Information";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->

    <div class="card shadow border-0 mb-4">

        <div class="card-body text-white rounded"
             style="background:linear-gradient(135deg,#0d6efd,#2563eb);">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-2">

                        <i class="fa-solid fa-hospital me-2"></i>

                        Clinic Information

                    </h2>

                    <p class="mb-0">

                        Manage your clinic information, contact details,
                        social links and About Us page.

                    </p>

                </div>

                <div>

                    <i class="fa-solid fa-hospital-user display-4"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Clinic Form -->

    <div class="card shadow border-0">

        <div class="card-body">

            <form asp-action="ClinicInformation"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="ClinicId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Clinic Name -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="ClinicName"
                               class="form-label fw-bold">

                            Clinic Name

                        </label>

                        <input asp-for="ClinicName"
                               class="form-control"
                               placeholder="Enter Clinic Name" />

                        <span asp-validation-for="ClinicName"
                              class="text-danger"></span>

                    </div>

                    <!-- Mobile -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="MobileNo"
                               class="form-label fw-bold">

                            Mobile Number

                        </label>

                        <input asp-for="MobileNo"
                               class="form-control"
                               placeholder="Enter Mobile Number" />

                        <span asp-validation-for="MobileNo"
                              class="text-danger"></span>

                    </div>

                    <!-- Alternate Mobile -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="AlternateMobileNo"
                               class="form-label fw-bold">

                            Alternate Mobile

                        </label>

                        <input asp-for="AlternateMobileNo"
                               class="form-control"
                               placeholder="Alternate Mobile Number" />

                    </div>

                    <!-- Email -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-bold">

                            Email Address

                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter Email Address" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>

                    <!-- Address -->

                    <div class="col-12 mb-3">

                        <label asp-for="Address"
                               class="form-label fw-bold">

                            Clinic Address

                        </label>

                        <textarea asp-for="Address"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Enter Complete Clinic Address"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger"></span>

                    </div>

                    <!-- About Clinic -->

                    <div class="col-12 mb-3">

                        <label asp-for="AboutClinic"
                               class="form-label fw-bold">

                            About Clinic

                        </label>

                        <textarea asp-for="AboutClinic"
                                  rows="6"
                                  class="form-control"
                                  placeholder="Write About Your Clinic"></textarea>

                        <span asp-validation-for="AboutClinic"
                              class="text-danger"></span>

                    </div>
                    <!-- Mission -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Mission"
                               class="form-label fw-bold">

                            Mission

                        </label>

                        <textarea asp-for="Mission"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter Clinic Mission"></textarea>

                    </div>

                    <!-- Vision -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Vision"
                               class="form-label fw-bold">

                            Vision

                        </label>

                        <textarea asp-for="Vision"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter Clinic Vision"></textarea>

                    </div>

                    <!-- Why Choose Us -->

                    <div class="col-12 mb-3">

                        <label asp-for="WhyChooseUs"
                               class="form-label fw-bold">

                            Why Choose Us

                        </label>

                        <textarea asp-for="WhyChooseUs"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Write why patients should choose your clinic"></textarea>

                    </div>

                    <!-- Working Hours -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="WorkingHours"
                               class="form-label fw-bold">

                            Working Hours

                        </label>

                        <input asp-for="WorkingHours"
                               class="form-control"
                               placeholder="Example : Mon - Sat (9:00 AM - 8:00 PM)" />

                        <span asp-validation-for="WorkingHours"
                              class="text-danger"></span>

                    </div>

                    <!-- Emergency Contact -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmergencyContact"
                               class="form-label fw-bold">

                            Emergency Contact

                        </label>

                        <input asp-for="EmergencyContact"
                               class="form-control"
                               placeholder="Enter Emergency Contact Number" />

                    </div>

                    <!-- Website -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Website"
                               class="form-label fw-bold">

                            Website

                        </label>

                        <input asp-for="Website"
                               class="form-control"
                               placeholder="https://www.example.com" />

                    </div>

                    <!-- WhatsApp -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="WhatsAppNo"
                               class="form-label fw-bold">

                            WhatsApp Number

                        </label>

                        <input asp-for="WhatsAppNo"
                               class="form-control"
                               placeholder="Enter WhatsApp Number" />

                    </div>

                    <!-- Google Map -->

                    <div class="col-12 mb-3">

                        <label asp-for="GoogleMapLink"
                               class="form-label fw-bold">

                            Google Map Link

                        </label>

                        <textarea asp-for="GoogleMapLink"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Paste Google Map Embed Link or URL"></textarea>

                    </div>

                    <!-- Facebook -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="FacebookLink"
                               class="form-label fw-bold">

                            Facebook Link

                        </label>

                        <input asp-for="FacebookLink"
                               class="form-control"
                               placeholder="Facebook Profile/Page URL" />

                    </div>

                    <!-- Instagram -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="InstagramLink"
                               class="form-label fw-bold">

                            Instagram Link

                        </label>

                        <input asp-for="InstagramLink"
                               class="form-control"
                               placeholder="Instagram Profile URL" />

                    </div>

                    <!-- Twitter -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="TwitterLink"
                               class="form-label fw-bold">

                            Twitter (X) Link

                        </label>

                        <input asp-for="TwitterLink"
                               class="form-control"
                               placeholder="Twitter/X Profile URL" />

                    </div>
                    <!-- Clinic Logo -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="ClinicLogoFile"
                               class="form-label fw-bold">

                            Clinic Logo

                        </label>

                        <input asp-for="ClinicLogoFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        @if (!string.IsNullOrEmpty(Model.ClinicLogo))
                        {
                            <div class="mt-3">

                                <img src="~/Clinic/@Model.ClinicLogo"
                                     id="logoPreview"
                                     class="img-thumbnail shadow"
                                     style="height:120px;width:120px;object-fit:cover;" />

                            </div>
                        }
                        else
                        {
                            <img id="logoPreview"
                                 class="img-thumbnail mt-3 d-none shadow"
                                 style="height:120px;width:120px;object-fit:cover;" />
                        }

                    </div>

                    <!-- Banner Image -->

                    <div class="col-md-6 mb-4">

                        <label asp-for="BannerImageFile"
                               class="form-label fw-bold">

                            Banner Image

                        </label>

                        <input asp-for="BannerImageFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        @if (!string.IsNullOrEmpty(Model.BannerImage))
                        {
                            <div class="mt-3">

                                <img src="~/Clinic/@Model.BannerImage"
                                     id="bannerPreview"
                                     class="img-thumbnail shadow"
                                     style="height:120px;width:220px;object-fit:cover;" />

                            </div>
                        }
                        else
                        {
                            <img id="bannerPreview"
                                 class="img-thumbnail mt-3 d-none shadow"
                                 style="height:120px;width:220px;object-fit:cover;" />
                        }

                    </div>

                    <!-- Status -->

                    <div class="col-12 mb-4">

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-bold">

                                Clinic Active

                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-success px-5">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Save Information

                    </button>

                    <button type="reset"
                            class="btn btn-warning px-5 ms-2">

                        <i class="fa-solid fa-rotate me-2"></i>

                        Reset

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .form-control,
        textarea {
            border-radius: 10px;
        }

            .form-control:focus,
            textarea:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        textarea {
            resize: none;
        }

        .form-check-input {
            width: 50px;
            height: 25px;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .img-thumbnail {
            border-radius: 12px;
        }

        @@media(max-width:768px) {

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $("#ClinicLogoFile").change(function () {

            const file = this.files[0];

            if(file){

                $("#logoPreview")
                    .removeClass("d-none")
                    .attr("src",URL.createObjectURL(file));
            }

        });

        $("#BannerImageFile").change(function () {

            const file = this.files[0];

            if(file){

                $("#bannerPreview")
                    .removeClass("d-none")
                    .attr("src",URL.createObjectURL(file));
            }

        });

    </script>

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

            icon:'success',

            title:'Success',

            text:'@TempData["Success"]'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

            icon:'error',

            title:'Error',

            text:'@TempData["Error"]'

            });

        </script>
    }

}