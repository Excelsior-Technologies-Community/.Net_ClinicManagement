@model ClinicManagementSystem.Models.LabTestModel
@{
    ViewData["Title"] = "View Lab Test";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0 text-primary"><i class="fas fa-info-circle me-2"></i>Lab Test Details</h3>
        <small class="text-muted">Detailed specifications and pricing for diagnostic test</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ManageLabTest" class="btn btn-secondary shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
        <a asp-action="EditLabTest" asp-route-id="@Model.LabTestId" class="btn btn-warning shadow-sm"><i class="fas fa-edit me-1"></i> Edit Test</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="fas fa-flask me-2"></i>@Model.TestName</h5>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted text-uppercase mb-3"><i class="fas fa-list-alt me-2 text-primary"></i>Basic Information</h6>
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 40%;">Test ID:</th>
                                    <td class="fw-bold">#@Model.LabTestId</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Test Name:</th>
                                    <td class="fw-bold text-primary">@Model.TestName</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Category:</th>
                                    <td><span class="badge bg-info text-dark">@(string.IsNullOrEmpty(Model.TestCategory) ? "General" : Model.TestCategory)</span></td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Price:</th>
                                    <td class="fw-bold text-success fs-5">₹@Model.Price.ToString("N2")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted text-uppercase mb-3"><i class="fas fa-vial me-2 text-danger"></i>Sample & Processing</h6>
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Sample Type:</th>
                                    <td class="fw-bold">@(string.IsNullOrEmpty(Model.SampleType) ? "Standard Blood/Urine" : Model.SampleType)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Expected Report Time:</th>
                                    <td class="fw-bold text-warning">@(string.IsNullOrEmpty(Model.ReportTime) ? "Within 24 Hours" : Model.ReportTime)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Created Date:</th>
                                    <td>@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Last Updated:</th>
                                    <td>@(Model.UpdatedDate.HasValue ? Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt") : "N/A")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="text-muted text-uppercase mb-2"><i class="fas fa-clipboard-list me-2 text-warning"></i>Preparation Instructions</h6>
                            <p class="mb-0 text-dark" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.PreparationInstructions) ? "No specific preparation required prior to sample collection." : Model.PreparationInstructions)</p>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="text-muted text-uppercase mb-2"><i class="fas fa-align-left me-2 text-info"></i>Description</h6>
                            <p class="mb-0 text-dark" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Description) ? "No detailed description provided." : Model.Description)</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between">
                <a asp-action="ChangeLabTestStatus" asp-route-id="@Model.LabTestId" class="btn btn-outline-secondary"><i class="fas fa-toggle-on me-1"></i> Toggle Status</a>
                <a asp-action="EditLabTest" asp-route-id="@Model.LabTestId" class="btn btn-warning"><i class="fas fa-edit me-1"></i> Edit Details</a>
            </div>
        </div>
    </div>
</div>
