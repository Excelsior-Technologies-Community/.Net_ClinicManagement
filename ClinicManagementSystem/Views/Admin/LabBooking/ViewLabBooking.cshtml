@model ClinicManagementSystem.Models.LabBookingModel
@{
    ViewData["Title"] = "View Lab Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0 text-primary"><i class="fas fa-file-invoice me-2"></i>Lab Booking Details</h3>
        <small class="text-muted">Booking Reference: <strong class="text-dark">@Model.BookingNo</strong></small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ManageLabBooking" class="btn btn-secondary shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
        <a asp-action="ChangeLabBookingStatus" asp-route-id="@Model.LabBookingId" class="btn btn-warning shadow-sm"><i class="fas fa-edit me-1"></i> Update Status</a>
        <a asp-action="UploadLabReport" asp-route-bookingId="@Model.LabBookingId" class="btn btn-success shadow-sm"><i class="fas fa-file-upload me-1"></i> Upload Report</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="fas fa-microscope me-2"></i>Booking #@Model.BookingNo</h5>
                <div>
                    <span class="badge bg-light text-primary me-2">Date: @Model.BookingDate.ToString("dd MMM yyyy")</span>
                    @if (Model.TestStatus == "Completed")
                    {
                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Completed</span>
                    }
                    else if (Model.TestStatus == "In Progress")
                    {
                        <span class="badge bg-warning text-dark"><i class="fas fa-spinner fa-spin me-1"></i>In Progress</span>
                    }
                    else if (Model.TestStatus == "Sample Collected")
                    {
                        <span class="badge bg-info text-dark"><i class="fas fa-vial me-1"></i>Sample Collected</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="fas fa-clock me-1"></i>Pending</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- Patient Info -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted text-uppercase mb-3"><i class="fas fa-user-patient me-2 text-primary"></i>Patient Information</h6>
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 40%;">Patient Name:</th>
                                    <td class="fw-bold text-dark">@Model.PatientName</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Mobile No:</th>
                                    <td class="fw-bold"><i class="fas fa-phone text-secondary me-1"></i>@(string.IsNullOrEmpty(Model.MobileNo) ? "N/A" : Model.MobileNo)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Email Address:</th>
                                    <td><i class="fas fa-envelope text-secondary me-1"></i>@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Age / Gender:</th>
                                    <td>@(Model.Age.HasValue ? Model.Age.Value.ToString() + " Yrs" : "N/A") / @(string.IsNullOrEmpty(Model.Gender) ? "N/A" : Model.Gender)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Registered Account:</th>
                                    <td>@(string.IsNullOrEmpty(Model.CustomerName) ? "Guest / Direct" : Model.CustomerName)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Test Info -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted text-uppercase mb-3"><i class="fas fa-flask me-2 text-danger"></i>Test & Appointment Info</h6>
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Test Name:</th>
                                    <td class="fw-bold text-primary">@Model.TestName</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Category / Sample:</th>
                                    <td>
                                        <span class="badge bg-info text-dark me-1">@Model.TestCategory</span>
                                        <span class="badge bg-light text-dark border"><i class="fas fa-vial me-1"></i>@Model.SampleType</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Preferred Date/Time:</th>
                                    <td class="fw-bold">
                                        @(Model.PreferredDate.HasValue ? Model.PreferredDate.Value.ToString("dd MMM yyyy") : "Any Date")
                                        <span class="text-muted">(@(string.IsNullOrEmpty(Model.PreferredTime) ? "Anytime" : Model.PreferredTime))</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Total Amount:</th>
                                    <td class="fw-bold text-success fs-5">₹@Model.Amount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Payment Status:</th>
                                    <td>
                                        @if (Model.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-double me-1"></i>Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-exclamation-circle me-1"></i>Pending</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Health Concern -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="text-muted text-uppercase mb-2"><i class="fas fa-notes-medical me-2 text-warning"></i>Health Concerns / Symptoms</h6>
                            <p class="mb-0 text-dark">@(string.IsNullOrEmpty(Model.HealthConcern) ? "No health concern specified." : Model.HealthConcern)</p>
                        </div>
                    </div>

                    <!-- Admin Remark -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="text-muted text-uppercase mb-2"><i class="fas fa-comment-dots me-2 text-info"></i>Admin Remarks</h6>
                            <p class="mb-0 text-dark">@(string.IsNullOrEmpty(Model.AdminRemark) ? "No remarks added by administrator yet." : Model.AdminRemark)</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between">
                <a asp-action="ManageLabBooking" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Back</a>
                <div>
                    <a asp-action="ChangeLabBookingStatus" asp-route-id="@Model.LabBookingId" class="btn btn-warning me-2"><i class="fas fa-edit me-1"></i> Change Status</a>
                    <a asp-action="UploadLabReport" asp-route-bookingId="@Model.LabBookingId" class="btn btn-success"><i class="fas fa-file-upload me-1"></i> Upload Test Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
