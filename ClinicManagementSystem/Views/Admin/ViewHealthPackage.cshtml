@model ClinicManagementSystem.Models.HealthPackageModel

@{
    ViewData["Title"] = "View Health Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-heart-pulse text-primary me-2"></i>
                Health Package Details
            </h3>

            <p class="text-muted mb-0">
                View complete information about this health package.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="EditHealthPackage"
               asp-route-id="@Model.HealthPackageId"
               class="btn btn-primary">

                <i class="fa-solid fa-pen-to-square me-1"></i>
                Edit

            </a>

            <a asp-action="ManageHealthPackage"
               class="btn btn-secondary">

                <i class="fa-solid fa-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- ================= MAIN CARD ================= -->

    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- TITLE -->

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0 fw-bold">

                <i class="fa-solid fa-box-heart me-2"></i>

                @Model.PackageName

            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- ================= IMAGE ================= -->

                <div class="col-lg-4">

                    <div class="card border-0 bg-light h-100">

                        <div class="card-body text-center p-4">

                            @if (!string.IsNullOrWhiteSpace(Model.PackageImage))
                            {
                                <img src="~/HealthPackageImages/@Model.PackageImage"
                                     alt="@Model.PackageName"
                                     class="img-fluid rounded-4 shadow-sm"
                                     style="width:100%;
                                            max-height:280px;
                                            object-fit:cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center
                                            justify-content-center
                                            bg-primary bg-opacity-10
                                            text-primary rounded-4 mx-auto"
                                     style="height:280px;">

                                    <i class="fa-solid fa-heart-pulse"
                                       style="font-size:70px;">
                                    </i>

                                </div>
                            }


                            <div class="mt-3">

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">

                                        <i class="fa-solid fa-check me-1"></i>
                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">

                                        <i class="fa-solid fa-xmark me-1"></i>
                                        Inactive

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================= BASIC INFORMATION ================= -->

                <div class="col-lg-8">

                    <div class="row g-3">

                        <!-- PACKAGE NAME -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Package Name
                                </small>

                                <div class="fw-bold text-dark">

                                    @Model.PackageName

                                </div>

                            </div>

                        </div>


                        <!-- CATEGORY -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Category
                                </small>

                                @if (!string.IsNullOrWhiteSpace(Model.Category))
                                {
                                    <span class="badge bg-info text-dark px-3 py-2">
                                        @Model.Category
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not specified
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ORIGINAL PRICE -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Original Price
                                </small>

                                <div class="fw-semibold text-decoration-line-through
                                            text-muted">

                                    ₹@Model.OriginalPrice.ToString("N2")

                                </div>

                            </div>

                        </div>


                        <!-- DISCOUNT PRICE -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Discount Price
                                </small>

                                <div class="fw-bold text-success fs-5">

                                    ₹@Model.DiscountPrice.ToString("N2")

                                </div>

                                @if (Model.OriginalPrice > Model.DiscountPrice)
                                {
                                    decimal discount =
                                        Model.OriginalPrice -
                                        Model.DiscountPrice;

                                    <small class="text-success">

                                        Save ₹@discount.ToString("N2")

                                    </small>
                                }

                            </div>

                        </div>


                        <!-- VALIDITY -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Validity
                                </small>

                                <div class="fw-semibold">

                                    <i class="fa-regular fa-calendar
                                              text-primary me-1">
                                    </i>

                                    @(string.IsNullOrWhiteSpace(Model.Validity)
                                        ? "Not specified"
                                        : Model.Validity)

                                </div>

                            </div>

                        </div>


                        <!-- DISPLAY ORDER -->

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    Display Order
                                </small>

                                <span class="badge bg-light text-dark border px-3 py-2">

                                    @Model.DisplayOrder

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================= DESCRIPTION ================= -->

            <div class="mb-4">

                <h5 class="fw-bold mb-3">

                    <i class="fa-solid fa-align-left text-primary me-2"></i>
                    Description

                </h5>

                <div class="bg-light rounded-3 p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="mb-0 text-secondary"
                           style="white-space:pre-line;">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <span class="text-muted">
                            No description available.
                        </span>
                    }

                </div>

            </div>


            <!-- ================= BENEFITS ================= -->

            <div class="mb-4">

                <h5 class="fw-bold mb-3">

                    <i class="fa-solid fa-circle-check text-success me-2"></i>
                    Package Benefits

                </h5>

                <div class="bg-light rounded-3 p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.Benefits))
                    {
                        <p class="mb-0 text-secondary"
                           style="white-space:pre-line;">
                            @Model.Benefits
                        </p>
                    }
                    else
                    {
                        <span class="text-muted">
                            No benefits information available.
                        </span>
                    }

                </div>

            </div>


            <!-- ================= PREPARATION ================= -->

            <div class="mb-4">

                <h5 class="fw-bold mb-3">

                    <i class="fa-solid fa-clipboard-list text-warning me-2"></i>
                    Preparation Instructions

                </h5>

                <div class="bg-light rounded-3 p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.PreparationInstructions))
                    {
                        <p class="mb-0 text-secondary"
                           style="white-space:pre-line;">
                            @Model.PreparationInstructions
                        </p>
                    }
                    else
                    {
                        <span class="text-muted">
                            No preparation instructions available.
                        </span>
                    }

                </div>

            </div>


            <!-- ================= STATUS ================= -->

            <div class="row g-3">

                <div class="col-md-4">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted d-block mb-1">
                            Package Status
                        </small>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success px-3 py-2">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                Inactive
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted d-block mb-1">
                            Created Date
                        </small>

                        <span class="fw-semibold">

                            @if (Model.CreatedDate.HasValue)
                            {
                                @Model.CreatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Available
                                </span>
                            }

                        </span>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted d-block mb-1">
                            Last Updated
                        </small>

                        <span class="fw-semibold">

                            @if (Model.UpdatedDate.HasValue)
                            {
                                @Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Updated
                                </span>
                            }

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= FOOTER ================= -->

        <div class="card-footer bg-white border-top p-3">

            <div class="d-flex justify-content-between align-items-center">

                <small class="text-muted">

                    Package ID:
                    <strong>
                        #@Model.HealthPackageId
                    </strong>

                </small>

                <div class="d-flex gap-2">

                    <a asp-action="ManageHealthPackage"
                       class="btn btn-light border">

                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Back to List

                    </a>

                    <a asp-action="EditHealthPackage"
                       asp-route-id="@Model.HealthPackageId"
                       class="btn btn-primary">

                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        Edit Package

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>