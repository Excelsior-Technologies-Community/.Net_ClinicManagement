@model ClinicManagementSystem.Models.DoctorModel
@{
    ViewData["Title"] = "View Doctor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="container-fluid">

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa-solid fa-user-doctor"></i> Doctor Details</h4>

            <div>
                <a asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn btn-warning btn-sm">
                    <i class="fa fa-edit"></i> Edit
                </a>

                <a asp-action="ManageDoctor" class="btn btn-dark btn-sm">
                    <i class="fa fa-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-lg-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.DoctorImage))
                    {
                        <img src="~/Department/@Model.DoctorImage"
                             class="img-fluid rounded shadow border"
                             style="width:260px;height:260px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/Admin/images/no-image.png"
                             class="img-fluid rounded shadow border"
                             style="width:260px;height:260px;object-fit:cover;" />
                    }

                    <h4 class="mt-3 fw-bold">@Model.DoctorName</h4>
                    <p class="text-muted">@Model.Specialization</p>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Inactive</span>
                    }

                </div>

                <div class="col-lg-8">

                    <table class="table table-bordered table-striped">

                        <tr>
                            <th width="230">Department</th>
                            <td>@Model.DepartmentName</td>
                        </tr>

                        <tr>
                            <th>Qualification</th>
                            <td>@Model.Qualification</td>
                        </tr>

                        <tr>
                            <th>Experience</th>
                            <td>@Model.Experience Years</td>
                        </tr>

                        <tr>
                            <th>Consultation Fee</th>
                            <td>₹ @Model.ConsultationFee</td>
                        </tr>

                        <tr>
                            <th>Mobile Number</th>
                            <td>@Model.MobileNo</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>

                        <tr>
                            <th>Available Time</th>
                            <td>
                                @(Model.AvailableFrom?.ToString(@"hh\:mm"))
                                -
                                @(Model.AvailableTo?.ToString(@"hh\:mm"))
                            </td>
                        </tr>

                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>

                        <tr>
                            <th>Created Date</th>
                            <td>@Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")</td>
                        </tr>

                        <tr>
                            <th>Updated Date</th>
                            <td>
                                @(Model.UpdatedDate.HasValue
                                                                ? Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                                : "-")
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>
