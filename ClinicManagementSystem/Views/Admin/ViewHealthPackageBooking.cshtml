@model ClinicManagementSystem.Models.HealthPackageBookingModel

@{
    ViewData["Title"] = "View Health Package Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-calendar-check text-primary me-2"></i>
                Health Package Booking Details
            </h3>

            <p class="text-muted mb-0">
                View complete information about this health package booking.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="ManageHealthPackageBooking"
           class="btn btn-secondary rounded-2">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Bookings

        </a>

    </div>


    <!-- ================= ALERTS ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= BOOKING HEADER ================= -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

        <div class="card-header bg-primary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fa-solid fa-file-medical me-2"></i>
                        Booking Information
                    </h5>

                    <small class="opacity-75">
                        Complete booking details
                    </small>
                </div>

                <div class="text-end">

                    <small class="d-block opacity-75">
                        Booking Number
                    </small>

                    <strong class="fs-5">
                        @(string.IsNullOrWhiteSpace(Model.BookingNo)
                                                ? "N/A"
                                                : Model.BookingNo)
                    </strong>

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- BOOKING DATE -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="info-icon">
                            <i class="fa-regular fa-calendar"></i>
                        </div>

                        <div>
                            <small class="text-muted d-block">
                                Booking Date
                            </small>

                            <strong>
                                @if (Model.BookingDate.HasValue)
                                {
                                    @Model.BookingDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span>Not Available</span>
                                }
                            </strong>
                        </div>

                    </div>

                </div>


                <!-- PAYMENT STATUS -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="info-icon">
                            <i class="fa-solid fa-credit-card"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Payment Status
                            </small>

                            @if (string.Equals(
                                                        Model.PaymentStatus,
                                                        "Paid",
                                                        StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-check me-1"></i>
                                    Paid
                                </span>
                            }
                            else if (string.Equals(
                            Model.PaymentStatus,
                            "Pending",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i>
                                    Pending
                                </span>
                            }
                            else if (string.Equals(
                            Model.PaymentStatus,
                            "Failed",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                    Failed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                    @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                                                    ? "N/A"
                                                                    : Model.PaymentStatus)
                            </span>
                                                        }

                        </div>

                    </div>

                </div>


                <!-- BOOKING STATUS -->

                <div class="col-md-4">

                    <div class="info-box">

                        <div class="info-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Booking Status
                            </small>

                            @if (string.Equals(
                                                        Model.BookingStatus,
                                                        "Confirmed",
                                                        StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-check me-1"></i>
                                    Confirmed
                                </span>
                            }
                            else if (string.Equals(
                            Model.BookingStatus,
                            "Pending",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i>
                                    Pending
                                </span>
                            }
                            else if (string.Equals(
                            Model.BookingStatus,
                            "Completed",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-flag-checkered me-1"></i>
                                    Completed
                                </span>
                            }
                            else if (string.Equals(
                            Model.BookingStatus,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-xmark me-1"></i>
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                    @(string.IsNullOrWhiteSpace(Model.BookingStatus)
                                                                    ? "N/A"
                                                                    : Model.BookingStatus)
                            </span>
                                                        }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= PACKAGE + PATIENT ================= -->

    <div class="row g-4">

        <!-- ================= PACKAGE DETAILS ================= -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white py-3 border-bottom">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-heart-pulse text-danger me-2"></i>
                        Health Package
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="package-box mb-4">

                        <div class="package-icon">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>

                        <div>

                            <small class="text-muted">
                                Package Name
                            </small>

                            <h5 class="fw-bold mb-0">
                                @(string.IsNullOrWhiteSpace(Model.PackageName)
                                                                ? "N/A"
                                                                : Model.PackageName)
                            </h5>

                        </div>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Package ID
                        </span>

                        <span class="detail-value">
                            @Model.HealthPackageId
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Booking Amount
                        </span>

                        <span class="detail-value text-success fw-bold">
                            ₹@Model.Amount.ToString("N2")
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Payment Status
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                                        ? "N/A"
                                                        : Model.PaymentStatus)
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= CUSTOMER DETAILS ================= -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white py-3 border-bottom">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-user text-primary me-2"></i>
                        Customer / Patient Information
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="detail-row">

                        <span class="detail-label">
                            Customer Name
                        </span>

                        <span class="detail-value fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.CustomerName)
                                                        ? "N/A"
                                                        : Model.CustomerName)
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Patient Name
                        </span>

                        <span class="detail-value fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.PatientName)
                                                        ? "N/A"
                                                        : Model.PatientName)
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Mobile Number
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.MobileNo)
                                                        ? "N/A"
                                                        : Model.MobileNo)
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Email)
                                                        ? "N/A"
                                                        : Model.Email)
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Customer ID
                        </span>

                        <span class="detail-value">
                            @Model.CustomerId
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= SCHEDULE ================= -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">

        <div class="card-header bg-white py-3 border-bottom">

            <h5 class="fw-bold mb-0">

                <i class="fa-solid fa-calendar-days text-primary me-2"></i>

                Preferred Schedule

            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- DATE -->

                <div class="col-md-6">

                    <div class="schedule-box">

                        <div class="schedule-icon">
                            <i class="fa-regular fa-calendar"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Preferred Date
                            </small>

                            <strong>
                                @if (Model.PreferredDate.HasValue)
                                {
                                    @Model.PreferredDate.Value.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span>Not Selected</span>
                                }
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- TIME -->

                <div class="col-md-6">

                    <div class="schedule-box">

                        <div class="schedule-icon">
                            <i class="fa-regular fa-clock"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Preferred Time
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.PreferredTime)
                                                                ? "Not Selected"
                                                                : Model.PreferredTime)
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= HEALTH CONCERN ================= -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">

        <div class="card-header bg-white py-3 border-bottom">

            <h5 class="fw-bold mb-0">

                <i class="fa-solid fa-notes-medical text-primary me-2"></i>

                Health Concern / Patient Notes

            </h5>

        </div>

        <div class="card-body p-4">

            @if (!string.IsNullOrWhiteSpace(Model.HealthConcern))
            {
                <div class="notes-box">
                    @Model.HealthConcern
                </div>
            }
            else
            {
                <div class="text-muted">
                    No health concern or additional notes provided.
                </div>
            }

        </div>

    </div>


    <!-- ================= ADMIN REMARK ================= -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">

        <div class="card-header bg-white py-3 border-bottom">

            <h5 class="fw-bold mb-0">

                <i class="fa-solid fa-user-shield text-primary me-2"></i>

                Admin Remark

            </h5>

        </div>

        <div class="card-body p-4">

            @if (!string.IsNullOrWhiteSpace(Model.AdminRemark))
            {
                <div class="notes-box">
                    @Model.AdminRemark
                </div>
            }
            else
            {
                <div class="text-muted">
                    No admin remark added.
                </div>
            }

        </div>

    </div>


    <!-- ================= SYSTEM INFORMATION ================= -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">

        <div class="card-header bg-white py-3 border-bottom">

            <h5 class="fw-bold mb-0">

                <i class="fa-solid fa-circle-info text-primary me-2"></i>

                System Information

            </h5>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Package Booking ID
                    </small>

                    <strong>
                        @Model.PackageBookingId
                    </strong>

                </div>


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Created Date
                    </small>

                    <strong>

                        @if (Model.CreatedDate.HasValue)
                        {
                            @Model.CreatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                        }
                        else
                        {
                            <span>N/A</span>
                        }

                    </strong>

                </div>


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Updated Date
                    </small>

                    <strong>

                        @if (Model.UpdatedDate.HasValue)
                        {
                            @Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                        }
                        else
                        {
                            <span>Not Updated</span>
                        }

                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= ACTION BUTTONS ================= -->

    <div class="d-flex justify-content-end gap-2 mt-4 mb-4">

        <a asp-controller="Admin"
           asp-action="ManageHealthPackageBooking"
           class="btn btn-secondary px-4">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </a>


        <a asp-controller="Admin"
           asp-action="ChangeHealthPackageBookingStatus"
           asp-route-id="@Model.PackageBookingId"
           class="btn btn-warning px-4">

            <i class="fa-solid fa-rotate me-1"></i>

            Change Status

        </a>

    </div>

</div>


<!-- ================= PAGE CSS ================= -->

<style>

    .info-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        height: 100%;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f1ff;
        color: #0d6efd;
        border-radius: 50%;
        font-size: 18px;
    }

    .package-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        background: #fff5f6;
        border: 1px solid #f3d6da;
        border-radius: 14px;
    }

    .package-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffe3e6;
        color: #dc3545;
        border-radius: 12px;
        font-size: 20px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f2;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #6c757d;
        font-size: 14px;
    }

    .detail-value {
        color: #212529;
        text-align: right;
        font-size: 14px;
    }

    .schedule-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 14px;
    }

    .schedule-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f1ff;
        color: #0d6efd;
        border-radius: 12px;
        font-size: 19px;
    }

    .notes-box {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 18px;
        white-space: pre-line;
        line-height: 1.7;
        color: #495057;
    }

    .card {
        transition: 0.2s ease;
    }

    .badge {
        font-weight: 500;
    }

    @@media (max-width: 768px) {

        .detail-row {
            flex-direction: column;
            gap: 5px;
        }

        .detail-value {
            text-align: left;
        }
    }

</style>