@model ClinicManagementSystem.Models.BillingModel

@{
    ViewData["Title"] = "Generate Bill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="card border-0 shadow-lg mb-4">

        <div class="card-body text-white"
             style="background:linear-gradient(135deg,#0d6efd,#4f8cff);">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1">

                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>

                        Generate Medical Bill

                    </h2>

                    <p class="mb-0">

                        Generate patient's medical bill.

                    </p>

                </div>

                <a asp-action="ManageBills"
                   class="btn btn-light">

                    <i class="fa fa-arrow-left me-2"></i>

                    Back

                </a>

            </div>

        </div>

    </div>

    <form asp-action="GenerateBill" method="post">

        @Html.AntiForgeryToken()

        <input asp-for="AppointmentId" type="hidden" />
        <input asp-for="CustomerId" type="hidden" />
        <input asp-for="DoctorId" type="hidden" />

        <div class="row">

            <!-- Patient Information -->

            <div class="col-lg-6 mb-4">

                <div class="card shadow border-0 h-100">

                    <div class="card-header bg-success text-white">

                        <h5 class="mb-0">

                            <i class="fa-solid fa-user me-2"></i>

                            Patient Information

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Appointment No

                            </label>

                            <input class="form-control"
                                   value="@Model.AppointmentNo"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Patient Name

                            </label>

                            <input class="form-control"
                                   value="@Model.CustomerName"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Mobile Number

                            </label>

                            <input class="form-control"
                                   value="@Model.MobileNo"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Email Address

                            </label>

                            <input class="form-control"
                                   value="@Model.Email"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Appointment Date

                            </label>

                            <input class="form-control"
                                   value="@Model.AppointmentDate?.ToString("dd MMM yyyy")"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>

            <!-- Doctor Information -->

            <div class="col-lg-6 mb-4">

                <div class="card shadow border-0 h-100">

                    <div class="card-header bg-primary text-white">

                        <h5 class="mb-0">

                            <i class="fa-solid fa-user-doctor me-2"></i>

                            Doctor Information

                        </h5>

                    </div>

                    <div class="card-body text-center">

                        @if (!string.IsNullOrEmpty(Model.DoctorImage))
                        {
                            <img src="~/Department/@Model.DoctorImage"
                                 class="rounded-circle border mb-3"
                                 width="140"
                                 height="140"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/no-image.png"
                                 class="rounded-circle border mb-3"
                                 width="140"
                                 height="140"
                                 style="object-fit:cover;" />
                        }

                        <h4 class="text-primary">

                            Dr. @Model.DoctorName

                        </h4>

                        <hr />

                        <table class="table table-borderless">

                            <tr>

                                <th width="35%">

                                    Department

                                </th>

                                <td>

                                    @Model.DepartmentName

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Payment Status

                                </th>

                                <td>

                                    <span class="badge bg-success">

                                        @Model.PaymentStatus

                                    </span>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Bill Date

                                </th>

                                <td>

                                    @Model.BillDate.ToString("dd MMM yyyy")

                                </td>

                            </tr>

                        </table>

                    </div>

                </div>

            </div>

        </div>
        <!-- Billing Details -->

        <div class="card shadow border-0 mb-4">

            <div class="card-header bg-danger text-white">

                <h5 class="mb-0">

                    <i class="fa-solid fa-money-bill-wave me-2"></i>

                    Billing Details

                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Consultation Fee -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-bold">

                            Consultation Fee

                        </label>

                        <input asp-for="ConsultationFee"
                               id="ConsultationFee"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- Medicine Charge -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="MedicineCharge"
                               class="form-label fw-bold"></label>

                        <input asp-for="MedicineCharge"
                               id="MedicineCharge"
                               class="form-control amount" />

                        <span asp-validation-for="MedicineCharge"
                              class="text-danger"></span>

                    </div>

                    <!-- Lab Charge -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="LabCharge"
                               class="form-label fw-bold"></label>

                        <input asp-for="LabCharge"
                               id="LabCharge"
                               class="form-control amount" />

                        <span asp-validation-for="LabCharge"
                              class="text-danger"></span>

                    </div>

                    <!-- Other Charge -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="OtherCharge"
                               class="form-label fw-bold"></label>

                        <input asp-for="OtherCharge"
                               id="OtherCharge"
                               class="form-control amount" />

                        <span asp-validation-for="OtherCharge"
                              class="text-danger"></span>

                    </div>

                    <!-- Discount -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Discount"
                               class="form-label fw-bold"></label>

                        <input asp-for="Discount"
                               id="Discount"
                               class="form-control amount" />

                        <span asp-validation-for="Discount"
                              class="text-danger"></span>

                    </div>

                    <!-- GST -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="GSTPercentage"
                               class="form-label fw-bold">

                            GST (%)

                        </label>

                        <input asp-for="GSTPercentage"
                               id="GSTPercentage"
                               class="form-control amount" />

                        <span asp-validation-for="GSTPercentage"
                              class="text-danger"></span>

                    </div>

                    <!-- GST Amount -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">

                            GST Amount

                        </label>

                        <input asp-for="GSTAmount"
                               id="GSTAmount"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- Total Amount -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">

                            Grand Total

                        </label>

                        <input asp-for="TotalAmount"
                               id="TotalAmount"
                               class="form-control bg-success text-white fw-bold"
                               readonly />

                    </div>

                    <!-- Bill Status -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">

                            Bill Status

                        </label>

                        <select asp-for="BillStatus"
                                class="form-select">

                            <option value="Generated">

                                Generated

                            </option>

                            <option value="Cancelled">

                                Cancelled

                            </option>

                        </select>

                    </div>

                    <!-- Payment Status -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">

                            Payment Status

                        </label>

                        <select asp-for="PaymentStatus"
                                class="form-select">

                            <option value="Paid">

                                Paid

                            </option>

                            <option value="Pending">

                                Pending

                            </option>

                        </select>

                    </div>

                    <!-- Remarks -->

                    <div class="col-12 mb-3">

                        <label asp-for="Remarks"
                               class="form-label fw-bold">

                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter Remarks (Optional)"></textarea>

                    </div>

                </div>

            </div>

        </div>

        <!-- Buttons -->

        <div class="text-center mb-4">

            <button type="submit"
                    class="btn btn-success btn-lg px-5">

                <i class="fa-solid fa-file-invoice-dollar me-2"></i>

                Generate Bill

            </button>

            <a asp-action="ManageBills"
               class="btn btn-secondary btn-lg px-5 ms-2">

                <i class="fa-solid fa-arrow-left me-2"></i>

                Cancel

            </a>

        </div>

    </form>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            transition: .35s;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
            }

        .card-header {
            font-weight: 600;
        }

        .form-control,
        .form-select {
            min-height: 46px;
            border-radius: 10px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        textarea {
            resize: none;
        }

        .btn {
            border-radius: 10px;
            transition: .30s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .table th {
            width: 35%;
        }

        #TotalAmount {
            font-size: 22px;
            text-align: center;
        }

        @@media(max-width:768px) {

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function calculateBill() {

            var consultation = Number(document.getElementById("ConsultationFee").value) || 0;
            var medicine     = Number(document.getElementById("MedicineCharge").value) || 0;
            var lab          = Number(document.getElementById("LabCharge").value) || 0;
            var other        = Number(document.getElementById("OtherCharge").value) || 0;
            var discount     = Number(document.getElementById("Discount").value) || 0;
            var gst          = Number(document.getElementById("GSTPercentage").value) || 0;

            var subtotal = consultation + medicine + lab + other;

            var taxable = subtotal - discount;

            if (taxable < 0)
                taxable = 0;

            var gstAmount = taxable * gst / 100;

            var grandTotal = taxable + gstAmount;

            document.getElementById("GSTAmount").value = gstAmount.toFixed(2);
            document.getElementById("TotalAmount").value = grandTotal.toFixed(2);
        }

        document.addEventListener("DOMContentLoaded", function () {

            calculateBill();

            document.querySelectorAll(".amount").forEach(function (item) {

                item.addEventListener("keyup", calculateBill);
                item.addEventListener("input", calculateBill);
                item.addEventListener("change", calculateBill);

            });

        });

    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["Success"]'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@TempData["Error"]'
            });
        </script>
    }
}