@model IEnumerable<ClinicManagementSystem.Models.GalleryModel>

@{
    ViewData["Title"] = "Manage Gallery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="card border-0 shadow-lg mb-4">

        <div class="card-body text-white"
             style="background:linear-gradient(135deg,#0d6efd,#4f8cff);">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <h2 class="fw-bold mb-2">

                        <i class="fa-solid fa-images me-2"></i>

                        Gallery Management

                    </h2>

                    <p class="mb-0">

                        Manage clinic gallery images, categories and display order.

                    </p>

                </div>

                <div class="col-lg-4 text-end">

                    <a asp-action="AddGallery"
                       class="btn btn-light">

                        <i class="fa-solid fa-plus me-2"></i>

                        Add Gallery

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Search -->

    <div class="card border-0 shadow mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="ManageGallery">

                <div class="row">

                    <div class="col-md-5 mb-3">

                        <label class="form-label fw-bold">

                            Search Gallery

                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search Gallery Title" />

                    </div>

                    <div class="col-md-5 mb-3">

                        <label class="form-label fw-bold">

                            Category

                        </label>

                        <select name="category"
                                class="form-select">

                            <option value="">All Categories</option>

                            <option value="Reception"
                                    selected="@(ViewBag.Category=="Reception")">
                                Reception
                            </option>

                            <option value="Consultation Room"
                                    selected="@(ViewBag.Category=="Consultation Room")">
                                Consultation Room
                            </option>

                            <option value="Laboratory"
                                    selected="@(ViewBag.Category=="Laboratory")">
                                Laboratory
                            </option>

                            <option value="Pharmacy"
                                    selected="@(ViewBag.Category=="Pharmacy")">
                                Pharmacy
                            </option>

                            <option value="Medical Equipment"
                                    selected="@(ViewBag.Category=="Medical Equipment")">
                                Medical Equipment
                            </option>

                            <option value="Operation Theatre"
                                    selected="@(ViewBag.Category=="Operation Theatre")">
                                Operation Theatre
                            </option>

                            <option value="Doctors"
                                    selected="@(ViewBag.Category=="Doctors")">
                                Doctors
                            </option>

                            <option value="Staff"
                                    selected="@(ViewBag.Category=="Staff")">
                                Staff
                            </option>

                            <option value="Health Camp"
                                    selected="@(ViewBag.Category=="Health Camp")">
                                Health Camp
                            </option>

                            <option value="Events"
                                    selected="@(ViewBag.Category=="Events")">
                                Events
                            </option>

                            <option value="Clinic Building"
                                    selected="@(ViewBag.Category=="Clinic Building")">
                                Clinic Building
                            </option>

                        </select>

                    </div>

                    <div class="col-md-2 d-grid mb-3">

                        <label>&nbsp;</label>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Gallery List -->

    <div class="card border-0 shadow">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-list me-2"></i>

                Gallery List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-primary">

                        <tr>

                            <th>#</th>

                            <th>Image</th>

                            <th>Title</th>

                            <th>Category</th>

                            <th>Display Order</th>

                            <th>Status</th>

                            <th>Created Date</th>

                            <th width="220">

                                Action

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">
                                        @sr
                                    </td>

                                    <td class="text-center">

                                        @if (!string.IsNullOrEmpty(item.GalleryImage))
                                        {
                                            <img src="~/GalleryImages/@item.GalleryImage"
                                                 width="90"
                                                 height="70"
                                                 class="img-thumbnail"
                                                 style="object-fit:cover;border-radius:10px;" />
                                        }
                                        else
                                        {
                                            <img src="~/images/no-image.png"
                                                 width="90"
                                                 height="70"
                                                 class="img-thumbnail"
                                                 style="object-fit:cover;border-radius:10px;" />
                                        }

                                    </td>

                                    <td>
                                        <span class="fw-bold">
                                            @item.GalleryTitle
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.GalleryCategory
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @item.DisplayOrder
                                    </td>

                                    <td class="text-center">

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.CreatedDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-center">

                                        <!-- View -->
                                        <a asp-action="ViewGallery"
                                           asp-route-id="@item.GalleryId"
                                           class="btn btn-info btn-sm"
                                           title="View">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="EditGallery"
                                           asp-route-id="@item.GalleryId"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <!-- Status -->
                                        <a asp-action="ChangeGalleryStatus"
                                           asp-route-id="@item.GalleryId"
                                           class="btn btn-success btn-sm"
                                           title="Status">
                                            <i class="fa-solid fa-toggle-on"></i>
                                        </a>

                                        <!-- Delete -->
                                        <a href="@Url.Action("DeleteGallery", "Admin", new { id = item.GalleryId })"
                                           class="btn btn-danger btn-sm btn-delete"
                                           title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <i class="fa-solid fa-images fa-4x text-secondary mb-3"></i>

                                    <h4 class="text-muted">
                                        No Gallery Found
                                    </h4>

                                    <p class="text-muted mb-0">
                                        No gallery records are available.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

    @section Styles {

        <style>

            body {
                background: #f5f7fb;
            }

            .card {
                border: none;
                border-radius: 18px;
                overflow: hidden;
                transition: .35s;
            }

                .card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
                }

            .card-header {
                font-weight: 600;
            }

            .form-control,
            .form-select {
                min-height: 46px;
                border-radius: 10px;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
                }

            .table th {
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

            .table td {
                vertical-align: middle;
            }

            .img-thumbnail {
                transition: .35s;
                cursor: pointer;
            }

                .img-thumbnail:hover {
                    transform: scale(1.12);
                    box-shadow: 0 8px 20px rgba(0,0,0,.20);
                }

            .badge {
                font-size: 13px;
                padding: 8px 14px;
                border-radius: 30px;
            }

            .btn {
                border-radius: 8px;
                transition: .30s;
            }

                .btn:hover {
                    transform: translateY(-2px);
                }

            .table-hover tbody tr:hover {
                background: #f8fbff;
            }

            @@media(max-width:992px) {

                .table {
                    min-width: 1200px;
                }
            }

            @@media(max-width:768px) {

                h2 {
                    font-size: 24px;
                }

                .btn {
                    margin-bottom: 5px;
                }
            }

        </style>

    }

    @section Scripts {

        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        @if (TempData["Success"] != null)
        {
            <script>

                Swal.fire({

                    icon:'success',

                    title:'Success',

                    text:'@TempData["Success"]',

                    confirmButtonColor:'#198754'

                });

            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>

                Swal.fire({

                    icon:'error',

                    title:'Error',

                    text:'@TempData["Error"]',

                    confirmButtonColor:'#dc3545'

                });

            </script>
        }

    <script>

        $(function () {

            $(document).on("click", ".btn-delete", function (e) {

                e.preventDefault();

                var url = $(this).attr("href");

                Swal.fire({

                    title: "Are you sure?",

                    text: "You won't be able to recover this gallery!",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonColor: "#d33",

                    cancelButtonColor: "#3085d6",

                    confirmButtonText: "Yes, Delete It!",

                    cancelButtonText: "Cancel"

                }).then(function (result) {

                    if (result.isConfirmed) {

                        window.location.href = url;

                    }

                });

            });

        });

    </script>

    }