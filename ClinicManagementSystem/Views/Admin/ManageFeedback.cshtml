@model List<ClinicManagementSystem.Models.FeedbackModel>

@{
    ViewData["Title"] = "Manage Feedback";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="row mb-4">

        <div class="col-lg-12">

            <div class="card border-0 shadow">

                <div class="card-body bg-primary text-white rounded">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fa-solid fa-comments me-2"></i>

                                Manage Feedback

                            </h2>

                            <p class="mb-0">

                                View, reply and manage customer feedback.

                            </p>

                        </div>

                        <div>

                            <span class="badge bg-light text-dark fs-6">

                                Total :
                                <strong>@Model.Count</strong>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Success Message -->
@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
}

    <!-- Error Message -->
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fa-solid fa-circle-xmark me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
}

    <!-- Search Card -->
    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="ManageFeedback">

                <div class="row">

                    <div class="col-md-10">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search Customer / Doctor / Appointment / Subject" />

                    </div>

                    <div class="col-md-2 d-grid">

                        <button class="btn btn-primary">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Feedback Table -->

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-list me-2"></i>

                Feedback List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-primary">

                        <tr>

                            <th width="60">#</th>

                            <th>Customer</th>

                            <th>Doctor</th>

                            <th>Appointment</th>

                            <th>Department</th>

                            <th>Rating</th>

                            <th>Subject</th>

                            <th>Status</th>

                            <th>Date</th>

                            <th width="180">Action</th>

                        </tr>

                    </thead>

                    <tbody>

@{
    int sr = 1;
}
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">

                                        @sr

                                    </td>

                                    <!-- Customer -->

                                    <td>

                                        <strong>

                                            @item.CustomerName

                                        </strong>

                                    </td>

                                    <!-- Doctor -->

                                    <td>

                                        <strong>

                                            Dr. @item.DoctorName

                                        </strong>

                                    </td>

                                    <!-- Appointment -->

                                    <td>

                                        <span class="text-primary fw-bold">

                                            @item.AppointmentNo

                                        </span>

                                    </td>

                                    <!-- Department -->

                                    <td>

                                        @item.DepartmentName

                                    </td>

                                    <!-- Rating -->

                                    <td class="text-center">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <i class="fa-solid fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-star text-secondary"></i>
                                            }
                                        }

                                    <br />

                                    <small>

                                        (@item.Rating/5)

                                    </small>

                                </td>

                                <!-- Subject -->

                                <td>

                                    <strong>

                                        @item.Subject

                                    </strong>

                                    <br />

                                    <small class="text-muted">

                                        @(item.FeedbackMessage.Length > 40
                                                                            ? item.FeedbackMessage.Substring(0, 40) + "..."
                                                                            : item.FeedbackMessage)

                                </small>

                                    </td>

                                    <!-- Status -->

                                    <td class="text-center">

                                @if (item.IsApproved)
                                        {
                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-circle-check me-1"></i>

                                                Approved

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa-solid fa-clock me-1"></i>

                                                Pending

                                            </span>
                                        }

                                    </td>

                                    <!-- Date -->

                                    <td>

                                        @item.CreatedDate.ToString("dd MMM yyyy")

                                    </td>

                                    <!-- Action -->

                                    <td class="text-center">

                                        <!-- View -->

                                        <a asp-action="ViewFeedback"
                                           asp-route-id="@item.FeedbackId"
                                           class="btn btn-info btn-sm mb-1"
                                           title="View">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                        <!-- Reply -->

                                        <a asp-action="ReplyFeedback"
                                           asp-route-id="@item.FeedbackId"
                                           class="btn btn-primary btn-sm mb-1"
                                           title="Reply">

                                            <i class="fa-solid fa-reply"></i>

                                        </a>

                                        <!-- Status -->

                                        <a asp-action="ChangeFeedbackStatus"
                                           asp-route-id="@item.FeedbackId"
                                           class="btn btn-success btn-sm mb-1"
                                           title="Change Status">

                                            <i class="fa-solid fa-toggle-on"></i>

                                        </a>

                                        <!-- Delete -->

                                        <a href="@Url.Action("DeleteFeedback", "Admin", new { id = item.FeedbackId })"
                                           class="btn btn-danger btn-sm btn-delete"
                                           title="Delete">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10" class="text-center py-5">

                                    <i class="fa-solid fa-comments fa-4x text-secondary mb-3"></i>

                                    <h4 class="text-muted">

                                        No Feedback Found

                                    </h4>

                                    <p class="text-muted mb-0">

                                        No feedback records are available.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .card-header {
            font-weight: 600;
        }

        .table th {
            white-space: nowrap;
            vertical-align: middle;
            text-align: center;
        }

        .table td {
            vertical-align: middle;
        }

        .table tbody tr {
            transition: .3s;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }

        .badge {
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 13px;
        }

        .btn {
            border-radius: 8px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .fa-star {
            font-size: 15px;
        }

        .text-warning {
            color: #ffc107 !important;
        }

        .text-secondary {
            color: #ced4da !important;
        }

        .form-control {
            border-radius: 10px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        .alert {
            border-radius: 12px;
        }

        @@media(max-width:991px) {

            .table {
                min-width: 1200px;
            }
        }

        @@media(max-width:768px) {

            .btn {
                margin-bottom: 5px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function(){

            $(".btn-delete").click(function(e){

                e.preventDefault();

                var url=$(this).attr("href");

                Swal.fire({

                    title:"Delete Feedback?",

                    text:"This feedback will be deleted.",

                    icon:"warning",

                    showCancelButton:true,

                    confirmButtonColor:"#dc3545",

                    cancelButtonColor:"#6c757d",

                    confirmButtonText:"Yes, Delete",

                    cancelButtonText:"Cancel"

                }).then((result)=>{

                    if(result.isConfirmed){

                        window.location.href=url;

                    }

                });

            });

        });

    </script>

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

}