@model ClinicManagementSystem.Models.GalleryModel

@{
    ViewData["Title"] = "View Gallery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h3 class="mb-0">

                    <i class="fa-solid fa-image me-2"></i>

                    Gallery Details

                </h3>

                <a asp-action="ManageGallery"
                   class="btn btn-light">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back

                </a>

            </div>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Gallery Image -->

                <div class="col-lg-4 text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.GalleryImage))
                    {
                        <img src="~/GalleryImages/@Model.GalleryImage"
                             class="img-fluid rounded shadow"
                             style="height:350px;width:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/no-image.png"
                             class="img-fluid rounded shadow"
                             style="height:350px;width:100%;object-fit:cover;" />
                    }

                </div>

                <!-- Gallery Information -->

                <div class="col-lg-8">

                    <table class="table table-bordered table-striped">

                        <tr>

                            <th width="220">

                                Gallery Title

                            </th>

                            <td>

                                @Model.GalleryTitle

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Category

                            </th>

                            <td>

                                <span class="badge bg-info text-dark">

                                    @Model.GalleryCategory

                                </span>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Display Order

                            </th>

                            <td>

                                @Model.DisplayOrder

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6">

                                        <i class="fa-solid fa-circle-check me-1"></i>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">

                                        <i class="fa-solid fa-circle-xmark me-1"></i>

                                        Inactive

                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Description

                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    @Model.Description
                                }
                                else
                                {
                                    <span class="text-muted">

                                        No Description Available

                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Created Date

                            </th>

                            <td>

                                @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Updated Date

                            </th>

                            <td>

                                @if (Model.UpdatedDate != null)
                                {
                                    @Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">

                                        Not Updated

                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                    <div class="mt-4">

                        <a asp-action="EditGallery"
                           asp-route-id="@Model.GalleryId"
                           class="btn btn-warning">

                            <i class="fa-solid fa-pen-to-square me-2"></i>

                            Edit Gallery

                        </a>

                        <a asp-action="ManageGallery"
                           class="btn btn-secondary ms-2">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back to List

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f4f7fc;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .card-header {
            font-weight: 600;
        }

        .table th {
            width: 220px;
            background: #f8f9fa;
            vertical-align: middle;
        }

        .table td {
            vertical-align: middle;
        }

        .badge {
            padding: 8px 16px;
            font-size: 13px;
            border-radius: 30px;
        }

        img {
            transition: .35s;
            border: 5px solid #fff;
        }

            img:hover {
                transform: scale(1.04);
                box-shadow: 0 15px 35px rgba(0,0,0,.18);
            }

        .btn {
            border-radius: 10px;
            transition: .30s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        @@media(max-width:991px) {

            img {
                height: 280px !important;
            }
        }

        @@media(max-width:768px) {

            .table th {
                width: 150px;
            }

            img {
                height: 220px !important;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

    </style>

}

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

    <script>

        $(document).ready(function(){

            $("img").click(function(){

                Swal.fire({

                    imageUrl: $(this).attr("src"),

                    imageAlt: "Gallery Image",

                    showConfirmButton: false,

                    showCloseButton: true,

                    width:700

                });

            });

        });

    </script>

}