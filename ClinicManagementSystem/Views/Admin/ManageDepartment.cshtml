@model List<ClinicManagementSystem.Models.DepartmentModel>
@{
    ViewData["Title"] = "Manage Department";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa fa-building"></i> Manage Department</h3>
    <a asp-action="AddDepartment" class="btn btn-primary"><i class="fa fa-plus"></i> Add Department</a>
</div>

<form method="get" asp-action="ManageDepartment" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search Department" />
    </div>
    <div class="col-auto">
        <button class="btn btn-success">Search</button>
        <a asp-action="ManageDepartment" class="btn btn-secondary">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">Department List</div>
    <div class="card-body table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.DepartmentImage))
                                {
                                    <img src="~/Department/@item.DepartmentImage" width="60" class="rounded" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
                            <td>@item.DepartmentName</td>
                            <td>@item.DepartmentDescription</td>
                            <td>@item.DisplayOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="ViewDepartment" asp-route-id="@item.DepartmentId" class="btn btn-info btn-sm">View</a>
                                <a asp-action="EditDepartment" asp-route-id="@item.DepartmentId" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="ChangeDepartmentStatus" asp-route-id="@item.DepartmentId" class="btn btn-secondary btn-sm">Status</a>
                                <button class="btn btn-danger btn-sm" onclick="confirmDelete(@item.DepartmentId)">Delete</button>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center">No Records Found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({icon:'success',title:'Success',text:'@TempData["Success"]'});
    </script>
}

<script>
    function confirmDelete(id){
    Swal.fire({
    title:'Delete Department?',
    text:'Are you sure?',
    icon:'warning',
    showCancelButton:true
    }).then((r)=>{
    if(r.isConfirmed){
    window.location='/Admin/DeleteDepartment/'+id;
    }
    });
    }
</script>
