@model List<ClinicManagementSystem.Models.CustomerModel>
@{
    ViewData["Title"] = "Manage Patients";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa fa-users"></i> Manage Patients</h3>
</div>

<form method="get" asp-action="ManagePatient" class="row mb-3">
    <div class="col-md-5">
        <div class="input-group">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by Name, Email, or Mobile..." />
            <button class="btn btn-success" type="submit"><i class="fa fa-search"></i> Search</button>
            <a asp-action="ManagePatient" class="btn btn-secondary"><i class="fa fa-rotate"></i> Reset</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span>Patient List</span>
        <span class="badge bg-light text-primary">Total: @(Model?.Count ?? 0)</span>
    </div>
    <div class="card-body table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Profile</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Blood Group</th>
                    <th>City</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var item in Model)
                    {
                        var imgPath = !string.IsNullOrEmpty(item.ProfileImage)
                            ? Url.Content("~/Department/" + item.ProfileImage)
                            : "https://cdn-icons-png.flaticon.com/512/3135/3135715.png";

                        <tr>
                            <td>@i</td>
                            <td class="text-center">
                                <img src="@imgPath" width="45" height="45" class="rounded-circle object-fit-cover border" alt="Profile" />
                            </td>
                            <td><strong>@item.FullName</strong></td>
                            <td>@item.Gender</td>
                            <td>@item.MobileNo</td>
                            <td>@item.Email</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BloodGroup))
                                {
                                    <span class="badge bg-danger">@item.BloodGroup</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.City) ? "-" : item.City)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="ViewPatient" asp-route-id="@item.CustomerId" class="btn btn-info btn-sm text-white" title="View Patient Details">
                                    <i class="fa fa-eye"></i> View
                                </a>
                                <a asp-action="ChangePatientStatus" asp-route-id="@item.CustomerId" class="btn btn-warning btn-sm" title="Toggle Status">
                                    <i class="fa fa-toggle-on"></i> Status
                                </a>
                                <button class="btn btn-danger btn-sm" onclick="confirmDeletePatient(@item.CustomerId)" title="Delete Patient">
                                    <i class="fa fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="fa fa-user-slash fa-2x mb-2 d-block"></i> No Patients Found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({ icon: 'success', title: 'Success', text: '@TempData["Success"]' });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({ icon: 'error', title: 'Error', text: '@TempData["Error"]' });
    </script>
}

<script>
    function confirmDeletePatient(id) {
        Swal.fire({
            title: 'Delete Patient Record?',
            text: 'This action will soft delete the patient from the system.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location = '/Admin/DeletePatient/' + id;
            }
        });
    }
</script>
