@{
    var customerName = Context.Session.GetString("CustomerName") ?? "Patient Portal";
    var customerImage = Context.Session.GetString("CustomerImage");
    var customerEmail = Context.Session.GetString("CustomerEmail") ?? "";
    var avatarUrl = !string.IsNullOrEmpty(customerImage) 
        ? Url.Content("~/CustomerProfile/" + customerImage) 
        : Url.Content("https://cdn-icons-png.flaticon.com/512/3135/3135715.png");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarePoint Health Clinic</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & FontAwesome 6.5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #0284c7;
            --primary-dark: #0369a1;
            --primary-light: #e0f2fe;
            --accent-color: #0d9488;
            --dark-bg: #0f172a;
            --card-shadow: 0 10px 30px -5px rgba(2, 132, 199, 0.08);
            --hover-shadow: 0 20px 40px -10px rgba(2, 132, 199, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .customer-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--primary-color) !important;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
        }

        .navbar-brand i {
            background: linear-gradient(135deg, #0284c7, #0d9488);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            font-weight: 600;
            color: #475569;
            padding: 0.6rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--primary-color);
            background: var(--primary-light);
        }

        .user-avatar-sm {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-color);
        }

        .footer-customer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 1.5rem 0;
            color: #64748b;
            font-size: 0.9rem;
        }

        .alert-floating {
            border-radius: 12px;
            border: none;
            box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Customer Navbar -->
    <nav class="navbar navbar-expand-lg customer-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Customer" asp-action="Dashboard">
                <i class="fa-solid fa-heart-pulse fa-xl"></i>
                <span>CarePoint <small class="text-muted fw-normal fs-6">Patient Portal</small></span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCustomer">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarCustomer">
                @if (Context.Session.GetString("CustomerId") != null)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="Dashboard">
                                <i class="fa-solid fa-chart-line me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="Doctors">
                                <i class="fa-solid fa-user-doctor me-1"></i> Doctors
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="MyAppointments">
                                <i class="fa-solid fa-calendar-check me-1"></i> My Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Customer"
                               asp-action="MyPrescriptions"
                               class="nav-link">

                                <i class="fa-solid fa-file-prescription"></i>

                                My Prescriptions

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "HealthTips" ? "active" : "")"
                               asp-controller="Customer"
                               asp-action="HealthTips">

                                <i class="fa-solid fa-book-medical me-2"></i>

                                Health Tips

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active"
                               asp-controller="Customer"
                               asp-action="Gallery">

                                <i class="fa-solid fa-images me-1"></i>

                                Gallery

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Customer"
                               asp-action="Contact">

                                <i class="fa-solid fa-envelope me-1"></i>

                                Contact Us

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="EditProfile">
                                <i class="fa-solid fa-user-pen me-1"></i> My Profile
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarUrl" alt="Avatar" class="user-avatar-sm" />
                                <div class="d-none d-sm-block text-start">
                                    <div class="fw-bold text-dark fs-7 me-1" style="font-size: 0.9rem;">@customerName</div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">@customerEmail</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Customer" asp-action="Dashboard">
                                        <i class="fa-solid fa-grip me-2 text-primary"></i> Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Customer" asp-action="EditProfile">
                                        <i class="fa-solid fa-user-gear me-2 text-info"></i> Edit Profile
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Customer" asp-action="MyBills">
                                        <i class="fa-solid fa-file-invoice-dollar me-2"></i> My Bills
                                    </a>
                                </li>
                                
                               
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Customer" asp-action="Logout">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ms-auto d-flex gap-2">
                        <a class="btn btn-outline-primary px-4 rounded-pill fw-semibold" asp-controller="Customer" asp-action="Login">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                        </a>
                        <a class="btn btn-primary px-4 rounded-pill fw-semibold text-white shadow-sm" asp-controller="Customer" asp-action="Register">
                            <i class="fa-solid fa-user-plus me-1"></i> Register
                        </a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <!-- Main Body Container -->
    <main class="flex-grow-1 py-4">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show alert-floating d-flex align-items-center mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2 fa-lg"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show alert-floating d-flex align-items-center mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2 fa-lg"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Customer Footer -->
    <footer class="footer-customer text-center">
        <div class="container">
            <p class="mb-0">
                &copy; @DateTime.Now.Year CarePoint Clinic Management System. All rights reserved. 
                <span class="text-muted mx-2">|</span> 
                <i class="fa-solid fa-shield-halved text-success me-1"></i> Secure Patient Data Portal
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
