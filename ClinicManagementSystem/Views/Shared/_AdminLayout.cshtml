@{
    var adminName = Context.Session.GetString("FullName") ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Clinic Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f4f7fb;
            margin: 0;
            font-family: 'Segoe UI',sans-serif
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #0d6efd;
            color: #fff;
            overflow-y: auto;
        }

        .brand {
            padding: 20px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            border-bottom: 1px solid rgba(255,255,255,.15);
        }

        .sidebar a {
            color: #fff;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            transition: .3s;
        }

            .sidebar a:hover, .sidebar a.active {
                background: rgba(255,255,255,.15);
            }

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            background: #fff;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        .content {
            padding: 25px;
        }

        .footer {
            text-align: center;
            padding: 15px;
            color: #777;
            background: #fff;
            border-top: 1px solid #eee;
        }
        @@media(max - width:768px) {
            .sidebar

        {
            position: relative;
            width: 100%;
            height: auto
        }

        .main {
            margin-left: 0
        }

        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="brand">
            <i class="fas fa-hospital-user"></i><br />
            Clinic Admin
        </div>

        <a asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-gauge"></i> Dashboard</a>
        <a asp-controller="Admin" asp-action="ManageDepartment">
            <i class="fas fa-building"></i> Department
        </a>
       
        <a asp-controller="Admin" asp-action="ManageDoctor">
            <i class="fas fa-user-doctor"></i> Doctor
        </a>
        <a asp-controller="Admin" asp-action="ManagePatient"><i class="fas fa-users"></i> Patient</a>
        <a asp-controller="Admin" asp-action="ManageAppointment"><i class="fas fa-calendar-check"></i> Appointment</a>
        <a href="#"><i class="fas fa-file-prescription"></i> Prescription</a>
        <a href="#"><i class="fas fa-capsules"></i> Medicine</a>
        <a href="#"><i class="fas fa-file-invoice-dollar"></i> Billing</a>
        <a href="#"><i class="fas fa-image"></i> Gallery</a>
        <a href="#"><i class="fas fa-images"></i> Banner</a>
        <a href="#"><i class="fas fa-star"></i> Feedback</a>
        <a href="#"><i class="fas fa-envelope"></i> Contact Inquiry</a>
        <a asp-controller="Admin" asp-action="Logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
    </div>

    <div class="main">
        <div class="topbar">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <div>
                <i class="fas fa-user-circle"></i>
                <strong>@adminName</strong>
            </div>
        </div>

        <div class="content">
            @RenderBody()
        </div>

        <div class="footer">
            © @DateTime.Now.Year Clinic Management System | All Rights Reserved.
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
