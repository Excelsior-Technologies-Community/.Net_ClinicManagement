@model List<ClinicManagementSystem.Models.HospitalHolidayModel>

@{
    ViewData["Title"] = "Hospital Holidays";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">

    <!-- Page Header -->

    <div class="row mb-4">

        <div class="col-lg-12">

            <div class="card border-0 shadow">

                <div class="card-body text-white rounded"
                     style="background:linear-gradient(135deg,#0d6efd,#4f46e5);">

                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                        <div>

                            <h2 class="fw-bold mb-2">

                                <i class="fa-solid fa-calendar-days me-2"></i>

                                Hospital Holidays

                            </h2>

                            <p class="mb-0">

                                View upcoming hospital holidays before booking your appointment.

                            </p>

                        </div>

                        <div class="text-center">

                            <i class="fa-solid fa-hospital display-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Search -->

    <div class="card border-0 shadow mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="HospitalHolidays">

                <div class="row align-items-end">

                    <div class="col-md-10 mb-3">

                        <label class="form-label fw-bold">

                            Search Holiday

                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by Holiday Title..." />

                    </div>

                    <div class="col-md-2 mb-3 d-grid">

                        <button class="btn btn-primary">

                            <i class="fa-solid fa-search me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Holiday List -->

    <div class="row">

        @foreach (var item in Model)
        {

            <div class="col-lg-6 mb-4">

                <div class="card holiday-card h-100 border-0 shadow">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="badge bg-danger px-3 py-2">

                                <i class="fa-solid fa-calendar-day me-1"></i>

                                Holiday

                            </span>

                            <span class="text-primary fw-bold">

                                @item.HolidayDate.ToString("dd MMM yyyy")

                            </span>

                        </div>

                        <h4 class="fw-bold text-dark">

                            @item.HolidayTitle

                        </h4>

                        <hr />

                        <p class="text-muted mb-0">
                            @if (!string.IsNullOrWhiteSpace(item.HolidayDescription))
                            {
                                @item.HolidayDescription
                            }
                            else
                            {
                                <span class="text-muted">

                                    No description available.

                                </span>
                            }

                        </p>

                        <hr />

                        @{
                            int daysLeft = (item.HolidayDate.Date - DateTime.Today).Days;
                        }

                        <div class="d-flex justify-content-between align-items-center">

                            @if (daysLeft == 0)
                            {
                                <span class="badge bg-danger fs-6">

                                    <i class="fa-solid fa-circle-exclamation me-1"></i>

                                    Today

                                </span>
                            }
                            else if (daysLeft == 1)
                            {
                                <span class="badge bg-warning text-dark fs-6">

                                    <i class="fa-solid fa-clock me-1"></i>

                                    Tomorrow

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success fs-6">

                                    <i class="fa-solid fa-hourglass-half me-1"></i>

                                    @daysLeft Days Left

                                </span>
                            }

                            <span class="text-secondary">

                                <i class="fa-solid fa-hospital me-1"></i>

                                Hospital Closed

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        }

        @if (Model.Count == 0)
        {
            <div class="col-12">

                <div class="card shadow border-0">

                    <div class="card-body text-center py-5">

                        <i class="fa-solid fa-calendar-check text-success display-1 mb-3"></i>

                        <h3 class="fw-bold">

                            No Upcoming Holidays

                        </h3>

                        <p class="text-muted mb-0">

                            There are currently no upcoming hospital holidays.

                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
@section Styles {

    <style>

        body {
            background: #f5f7fb;
        }

        .holiday-card {
            border-radius: 18px;
            overflow: hidden;
            transition: .35s;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
        }

            .holiday-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 18px 40px rgba(13,110,253,.20);
            }

        .card {
            border: none;
            border-radius: 18px;
        }

        .form-control {
            border-radius: 10px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
            }

        .badge {
            border-radius: 30px;
            padding: 8px 16px;
            font-size: 13px;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .card h4 {
            color: #0d6efd;
        }

        .card p {
            text-align: justify;
            line-height: 1.7;
        }

        .display-1 {
            color: #198754;
        }

        .shadow {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
        }

        @@media(max-width:992px) {

            .holiday-card {
                margin-bottom: 20px;
            }
        }

        @@media(max-width:768px) {

            h2 {
                font-size: 28px;
            }

            .display-4 {
                display: none;
            }

            .btn {
                width: 100%;
            }
        }

        @@media(max-width:576px) {

            h2 {
                font-size: 24px;
            }

            .badge {
                font-size: 12px;
            }

            .holiday-card {
                border-radius: 15px;
            }
        }

    </style>

}

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

            });

        </script>
    }

    <script>

        $(document).ready(function(){

            $(".holiday-card").hide().each(function(index){

                $(this).delay(index * 150).fadeIn(500);

            });

        });

    </script>

}