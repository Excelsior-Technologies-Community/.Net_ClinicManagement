@model List<ClinicManagementSystem.Models.CampRegistrationModel>

@{
    ViewData["Title"] = "My Medical Camp Registrations";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4 my-camp-page">

    <!-- =========================================
         Page Header
    ========================================== -->

    <div class="my-camp-header mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="header-badge">

                    <i class="fa-solid fa-calendar-check me-2"></i>

                    My Healthcare Activities

                </span>

                <h1 class="fw-bold mt-3 mb-2">

                    My Medical Camp Registrations

                </h1>

                <p class="mb-0">

                    View and manage all your registered medical camps
                    in one place.

                </p>

            </div>

            <div class="col-lg-4 text-lg-end d-none d-lg-block">

                <i class="fa-solid fa-clipboard-user header-icon"></i>

            </div>

        </div>

    </div>


    <!-- =========================================
         Summary
    ========================================== -->

    <div class="row g-3 mb-4">

        <!-- Total -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-icon total-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div>

                    <small>Total Registrations</small>

                    <h3 class="mb-0 fw-bold">

                        @(Model?.Count ?? 0)

                    </h3>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-icon pending-icon">

                    <i class="fa-solid fa-hourglass-half"></i>

                </div>

                <div>

                    <small>Pending</small>

                    <h3 class="mb-0 fw-bold">

                        @(Model?.Count(x =>
                            x.RegistrationStatus == "Pending") ?? 0)

                    </h3>

                </div>

            </div>

        </div>


        <!-- Confirmed -->

        <div class="col-md-4">

            <div class="summary-card">

                <div class="summary-icon confirmed-icon">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <small>Confirmed</small>

                    <h3 class="mb-0 fw-bold">

                        @(Model?.Count(x =>
                            x.RegistrationStatus == "Confirmed") ?? 0)

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Section Heading
    ========================================== -->

    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <div>

            <h4 class="fw-bold mb-1">

                Your Registrations

            </h4>

            <p class="text-muted mb-0">

                Your latest medical camp registration details.

            </p>

        </div>

        <a asp-action="MedicalCamps"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-2"></i>

            Explore Camps

        </a>

    </div>


    <!-- =========================================
         Registration Cards
    ========================================== -->

    <div class="row g-4">

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <div class="col-xl-6">

                    <div class="registration-card h-100">

                        <!-- =================================
                             Camp Image
                        ================================== -->

                        <div class="registration-image">

                            @if (!string.IsNullOrWhiteSpace(item.CampImage))
                            {
                                <img src="~/MedicalCamp/@item.CampImage"
                                     alt="@item.CampTitle" />
                            }
                            else
                            {
                                <div class="registration-placeholder">

                                    <i class="fa-solid fa-kit-medical"></i>

                                </div>
                            }


                            <!-- Registration Status -->

                            @if (item.RegistrationStatus == "Confirmed")
                            {
                                <span class="status-badge confirmed">

                                    <i class="fa-solid fa-circle-check me-1"></i>

                                    Confirmed

                                </span>
                            }
                            else if (item.RegistrationStatus == "Pending")
                            {
                                <span class="status-badge pending">

                                    <i class="fa-solid fa-clock me-1"></i>

                                    Pending

                                </span>
                            }
                            else if (item.RegistrationStatus == "Cancelled")
                            {
                                <span class="status-badge cancelled">

                                    <i class="fa-solid fa-circle-xmark me-1"></i>

                                    Cancelled

                                </span>
                            }
                            else if (item.RegistrationStatus == "Completed")
                            {
                                <span class="status-badge completed">

                                    <i class="fa-solid fa-check-double me-1"></i>

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="status-badge pending">

                                    @item.RegistrationStatus

                                </span>
                            }


                            <!-- Camp Date -->

                            <div class="camp-date-badge">

                                <strong>

                                    @item.CampDate?.ToString("dd")

                                </strong>

                                <span>

                                    @item.CampDate?.ToString("MMM")

                                </span>

                            </div>

                        </div>


                        <!-- =================================
                             Card Body
                        ================================== -->

                        <div class="registration-body">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        gap-3">

                                <div>

                                    <span class="camp-label">

                                        Medical Camp

                                    </span>

                                    <h4 class="camp-title mt-1">

                                        @item.CampTitle

                                    </h4>

                                </div>

                                <span class="registration-no">

                                    @item.RegistrationNo

                                </span>

                            </div>


                            <!-- Doctor -->

                            <div class="registration-info">

                                <div class="info-icon doctor">

                                    <i class="fa-solid fa-user-doctor"></i>

                                </div>

                                <div>

                                    <small>Medical Specialist</small>

                                    <strong>

                                        @item.DoctorName

                                    </strong>

                                </div>

                            </div>


                            <!-- Department -->

                            <div class="registration-info">

                                <div class="info-icon department">

                                    <i class="fa-solid fa-building"></i>

                                </div>

                                <div>

                                    <small>Department</small>

                                    <strong>

                                        @item.DepartmentName

                                    </strong>

                                </div>

                            </div>


                            <!-- Date & Time -->

                            <div class="registration-info">

                                <div class="info-icon date">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </div>

                                <div>

                                    <small>Camp Date & Time</small>

                                    <strong>

                                        @item.CampDate?.ToString("dd MMM yyyy")

                                        @if (item.StartTime.HasValue)
                                        {
                                            <text>
                                                •
                                                @item.StartTime.Value.ToString(@"hh\:mm")
                                            </text>
                                        }

                                    </strong>

                                </div>

                            </div>


                            <!-- Venue -->

                            <div class="registration-info mb-0">

                                <div class="info-icon location">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>

                                <div>

                                    <small>Venue</small>

                                    <strong>

                                        @item.Venue

                                    </strong>

                                </div>

                            </div>
                            <!-- =================================
                                 Participant Information
                            ================================== -->

                            <div class="participant-box mt-4">

                                <div class="participant-heading">

                                    <i class="fa-solid fa-user"></i>

                                    <span>
                                        Participant
                                    </span>

                                </div>

                                <div class="participant-details">

                                    <div>

                                        <small>Name</small>

                                        <strong>
                                            @item.ParticipantName
                                        </strong>

                                    </div>

                                    <div>

                                        <small>Mobile</small>

                                        <strong>
                                            @item.MobileNo
                                        </strong>

                                    </div>

                                    <div>

                                        <small>Age / Gender</small>

                                        <strong>

                                            @item.Age
                                            /
                                            @item.Gender

                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 Registration & Payment
                            ================================== -->

                            <div class="payment-row mt-3">

                                <!-- Registration Date -->

                                <div class="payment-item">

                                    <small>

                                        Registration Date

                                    </small>

                                    <strong>

                                        @item.RegistrationDate.ToString("dd MMM yyyy")

                                    </strong>

                                </div>


                                <!-- Amount -->

                                <div class="payment-item">

                                    <small>

                                        Amount

                                    </small>

                                    @if (item.Amount == 0)
                                    {
                                        <strong class="text-success">

                                            Free

                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>

                                            ₹ @item.Amount.ToString("N2")

                                        </strong>
                                    }

                                </div>


                                <!-- Payment Status -->

                                <div class="payment-item">

                                    <small>

                                        Payment

                                    </small>

                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="payment-badge paid">

                                            <i class="fa-solid fa-circle-check me-1"></i>

                                            Paid

                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Pending")
                                    {
                                        <span class="payment-badge pending">

                                            <i class="fa-solid fa-clock me-1"></i>

                                            Pending

                                        </span>
                                    }
                                    else if (item.PaymentStatus == "NotRequired")
                                    {
                                        <span class="payment-badge free">

                                            <i class="fa-solid fa-check me-1"></i>

                                            Not Required

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="payment-badge">

                                            @item.PaymentStatus

                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- =================================
                                 Admin Remark
                            ================================== -->
                            @if (!string.IsNullOrWhiteSpace(item.AdminRemark))
                            {
                                <div class="admin-remark mt-3">

                                    <div class="remark-icon">

                                        <i class="fa-solid fa-message"></i>

                                    </div>

                                    <div>

                                        <small>

                                            Hospital Remark

                                        </small>

                                        <p class="mb-0">

                                            @item.AdminRemark

                                        </p>

                                    </div>

                                </div>
                            }


                            <!-- =================================
                                 Card Actions
                            ================================== -->

                            <div class="registration-actions mt-4">

                                <a asp-action="CampRegistrationDetails"
                                   asp-route-id="@item.CampRegistrationId"
                                   class="btn btn-outline-primary">

                                    <i class="fa-solid fa-eye me-1"></i>

                                    View Details

                                </a>
                                <a asp-action="PrintCampRegistration"
                                   asp-route-id="@item.CampRegistrationId"
                                   target="_blank"
                                   class="btn btn-outline-success">

                                    <i class="fa-solid fa-print me-1"></i>

                                    Print
                                </a>

                                @if (item.RegistrationStatus == "Pending" ||
                                                        item.RegistrationStatus == "Confirmed")
                                {
                                    @if (item.CampDate.HasValue &&
                                                            item.CampDate.Value.Date >= DateTime.Today)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger cancel-registration-btn"
                                                data-id="@item.CampRegistrationId"
                                                data-registration="@item.RegistrationNo">

                                            <i class="fa-solid fa-ban me-1"></i>

                                            Cancel Registration

                                        </button>
                                    }
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        }
        else
        {
            <!-- =================================
                 Empty State
            ================================== -->

            <div class="col-12">

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h3 class="fw-bold mt-4">

                        No Medical Camp Registrations

                    </h3>

                    <p class="text-muted">

                        You haven't registered for any medical camp yet.
                        Explore our upcoming camps and reserve your seat.

                    </p>

                    <a asp-action="MedicalCamps"
                       class="btn btn-primary mt-2">

                        <i class="fa-solid fa-magnifying-glass me-2"></i>

                        Explore Medical Camps

                    </a>

                </div>

            </div>
        }

    </div>

</div>
@section Styles {

<style>

body{
    background:#f5f8fc;
}


/* =========================================
   Main Page
========================================= */

.my-camp-page{
    max-width:1400px;
}


/* =========================================
   Header
========================================= */

.my-camp-header{
    position:relative;
    overflow:hidden;
    padding:40px;
    border-radius:24px;
    color:#fff;
    background:linear-gradient(
        135deg,
        #0d6efd,
        #2563eb,
        #0ea5e9
    );
    box-shadow:0 15px 35px rgba(13,110,253,.18);
}

.my-camp-header::before{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    border-radius:50%;
    right:-90px;
    top:-120px;
    background:rgba(255,255,255,.08);
}

.my-camp-header::after{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    border-radius:50%;
    left:45%;
    bottom:-120px;
    background:rgba(255,255,255,.06);
}

.header-badge{
    position:relative;
    z-index:2;
    display:inline-block;
    padding:8px 15px;
    border-radius:25px;
    background:rgba(255,255,255,.15);
    border:1px solid rgba(255,255,255,.2);
    font-size:12px;
    font-weight:600;
}

.my-camp-header h1,
.my-camp-header p{
    position:relative;
    z-index:2;
}

.my-camp-header h1{
    font-size:38px;
}

.my-camp-header p{
    opacity:.9;
    max-width:700px;
}

.header-icon{
    position:relative;
    z-index:2;
    font-size:100px;
    opacity:.15;
}


/* =========================================
   Summary Cards
========================================= */

.summary-card{
    background:#fff;
    border:1px solid #edf0f5;
    border-radius:16px;
    padding:18px 20px;
    display:flex;
    align-items:center;
    gap:15px;
    box-shadow:0 7px 20px rgba(0,0,0,.05);
    transition:.25s ease;
}

.summary-card:hover{
    transform:translateY(-3px);
    box-shadow:0 12px 28px rgba(0,0,0,.08);
}

.summary-card small{
    display:block;
    color:#8a94a6;
    font-size:11px;
    margin-bottom:3px;
}

.summary-card h3{
    color:#263143;
}

.summary-icon{
    width:50px;
    height:50px;
    min-width:50px;
    border-radius:13px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:20px;
}

.total-icon{
    background:#eaf2ff;
    color:#0d6efd;
}

.pending-icon{
    background:#fff6df;
    color:#f59e0b;
}

.confirmed-icon{
    background:#eaf8f0;
    color:#198754;
}


/* =========================================
   Registration Card
========================================= */

.registration-card{
    background:#fff;
    border:1px solid #edf0f5;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,.06);
    transition:.3s ease;
}

.registration-card:hover{
    transform:translateY(-5px);
    box-shadow:0 17px 38px rgba(0,0,0,.10);
}


/* =========================================
   Image
========================================= */

.registration-image{
    height:220px;
    position:relative;
    overflow:hidden;
    background:#eef3f8;
}

.registration-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .5s ease;
}

.registration-card:hover .registration-image img{
    transform:scale(1.05);
}

.registration-placeholder{
    width:100%;
    height:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#0d6efd;
    font-size:65px;
    background:#eef5ff;
}


/* =========================================
   Registration Status
========================================= */

.status-badge{
    position:absolute;
    top:15px;
    left:15px;
    padding:7px 12px;
    border-radius:20px;
    font-size:11px;
    font-weight:700;
    box-shadow:0 4px 12px rgba(0,0,0,.12);
}

.status-badge.confirmed{
    color:#198754;
    background:#eaf8f0;
}

.status-badge.pending{
    color:#9a6700;
    background:#fff4d6;
}

.status-badge.cancelled{
    color:#dc3545;
    background:#fff0f1;
}

.status-badge.completed{
    color:#0d6efd;
    background:#eaf2ff;
}


/* =========================================
   Camp Date
========================================= */

.camp-date-badge{
    position:absolute;
    right:15px;
    bottom:15px;
    width:58px;
    height:62px;
    border-radius:12px;
    background:#fff;
    color:#0d6efd;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.camp-date-badge strong{
    font-size:21px;
    line-height:1;
}

.camp-date-badge span{
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    margin-top:4px;
}


/* =========================================
   Card Body
========================================= */

.registration-body{
    padding:22px;
}

.camp-label{
    color:#0d6efd;
    font-size:10px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.4px;
}

.camp-title{
    color:#172033;
    font-size:19px;
    font-weight:700;
    line-height:1.4;
}

.registration-no{
    flex-shrink:0;
    color:#6c757d;
    background:#f4f6f9;
    padding:6px 9px;
    border-radius:7px;
    font-size:10px;
    font-weight:600;
}


/* =========================================
   Registration Info
========================================= */

.registration-info{
    display:flex;
    align-items:center;
    gap:12px;
    margin-top:15px;
}

.info-icon{
    width:40px;
    height:40px;
    min-width:40px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.info-icon.doctor{
    color:#7c3aed;
    background:#f1eaff;
}

.info-icon.department{
    color:#0891b2;
    background:#e6f9fc;
}

.info-icon.date{
    color:#0d6efd;
    background:#eaf2ff;
}

.info-icon.location{
    color:#dc3545;
    background:#fff0f1;
}

.registration-info small{
    display:block;
    color:#8a94a6;
    font-size:10px;
    margin-bottom:2px;
}

.registration-info strong{
    display:block;
    color:#343b4a;
    font-size:13px;
}


/* =========================================
   Participant Box
========================================= */

.participant-box{
    padding:15px;
    border-radius:12px;
    background:#f8fafc;
    border:1px solid #edf0f5;
}

.participant-heading{
    display:flex;
    align-items:center;
    gap:8px;
    color:#0d6efd;
    font-size:12px;
    font-weight:700;
    margin-bottom:12px;
}

.participant-heading i{
    width:30px;
    height:30px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:8px;
    background:#eaf2ff;
}

.participant-details{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:10px;
}

.participant-details small{
    display:block;
    color:#8a94a6;
    font-size:9px;
    margin-bottom:3px;
}

.participant-details strong{
    display:block;
    color:#343b4a;
    font-size:11px;
    word-break:break-word;
}


/* =========================================
   Payment Row
========================================= */

.payment-row{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:10px;
}

.payment-item{
    padding:12px;
    border-radius:10px;
    background:#fff;
    border:1px solid #edf0f5;
}

.payment-item small{
    display:block;
    color:#8a94a6;
    font-size:9px;
    margin-bottom:4px;
}

.payment-item strong{
    display:block;
    color:#343b4a;
    font-size:12px;
}


/* =========================================
   Payment Badges
========================================= */

.payment-badge{
    display:inline-block;
    padding:5px 8px;
    border-radius:15px;
    font-size:9px;
    font-weight:700;
}

.payment-badge.paid{
    color:#198754;
    background:#eaf8f0;
}

.payment-badge.pending{
    color:#9a6700;
    background:#fff4d6;
}

.payment-badge.free{
    color:#198754;
    background:#eaf8f0;
}


/* =========================================
   Admin Remark
========================================= */

.admin-remark{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:12px;
    border-radius:10px;
    background:#eef5ff;
    border:1px solid #dceaff;
}

.remark-icon{
    width:34px;
    height:34px;
    min-width:34px;
    border-radius:8px;
    background:#e0ecff;
    color:#0d6efd;
    display:flex;
    align-items:center;
    justify-content:center;
}

.admin-remark small{
    display:block;
    color:#6c757d;
    font-size:9px;
    margin-bottom:3px;
}

.admin-remark p{
    color:#343b4a;
    font-size:11px;
    line-height:1.5;
}


/* =========================================
   Actions
========================================= */

.registration-actions{
    display:flex;
    gap:9px;
}

.registration-actions .btn{
    flex:1;
    border-radius:9px;
    padding:10px 8px;
    font-size:11px;
    font-weight:600;
    transition:.25s ease;
}

.registration-actions .btn:hover{
    transform:translateY(-2px);
}


/* =========================================
   Empty State
========================================= */

.empty-state{
    background:#fff;
    border:1px solid #edf0f5;
    border-radius:20px;
    padding:70px 30px;
    text-align:center;
    box-shadow:0 8px 25px rgba(0,0,0,.05);
}

.empty-icon{
    width:90px;
    height:90px;
    margin:auto;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#eef5ff;
    color:#0d6efd;
    font-size:38px;
}

.empty-state h3{
    color:#263143;
}


/* =========================================
   Buttons
========================================= */

.btn{
    transition:.25s ease;
}

.btn:hover{
    transform:translateY(-2px);
}


/* =========================================
   Responsive
========================================= */

@@media(max-width:991px){

    .my-camp-header{
        padding:32px;
    }

    .my-camp-header h1{
        font-size:32px;
    }

}


@@media(max-width:767px){

    .my-camp-page{
        padding-left:12px;
        padding-right:12px;
    }

    .my-camp-header{
        padding:25px;
        border-radius:18px;
    }

    .my-camp-header h1{
        font-size:27px;
    }

    .registration-image{
        height:210px;
    }

    .participant-details{
        grid-template-columns:1fr;
    }

    .payment-row{
        grid-template-columns:1fr;
    }

    .registration-actions{
        flex-direction:column;
    }

    .registration-actions .btn{
        width:100%;
    }

}


