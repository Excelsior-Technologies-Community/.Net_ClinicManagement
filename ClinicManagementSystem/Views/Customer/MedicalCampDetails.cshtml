@model ClinicManagementSystem.Models.MedicalCampModel

@{
    ViewData["Title"] = "Medical Camp Details";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4 camp-details-page">

    <!-- =========================================
         Hero Banner
    ========================================== -->

    <div class="camp-hero mb-4">

        @if (!string.IsNullOrWhiteSpace(Model.CampBanner))
        {
            <img src="~/MedicalCamp/@Model.CampBanner"
                 class="camp-hero-image"
                 alt="@Model.CampTitle" />
        }
        else if (!string.IsNullOrWhiteSpace(Model.CampImage))
        {
            <img src="~/MedicalCamp/@Model.CampImage"
                 class="camp-hero-image"
                 alt="@Model.CampTitle" />
        }
        else
        {
            <div class="camp-hero-placeholder">

                <i class="fa-solid fa-kit-medical"></i>

            </div>
        }

        <div class="camp-hero-overlay">

            <div class="hero-content">

                @if (Model.IsFeatured)
                {
                    <span class="featured-badge">

                        <i class="fa-solid fa-star me-1"></i>

                        Featured Medical Camp

                    </span>
                }

                <h1>

                    @Model.CampTitle

                </h1>

                <p>

                    <i class="fa-solid fa-location-dot me-2"></i>

                    @Model.Venue

                </p>

            </div>

        </div>

    </div>


    <!-- =========================================
         Back Button
    ========================================== -->

    <div class="mb-4">

        <a asp-action="MedicalCamps"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-2"></i>

            Back to Medical Camps

        </a>

    </div>


    <div class="row g-4">


        <!-- =========================================
             Left Side - Camp Image
        ========================================== -->

        <div class="col-lg-4">

            <div class="card camp-image-card border-0 shadow-sm h-100">

                <div class="card-body p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.CampImage))
                    {
                        <img src="~/MedicalCamp/@Model.CampImage"
                             class="camp-main-image"
                             alt="@Model.CampTitle" />
                    }
                    else
                    {
                        <div class="camp-image-placeholder">

                            <i class="fa-solid fa-image"></i>

                            <span>

                                No Image Available

                            </span>

                        </div>
                    }

                    <!-- Availability -->

                    <div class="availability-box mt-3">

                        @if (Model.AvailableSeats > 0)
                        {
                            <div class="available-status">

                                <span class="status-dot"></span>

                                <div>

                                    <strong>

                                        Registration Available

                                    </strong>

                                    <small>

                                        @Model.AvailableSeats seats remaining

                                    </small>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="full-status">

                                <span class="status-dot"></span>

                                <div>

                                    <strong>

                                        Registration Full

                                    </strong>

                                    <small>

                                        No seats currently available

                                    </small>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             Right Side - Basic Information
        ========================================== -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start flex-wrap mb-4">

                        <div>

                            <span class="text-primary fw-semibold">

                                Medical Camp

                            </span>

                            <h2 class="fw-bold mt-1 mb-0">

                                @Model.CampTitle

                            </h2>

                        </div>

                        <!-- Registration Fee -->

                        <div class="fee-box mt-2 mt-md-0">

                            <small>

                                Registration Fee

                            </small>

                            @if (Model.RegistrationFee == 0)
                            {
                                <strong class="text-success">

                                    Free

                                </strong>
                            }
                            else
                            {
                                <strong>

                                    ₹ @Model.RegistrationFee.ToString("N0")

                                </strong>
                            }

                        </div>

                    </div>


                    <!-- Information Grid -->

                    <div class="row g-3">


                        <!-- Date -->

                        <div class="col-md-6">

                            <div class="detail-item">

                                <div class="detail-icon date-icon">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </div>

                                <div>

                                    <small>

                                        Camp Date

                                    </small>

                                    <strong>

                                        @Model.CampDate?.ToString("dd MMMM yyyy")

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Time -->

                        <div class="col-md-6">

                            <div class="detail-item">

                                <div class="detail-icon time-icon">

                                    <i class="fa-solid fa-clock"></i>

                                </div>

                                <div>

                                    <small>

                                        Camp Time

                                    </small>

                                    <strong>

                                        @Model.StartTime?.ToString(@"hh\:mm")
                                        -
                                        @Model.EndTime?.ToString(@"hh\:mm")

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Doctor -->

                        <div class="col-md-6">

                            <div class="detail-item">

                                <div class="detail-icon doctor-icon">

                                    <i class="fa-solid fa-user-doctor"></i>

                                </div>

                                <div>

                                    <small>

                                        Medical Specialist

                                    </small>

                                    <strong>

                                        @Model.DoctorName

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Department -->

                        <div class="col-md-6">

                            <div class="detail-item">

                                <div class="detail-icon department-icon">

                                    <i class="fa-solid fa-building"></i>

                                </div>

                                <div>

                                    <small>

                                        Department

                                    </small>

                                    <strong>

                                        @Model.DepartmentName

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Venue -->

                        <div class="col-12">

                            <div class="detail-item">

                                <div class="detail-icon location-icon">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>

                                <div>

                                    <small>

                                        Camp Venue

                                    </small>

                                    <strong>

                                        @Model.Venue

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- Organizer -->
                        @if (!string.IsNullOrWhiteSpace(Model.Organizer))
                        {
                            <div class="col-12">

                                <div class="detail-item">

                                    <div class="detail-icon organizer-icon">

                                        <i class="fa-solid fa-user-tie"></i>

                                    </div>

                                    <div>

                                        <small>

                                            Organized By

                                        </small>

                                        <strong>

                                            @Model.Organizer

                                        </strong>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>


                    <!-- Seats Information -->

                    <div class="seat-summary mt-4">

                        <div>

                            <small>

                                Available Seats

                            </small>

                            <h4 class="fw-bold mb-0">

                                @Model.AvailableSeats

                            </h4>

                        </div>

                        <div class="seat-divider"></div>

                        <div>

                            <small>

                                Total Capacity

                            </small>

                            <h4 class="fw-bold mb-0">

                                @Model.MaxParticipants

                            </h4>

                        </div>

                        <div class="seat-icon">

                            <i class="fa-solid fa-users"></i>

                        </div>

                    </div>
                    <!-- =========================================
                         About Medical Camp
                    ========================================== -->

                    <div class="camp-section mt-4">

                        <h4 class="section-title">

                            <i class="fa-solid fa-circle-info me-2"></i>

                            About This Medical Camp

                        </h4>

                        @if (!string.IsNullOrWhiteSpace(Model.CampDescription))
                        {
                            <p class="section-text">

                                @Model.CampDescription

                            </p>
                        }
                        else
                        {
                            <p class="text-muted">

                                No description available for this medical camp.

                            </p>
                        }

                    </div>


                    <!-- =========================================
                         Benefits & Instructions
                    ========================================== -->

                    <div class="row g-4 mt-1">

                        <!-- Benefits -->

                        <div class="col-md-6">

                            <div class="content-box benefits-box">

                                <h5 class="fw-bold">

                                    <i class="fa-solid fa-circle-check me-2"></i>

                                    Camp Benefits

                                </h5>

                                @if (!string.IsNullOrWhiteSpace(Model.Benefits))
                                {
                                    <div class="content-text">

                                        @Model.Benefits

                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">

                                        Benefits information is not available.

                                    </p>
                                }

                            </div>

                        </div>


                        <!-- Instructions -->

                        <div class="col-md-6">

                            <div class="content-box instructions-box">

                                <h5 class="fw-bold">

                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>

                                    Important Instructions

                                </h5>

                                @if (!string.IsNullOrWhiteSpace(Model.Instructions))
                                {
                                    <div class="content-text">

                                        @Model.Instructions

                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">

                                        No special instructions available.

                                    </p>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- =========================================
                         Contact Information
                    ========================================== -->

                    <div class="camp-section mt-4">

                        <h4 class="section-title">

                            <i class="fa-solid fa-address-book me-2"></i>

                            Contact Information

                        </h4>

                        <div class="row g-3">

                            <!-- Phone -->
                            @if (!string.IsNullOrWhiteSpace(Model.ContactNumber))
                            {
                                <div class="col-md-6">

                                    <div class="contact-item">

                                        <div class="contact-icon phone-icon">

                                            <i class="fa-solid fa-phone"></i>

                                        </div>

                                        <div>

                                            <small>

                                                Contact Number

                                            </small>

                                            <a href="tel:@Model.ContactNumber">

                                                @Model.ContactNumber

                                            </a>

                                        </div>

                                    </div>

                                </div>
                            }


                            <!-- Email -->
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <div class="col-md-6">

                                    <div class="contact-item">

                                        <div class="contact-icon email-icon">

                                            <i class="fa-solid fa-envelope"></i>

                                        </div>

                                        <div>

                                            <small>

                                                Email Address

                                            </small>

                                            <a href="mailto:@Model.Email">

                                                @Model.Email

                                            </a>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- =========================================
                         Registration Section
                    ========================================== -->

                    <div class="registration-card mt-4">

                        <div class="row align-items-center g-3">

                            <div class="col-md-7">

                                <div class="registration-content">

                                    <span class="registration-label">

                                        <i class="fa-solid fa-calendar-check me-1"></i>

                                        Medical Camp Registration

                                    </span>

                                    <h3 class="fw-bold mt-2 mb-2">

                                        @if (Model.AvailableSeats > 0)
                                        {
                                            <text>

                                                Reserve Your Seat Today

                                            </text>
                                        }
                                        else
                                        {
                                            <text>

                                                Registration is Full

                                            </text>
                                        }

                                    </h3>

                                    @if (Model.AvailableSeats > 0)
                                    {
                                        <p class="mb-0">

                                            Only

                                            <strong>

                                                @Model.AvailableSeats

                                            </strong>

                                            seats are currently available.

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="mb-0">

                                            All available seats for this medical camp
                                            have been registered.

                                        </p>
                                    }

                                </div>

                            </div>


                            <div class="col-md-5 text-md-end">

                                @if (Model.AvailableSeats > 0)
                                {
                                    <a asp-action="RegisterCamp"
                                       asp-route-id="@Model.CampId"
                                       class="btn btn-light btn-lg register-btn">

                                        <i class="fa-solid fa-calendar-plus me-2"></i>

                                        Register Now

                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary btn-lg"
                                            disabled>

                                        <i class="fa-solid fa-ban me-2"></i>

                                        Registration Full

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                    <!-- =========================================
                         Registration Progress
                    ========================================== -->

                    @{
                        int registeredSeats =
                            Model.MaxParticipants - Model.AvailableSeats;

                        if (registeredSeats < 0)
                        {
                            registeredSeats = 0;
                        }

                        double registrationPercentage = 0;

                        if (Model.MaxParticipants > 0)
                        {
                            registrationPercentage =
                                ((double)registeredSeats /
                                 Model.MaxParticipants) * 100;
                        }

                        if (registrationPercentage > 100)
                        {
                            registrationPercentage = 100;
                        }
                    }

                    <div class="mt-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="small text-muted">

                                Registration Progress

                            </span>

                            <span class="small fw-bold">

                                @registrationPercentage.ToString("0.#")%

                            </span>

                        </div>

                        <div class="progress camp-progress">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width:@registrationPercentage.ToString("0.##")%;">

                            </div>

                        </div>

                    </div>


                    <!-- =========================================
                         Bottom Actions
                    ========================================== -->

                    <div class="bottom-actions mt-4">

                        <a asp-action="MedicalCamps"
                           class="btn btn-outline-secondary">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back to Camps

                        </a>

                        @if (Model.AvailableSeats > 0)
                        {
                            <a asp-action="RegisterCamp"
                               asp-route-id="@Model.CampId"
                               class="btn btn-primary">

                                <i class="fa-solid fa-calendar-plus me-2"></i>

                                Register for This Camp

                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled>

                                <i class="fa-solid fa-ban me-2"></i>

                                Registration Full

                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Styles {

<style>

body{
    background:#f5f8fc;
}


/* =========================================
   Main Page
========================================= */

.camp-details-page{
    max-width:1400px;
}


/* =========================================
   Hero
========================================= */

.camp-hero{
    height:390px;
    position:relative;
    overflow:hidden;
    border-radius:24px;
    background:#0d6efd;
    box-shadow:0 15px 35px rgba(0,0,0,.10);
}

.camp-hero-image{
    width:100%;
    height:100%;
    object-fit:cover;
}

.camp-hero-placeholder{
    width:100%;
    height:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:100px;
    color:rgba(255,255,255,.35);
}

.camp-hero-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:end;
    padding:45px;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.78),
        rgba(0,0,0,.08)
    );
}

.hero-content{
    color:#fff;
    max-width:850px;
}

.hero-content h1{
    font-size:42px;
    font-weight:800;
    margin-top:15px;
    margin-bottom:10px;
}

.hero-content p{
    margin:0;
    font-size:16px;
    opacity:.95;
}


/* =========================================
   Featured Badge
========================================= */

.featured-badge{
    display:inline-block;
    padding:8px 15px;
    border-radius:25px;
    background:#ffc107;
    color:#212529;
    font-size:12px;
    font-weight:700;
    box-shadow:0 5px 15px rgba(0,0,0,.18);
}


/* =========================================
   Cards
========================================= */

.card{
    border-radius:18px;
}

.camp-image-card{
    overflow:hidden;
}


/* =========================================
   Main Image
========================================= */

.camp-main-image{
    width:100%;
    height:320px;
    object-fit:cover;
    border-radius:14px;
}

.camp-image-placeholder{
    height:320px;
    border-radius:14px;
    background:#eef3f8;
    color:#adb5bd;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:10px;
    font-size:18px;
}

.camp-image-placeholder i{
    font-size:60px;
}


/* =========================================
   Availability
========================================= */

.availability-box{
    border-radius:12px;
    padding:14px 16px;
}

.available-status,
.full-status{
    display:flex;
    align-items:center;
    gap:12px;
}

.available-status{
    color:#198754;
    background:#eaf8f0;
    padding:13px;
    border-radius:10px;
}

.full-status{
    color:#dc3545;
    background:#fff0f1;
    padding:13px;
    border-radius:10px;
}

.available-status strong,
.full-status strong{
    display:block;
    font-size:14px;
}

.available-status small,
.full-status small{
    display:block;
    font-size:11px;
    margin-top:2px;
    opacity:.8;
}

.status-dot{
    width:10px;
    height:10px;
    min-width:10px;
    border-radius:50%;
    background:currentColor;
}


/* =========================================
   Fee
========================================= */

.fee-box{
    min-width:145px;
    padding:13px 18px;
    border-radius:12px;
    background:#f0f7ff;
    text-align:center;
}

.fee-box small{
    display:block;
    color:#6c757d;
    font-size:11px;
}

.fee-box strong{
    display:block;
    color:#0d6efd;
    font-size:21px;
    margin-top:2px;
}


/* =========================================
   Detail Items
========================================= */

.detail-item{
    display:flex;
    align-items:center;
    gap:13px;
    padding:15px;
    background:#f8fafc;
    border:1px solid #edf0f5;
    border-radius:12px;
    height:100%;
    transition:.25s ease;
}

.detail-item:hover{
    transform:translateY(-2px);
    box-shadow:0 7px 18px rgba(0,0,0,.06);
}

.detail-item small{
    display:block;
    color:#8a94a6;
    font-size:11px;
    margin-bottom:3px;
}

.detail-item strong{
    display:block;
    color:#263143;
    font-size:14px;
}

.detail-icon{
    width:45px;
    height:45px;
    min-width:45px;
    border-radius:11px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
}

.date-icon{
    color:#0d6efd;
    background:#eaf2ff;
}

.time-icon{
    color:#198754;
    background:#eaf8f0;
}

.doctor-icon{
    color:#7c3aed;
    background:#f1eaff;
}

.department-icon{
    color:#0891b2;
    background:#e6f9fc;
}

.location-icon{
    color:#dc3545;
    background:#fff0f1;
}

.organizer-icon{
    color:#f59e0b;
    background:#fff6e5;
}


/* =========================================
   Seat Summary
========================================= */

.seat-summary{
    display:flex;
    align-items:center;
    gap:25px;
    padding:18px;
    background:#f8fafc;
    border-radius:13px;
    border:1px solid #edf0f5;
}

.seat-summary small{
    display:block;
    color:#8a94a6;
    font-size:11px;
    margin-bottom:3px;
}

.seat-summary h4{
    color:#263143;
}

.seat-divider{
    width:1px;
    height:42px;
    background:#dee2e6;
}

.seat-icon{
    margin-left:auto;
    width:48px;
    height:48px;
    border-radius:12px;
    background:#eaf2ff;
    color:#0d6efd;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}


/* =========================================
   Sections
========================================= */

.camp-section{
    border-top:1px solid #edf0f5;
    padding-top:25px;
}

.section-title{
    font-size:20px;
    font-weight:700;
    color:#172033;
    margin-bottom:15px;
}

.section-title i{
    color:#0d6efd;
}

.section-text{
    color:#596273;
    line-height:1.85;
    white-space:pre-line;
    margin-bottom:0;
}


/* =========================================
   Benefits / Instructions
========================================= */

.content-box{
    height:100%;
    padding:22px;
    border-radius:14px;
}

.benefits-box{
    background:#eefaf3;
    border:1px solid #d9f2e2;
}

.benefits-box h5{
    color:#198754;
}

.instructions-box{
    background:#fff8e8;
    border:1px solid #ffedbd;
}

.instructions-box h5{
    color:#b77900;
}

.content-text{
    margin-top:12px;
    color:#596273;
    line-height:1.8;
    white-space:pre-line;
}


/* =========================================
   Contact
========================================= */

.contact-item{
    display:flex;
    align-items:center;
    gap:14px;
    padding:15px;
    border:1px solid #edf0f5;
    background:#f8fafc;
    border-radius:12px;
}

.contact-icon{
    width:44px;
    height:44px;
    min-width:44px;
    border-radius:11px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.phone-icon{
    background:#eaf8f0;
    color:#198754;
}

.email-icon{
    background:#fff0f1;
    color:#dc3545;
}

.contact-item small{
    display:block;
    color:#8a94a6;
    font-size:11px;
}

.contact-item a{
    color:#263143;
    text-decoration:none;
    font-weight:600;
    font-size:14px;
}

.contact-item a:hover{
    color:#0d6efd;
}


/* =========================================
   Registration Card
========================================= */

.registration-card{
    padding:25px;
    border-radius:17px;
    color:#fff;
    background:linear-gradient(
        135deg,
        #0d6efd,
        #2563eb
    );
    box-shadow:0 12px 30px rgba(13,110,253,.18);
}

.registration-label{
    font-size:12px;
    font-weight:600;
    opacity:.9;
}

.registration-card h3{
    font-size:25px;
}

.registration-card p{
    opacity:.9;
}

.register-btn{
    color:#0d6efd;
    border:none;
    font-weight:700;
    padding:12px 24px;
}

.register-btn:hover{
    color:#0d6efd;
    background:#fff;
}


/* =========================================
   Progress
========================================= */

.camp-progress{
    height:9px;
    border-radius:20px;
    background:#e9ecef;
    overflow:hidden;
}

.camp-progress .progress-bar{
    border-radius:20px;
    background:#198754;
    transition:width .7s ease;
}


/* =========================================
   Bottom Actions
========================================= */

.bottom-actions{
    display:flex;
    justify-content:space-between;
    gap:12px;
}

.bottom-actions .btn{
    border-radius:10px;
    padding:11px 20px;
    font-weight:600;
    transition:.25s;
