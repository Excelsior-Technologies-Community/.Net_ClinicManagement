@model ClinicManagementSystem.Models.ClinicInformationModel

@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid p-0">

    <!-- Banner Section -->

    <div class="position-relative">

        @if (!string.IsNullOrEmpty(Model.BannerImage))
        {
            <img src="~/Clinic/@Model.BannerImage"
                 class="img-fluid w-100 banner-image"
                 alt="Clinic Banner" />
        }
        else
        {
            <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef"
                 class="img-fluid w-100 banner-image"
                 alt="Clinic Banner" />
        }

        <div class="banner-overlay">

            <div class="container h-100">

                <div class="row h-100 align-items-center">

                    <div class="col-lg-8">

                        <h1 class="display-4 fw-bold text-white">

                            Welcome to

                            <span class="text-warning">

                                @Model.ClinicName

                            </span>

                        </h1>

                        <p class="lead text-white mt-3">

                            Compassion • Care • Commitment

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="container py-5">

    <div class="row align-items-center">

        <!-- Clinic Logo -->

        <div class="col-lg-4 text-center mb-4">

            @if (!string.IsNullOrEmpty(Model.ClinicLogo))
            {
                <img src="~/Clinic/@Model.ClinicLogo"
                     class="clinic-logo shadow"
                     alt="Clinic Logo" />
            }
            else
            {
                <img src="https://cdn-icons-png.flaticon.com/512/2966/2966483.png"
                     class="clinic-logo shadow"
                     alt="Clinic Logo" />
            }

        </div>

        <!-- About Clinic -->

        <div class="col-lg-8">

            <h2 class="fw-bold text-primary mb-4">

                <i class="fa-solid fa-hospital me-2"></i>

                About Our Clinic

            </h2>

            <p class="text-muted about-text">

                @Model.AboutClinic

            </p>

            <div class="row mt-4">

                <div class="col-md-6 mb-3">

                    <div class="info-card">

                        <i class="fa-solid fa-phone text-success me-2"></i>

                        <strong>Phone :</strong>

                        @Model.MobileNo

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="info-card">

                        <i class="fa-solid fa-envelope text-danger me-2"></i>

                        <strong>Email :</strong>

                        @Model.Email

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="info-card">

                        <i class="fa-solid fa-clock text-warning me-2"></i>

                        <strong>Working Hours :</strong>

                        @Model.WorkingHours

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="info-card">

                        <i class="fa-solid fa-location-dot text-primary me-2"></i>

                        <strong>Address :</strong>

                        @Model.Address

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- Mission & Vision -->

    <div class="row mt-5">

        <!-- Mission -->

        <div class="col-lg-6 mb-4">

            <div class="card border-0 shadow about-card h-100">

                <div class="card-body p-4">

                    <div class="text-center mb-3">

                        <i class="fa-solid fa-bullseye text-primary display-5"></i>

                    </div>

                    <h3 class="fw-bold text-center text-primary mb-3">

                        Our Mission

                    </h3>

                    <p class="text-muted text-center">

                        @if (!string.IsNullOrWhiteSpace(Model.Mission))
                        {
                            @Model.Mission
                        }
                        else
                        {
                            <span>
                                To provide affordable, high-quality healthcare
                                with compassion, integrity, and excellence.
                            </span>
                        }

                    </p>

                </div>

            </div>

        </div>

        <!-- Vision -->

        <div class="col-lg-6 mb-4">

            <div class="card border-0 shadow about-card h-100">

                <div class="card-body p-4">

                    <div class="text-center mb-3">

                        <i class="fa-solid fa-eye text-success display-5"></i>

                    </div>

                    <h3 class="fw-bold text-center text-success mb-3">

                        Our Vision

                    </h3>

                    <p class="text-muted text-center">

                        @if (!string.IsNullOrWhiteSpace(Model.Vision))
                        {
                            @Model.Vision
                        }
                        else
                        {
                            <span>
                                To become the most trusted healthcare provider
                                delivering exceptional patient care.
                            </span>
                        }

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Why Choose Us -->

    <div class="card border-0 shadow mt-4">

        <div class="card-body p-5">

            <h2 class="fw-bold text-primary mb-4">

                <i class="fa-solid fa-star me-2"></i>

                Why Choose Our Clinic

            </h2>

            <p class="text-muted mb-4">

                @if (!string.IsNullOrWhiteSpace(Model.WhyChooseUs))
                {
                    @Model.WhyChooseUs
                }
                else
                {
                    <span>
                        We are committed to providing personalized treatment,
                        experienced doctors, advanced medical facilities,
                        and compassionate care for every patient.
                    </span>
                }

            </p>

            <div class="row">

                <div class="col-md-4 mb-3">

                    <div class="feature-box">

                        <i class="fa-solid fa-user-doctor text-primary fa-2x mb-3"></i>

                        <h5 class="fw-bold">

                            Expert Doctors

                        </h5>

                        <p class="text-muted mb-0">

                            Experienced specialists for quality healthcare.

                        </p>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="feature-box">

                        <i class="fa-solid fa-heart-pulse text-danger fa-2x mb-3"></i>

                        <h5 class="fw-bold">

                            Quality Care

                        </h5>

                        <p class="text-muted mb-0">

                            Patient-focused treatment with compassion.

                        </p>

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <div class="feature-box">

                        <i class="fa-solid fa-clock text-success fa-2x mb-3"></i>

                        <h5 class="fw-bold">

                            Timely Service

                        </h5>

                        <p class="text-muted mb-0">

                            Quick appointments and efficient healthcare.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Contact & Social Information -->

    <div class="row mt-5">

        <div class="col-lg-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-primary mb-4">

                        <i class="fa-solid fa-address-book me-2"></i>

                        Contact Information

                    </h3>

                    <p>

                        <i class="fa-solid fa-phone text-success me-2"></i>

                        <strong>Emergency :</strong>

                        @Model.EmergencyContact

                    </p>

                    <p>

                        <i class="fa-solid fa-globe text-info me-2"></i>

                        <strong>Website :</strong>

                        @Model.Website

                    </p>

                    <p>

                        <i class="fa-brands fa-whatsapp text-success me-2"></i>

                        <strong>WhatsApp :</strong>

                        @Model.WhatsAppNo

                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-primary mb-4">

                        <i class="fa-solid fa-share-nodes me-2"></i>

                        Follow Us

                    </h3>

                    <a href="@Model.FacebookLink"
                       target="_blank"
                       class="btn btn-primary w-100 mb-2">

                        <i class="fab fa-facebook-f me-2"></i>

                        Facebook

                    </a>

                    <a href="@Model.InstagramLink"
                       target="_blank"
                       class="btn btn-danger w-100 mb-2">

                        <i class="fab fa-instagram me-2"></i>

                        Instagram

                    </a>

                    <a href="@Model.TwitterLink"
                       target="_blank"
                       class="btn btn-dark w-100">

                        <i class="fab fa-x-twitter me-2"></i>

                        Twitter (X)

                    </a>

                </div>

            </div>

        </div>

    </div>
    <!-- Google Map -->
    @if (!string.IsNullOrWhiteSpace(Model.GoogleMapLink))
    {
        <div class="card border-0 shadow mt-5">

            <div class="card-body">

                <h2 class="fw-bold text-primary mb-4">

                    <i class="fa-solid fa-location-dot me-2"></i>

                    Find Us

                </h2>

                <div class="ratio ratio-16x9">

                    <iframe src="@Model.GoogleMapLink"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                    </iframe>

                </div>

            </div>

        </div>
    }

</div>

@section Styles {

    <style>

        body {
            background: #f8f9fa;
        }

        /* Banner */

        .banner-image {
            height: 450px;
            object-fit: cover;
        }

        .banner-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.55);
        }

        /* Logo */

        .clinic-logo {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            object-fit: cover;
            border: 8px solid #fff;
            transition: .4s;
        }

            .clinic-logo:hover {
                transform: scale(1.05);
            }

        /* Cards */

        .card {
            border-radius: 20px;
        }

        .about-card {
            transition: .35s;
        }

            .about-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(13,110,253,.18);
            }

        .feature-box {
            text-align: center;
            padding: 25px;
            border-radius: 15px;
            transition: .3s;
            background: #f8fbff;
            height: 100%;
        }

            .feature-box:hover {
                background: #0d6efd;
                color: #fff;
            }

                .feature-box:hover p,
                .feature-box:hover h5,
                .feature-box:hover i {
                    color: #fff !important;
                }

        .info-card {
            background: #fff;
            padding: 15px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

        .about-text {
            text-align: justify;
            line-height: 1.9;
            font-size: 16px;
        }

        .btn {
            border-radius: 10px;
            transition: .3s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        iframe {
            border-radius: 15px;
        }

        @@media(max-width:991px) {

            .banner-image {
                height: 350px;
            }

            .clinic-logo {
                width: 200px;
                height: 200px;
            }
        }

        @@media(max-width:768px) {

            .banner-image {
                height: 250px;
            }

            .display-4 {
                font-size: 34px;
            }

            .clinic-logo {
                width: 170px;
                height: 170px;
            }

            h2 {
                font-size: 26px;
            }
        }

        @@media(max-width:576px) {

            .banner-image {
                height: 200px;
            }

            .display-4 {
                font-size: 28px;
            }

            .clinic-logo {
                width: 140px;
                height: 140px;
            }

            .about-text {
                font-size: 15px;
            }
        }

    </style>

}

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

            icon:'success',

            title:'Success',

            text:'@TempData["Success"]'

            });

        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>

            Swal.fire({

            icon:'error',

            title:'Error',

            text:'@TempData["Error"]'

            });

        </script>
    }

    <script>

        $(document).ready(function(){

            $(".card").hide().each(function(index){

                $(this).delay(index*150).fadeIn(500);

            });

        });

    </script>

}