@model ClinicManagementSystem.Models.LabBookingModel
@{
    ViewData["Title"] = "Booking Details #" + Model.BookingNo;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="MyLabTests" class="btn btn-outline-secondary rounded-pill"><i class="fa-solid fa-arrow-left me-1"></i> Back to My Bookings</a>
    <div>
        @if (Model.TestStatus == "Completed")
        {
            <a asp-action="MyLabReports" class="btn btn-success rounded-pill"><i class="fa-solid fa-file-medical-alt me-1"></i> View Lab Reports</a>
        }
        else if (Model.TestStatus == "Pending" || Model.TestStatus == "Sample Collected")
        {
            <a asp-action="CancelLabBooking" asp-route-id="@Model.LabBookingId" class="btn btn-outline-danger rounded-pill btn-cancel-confirm"><i class="fa-solid fa-xmark me-1"></i> Cancel Booking</a>
        }
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-primary text-white p-4 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-light text-primary fw-semibold px-3 py-1 rounded-pill mb-2">Reference: @Model.BookingNo</span>
                    <h3 class="fw-bold mb-0">@Model.TestName</h3>
                </div>
                <div>
                    @if (Model.TestStatus == "Completed")
                    {
                        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-check-circle me-1"></i>Completed</span>
                    }
                    else if (Model.TestStatus == "Cancelled")
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-xmark me-1"></i>Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-clock me-1"></i>@Model.TestStatus</span>
                    }
                </div>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <div class="row g-4 mb-4">
                    <!-- Booking Meta -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-file-invoice me-2"></i>Booking Information</h6>
                            <table class="table table-borderless mb-0 fs-7">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Booking Reference:</th>
                                    <td class="fw-bold text-dark">@Model.BookingNo</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Booked On:</th>
                                    <td>@Model.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Preferred Date:</th>
                                    <td class="fw-bold text-dark">@(Model.PreferredDate.HasValue ? Model.PreferredDate.Value.ToString("dd MMM yyyy") : "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Time Slot:</th>
                                    <td>@(string.IsNullOrEmpty(Model.PreferredTime) ? "Standard Slot" : Model.PreferredTime)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Financial & Status -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-money-check-dollar me-2"></i>Payment & Status</h6>
                            <table class="table table-borderless mb-0 fs-7">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Test Fee:</th>
                                    <td class="fw-bold text-success fs-6">₹@Model.Amount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Payment Status:</th>
                                    <td><span class="badge bg-info text-dark">@Model.PaymentStatus</span></td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Current Status:</th>
                                    <td class="fw-bold">@Model.TestStatus</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Sample Type:</th>
                                    <td>@(string.IsNullOrEmpty(Model.SampleType) ? "Standard Sample" : Model.SampleType)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Patient Info -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-4 border">
                            <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user-injured me-2"></i>Patient Details</h6>
                            <div class="row g-3 fs-7">
                                <div class="col-md-4">
                                    <span class="text-secondary">Patient Name:</span>
                                    <div class="fw-bold text-dark fs-6">@Model.PatientName</div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-secondary">Mobile Number:</span>
                                    <div class="fw-bold text-dark"><i class="fa-solid fa-phone me-1 text-secondary"></i>@Model.MobileNo</div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-secondary">Email Address:</span>
                                    <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-secondary">Age & Gender:</span>
                                    <div class="fw-bold text-dark">@(Model.Age.HasValue ? Model.Age.Value + " Yrs" : "N/A"), @(string.IsNullOrEmpty(Model.Gender) ? "N/A" : Model.Gender)</div>
                                </div>
                                <div class="col-md-8">
                                    <span class="text-secondary">Health Concern / Symptoms:</span>
                                    <div class="text-dark">@(string.IsNullOrEmpty(Model.HealthConcern) ? "None specified." : Model.HealthConcern)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Admin Remarks -->
                    @if (!string.IsNullOrEmpty(Model.AdminRemark))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-warning-subtle border border-warning rounded-4">
                                <h6 class="fw-bold text-warning-emphasis mb-2"><i class="fa-solid fa-comment-dots me-2"></i>Clinic / Admin Remark</h6>
                                <p class="mb-0 text-dark">@Model.AdminRemark</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-cancel-confirm').on('click', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                Swal.fire({
                    title: 'Cancel Booking?',
                    text: "Are you sure you want to cancel this lab test booking?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Cancel Booking'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}
