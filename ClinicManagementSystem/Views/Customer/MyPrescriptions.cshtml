@model IEnumerable<ClinicManagementSystem.Models.PrescriptionModel>

@{
    ViewData["Title"] = "My Prescriptions";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">

    <!-- Header -->

    <div class="card border-0 shadow-lg mb-4">

        <div class="card-body text-white rounded"
             style="background:linear-gradient(135deg,#0d6efd,#4f8cff);">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1">

                        <i class="fa-solid fa-file-prescription me-2"></i>

                        My Prescriptions

                    </h2>

                    <p class="mb-0">

                        View and download all your medical prescriptions.

                    </p>

                </div>

                <div class="text-end">

                    <div class="bg-white text-primary rounded px-3 py-2 fw-bold">

                        Total Prescriptions :
                        @ViewBag.TotalPrescription

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Search -->

    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label fw-bold">

                            Search

                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Appointment No / Doctor / Diagnosis" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label fw-bold">

                            Status

                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">All</option>

                            @if (ViewBag.Status == "Active")
                            {
                                <option value="Active" selected>
                                    Active
                                </option>
                            }
                            else
                            {
                                <option value="Active">
                                    Active
                                </option>
                            }

                            @if (ViewBag.Status == "Completed")
                            {
                                <option value="Completed" selected>
                                    Completed
                                </option>
                            }
                            else
                            {
                                <option value="Completed">
                                    Completed
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3 d-flex align-items-end">

                        <button class="btn btn-primary w-100">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Prescription List -->

    <div class="card border-0 shadow">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-notes-medical me-2"></i>

                Prescription List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Doctor</th>

                            <th>Appointment No</th>

                            <th>Department</th>

                            <th>Diagnosis</th>

                            <th>Next Visit</th>

                            <th>Status</th>

                            <th width="180">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">
                                        @sr
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(item.DoctorImage))
                                            {
                                                <img src="~/Department/@item.DoctorImage"
                                                     class="rounded-circle border me-2"
                                                     width="55"
                                                     height="55"
                                                     style="object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <img src="~/images/no-image.png"
                                                     class="rounded-circle border me-2"
                                                     width="55"
                                                     height="55"
                                                     style="object-fit:cover;" />
                                            }

                                            <div>
                                                <strong>Dr. @item.DoctorName</strong>
                                            </div>

                                        </div>

                                    </td>

                                    <td>@item.AppointmentNo</td>

                                    <td>@item.DepartmentName</td>

                                    <td>@item.Diagnosis</td>

                                    <td>
                                        @(item.NextVisitDate?.ToString("dd MMM yyyy"))
                                    </td>

                                    <td>

                                        @if (item.PrescriptionStatus == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (item.PrescriptionStatus == "Completed")
                                        {
                                            <span class="badge bg-primary">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.PrescriptionStatus
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="ViewPrescription"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-primary btn-sm">

                                            <i class="fa fa-eye"></i>

                                        </a>

                                        <a asp-action="DownloadPrescriptionPDF"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-success btn-sm">

                                            <i class="fa fa-file-pdf"></i>

                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <i class="fa fa-file-prescription fa-4x text-secondary mb-3"></i>

                                    <h4>No Prescription Found</h4>

                                    <p>Your prescriptions will appear here.</p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

    @section Styles {

        <style>

            body {
                background: #f5f7fb;
            }

            .card {
                border: none;
                border-radius: 18px;
                overflow: hidden;
                transition: .35s;
            }

                .card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
                }

            .table th {
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

            .table td {
                vertical-align: middle;
            }

            .table-hover tbody tr:hover {
                background: #f8fbff;
            }

            .rounded-circle {
                transition: .35s;
            }

                .rounded-circle:hover {
                    transform: scale(1.12);
                }

            .form-control,
            .form-select {
                min-height: 45px;
                border-radius: 10px;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
                }

            .btn {
                border-radius: 8px;
                transition: .3s;
            }

                .btn:hover {
                    transform: translateY(-2px);
                }

            .badge {
                font-size: 13px;
            }

            @@media(max-width:992px) {

                .table {
                    min-width: 1100px;
                }
            }

            @@media(max-width:768px) {

                h2 {
                    font-size: 24px;
                }
            }

        </style>

    }

    @section Scripts {

        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        @if (TempData["Success"] != null)
        {
            <script>

                Swal.fire({

                    icon:'success',

                    title:'Success',

                    text:'@TempData["Success"]',

                    confirmButtonColor:'#198754'

                });

            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>

                Swal.fire({

                    icon:'error',

                    title:'Error',

                    text:'@TempData["Error"]',

                    confirmButtonColor:'#dc3545'

                });

            </script>
        }

        <script>

            // Auto Hide Alerts
            window.setTimeout(function(){

                $(".alert").fadeTo(500,0).slideUp(500,function(){

                    $(this).remove();

                });

            },3000);

        </script>

    }