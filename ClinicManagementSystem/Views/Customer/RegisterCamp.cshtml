<!-- ========================================================= -->
<!-- VALIDATION + SUBMIT SCRIPT                                -->
<!-- ========================================================= -->
@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var form =
                    document.getElementById(
                        "registerCampForm"
                    );


                var button =
                    document.getElementById(
                        "registerButton"
                    );


                var checkbox =
                    document.getElementById(
                        "confirmDetails"
                    );


                if (!form) {
                    return;
                }


                form.addEventListener(
                    "submit",
                    function (e) {

                        // ======================================
                        // CONFIRMATION CHECK
                        // ======================================

                        if (!checkbox.checked) {

                            e.preventDefault();

                            alert(
                                "Please confirm that the information provided above is correct."
                            );

                            checkbox.focus();

                            return false;
                        }


                        // ======================================
                        // DISABLE BUTTON
                        // ======================================

                        button.disabled = true;


                        button.innerHTML =
                            '<i class="fa-solid fa-spinner fa-spin me-2"></i>' +
                            'Processing Registration...';


                        // ======================================
                        // IMPORTANT
                        // ======================================
                        // DO NOT use:
                        //
                        // e.preventDefault();
                        //
                        // here.
                        //
                        // Form must POST to:
                        //
                        // /Customer/RegisterCamp
                        //
                        // ======================================

                    }
                );

            }
        );

    </script>


    <!-- ===================================================== -->
    <!-- SUCCESS MESSAGE                                       -->
    <!-- ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    Swal.fire({
                        icon: "success",
                        title: "Registration Successful!",
                        text: @Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(
                                                        TempData["Success"]?.ToString()
                                                )
                                        ),
                confirmButtonText: "View My Registrations",
                confirmButtonColor: "#0d6efd"
            }).then(function (result) {

                        if (result.isConfirmed) {

                            window.location.href =
                                "/Customer/MyCampRegistrations";

                        }

                    });

                }
            );

        </script>
    }


    <!-- ===================================================== -->
    <!-- ERROR MESSAGE                                         -->
    <!-- ===================================================== -->
    @if (TempData["Error"] != null)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    Swal.fire({
                        icon: "error",
                        title: "Registration Failed",
                        text: @Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(
                                                        TempData["Error"]?.ToString()
                                                )
                                        ),
                confirmButtonText: "OK",
                confirmButtonColor: "#dc3545"
            });

                }
            );

        </script>
    }

}