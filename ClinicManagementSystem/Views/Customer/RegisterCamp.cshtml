@model ClinicManagementSystem.Models.CampRegistrationModel

@{
    ViewData["Title"] = "Register for Medical Camp";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}



<style>
    /* =========================================================
           FORM CONTROLS
           ========================================================= */

    .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #273142;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 46px;
        border: 1px solid #dce2ea;
        border-radius: 10px;
        font-size: 13px;
        color: #273142;
        padding: 10px 13px;
        box-shadow: none;
        transition: all 0.2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.10);
        }

    textarea.form-control {
        min-height: 115px;
        resize: vertical;
    }

    .form-control::placeholder {
        color: #a2aab7;
    }

    .form-text {
        font-size: 11px;
        color: #8a93a2;
        margin-top: 7px;
    }

    .text-danger.small {
        display: block;
        margin-top: 5px;
        font-size: 11px;
    }


    /* =========================================================
           SUMMARY
           ========================================================= */

    .summary-box {
        min-height: 78px;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        background: #f8fafc;
        border: 1px solid #e9eef4;
        border-radius: 12px;
    }

    .summary-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #eaf3ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .summary-label {
        font-size: 11px;
        color: #8a93a2;
        margin-bottom: 3px;
    }

    .summary-value {
        font-size: 13px;
        font-weight: 650;
        color: #273142;
        word-break: break-word;
    }

    /* =========================================================
           PAGE BACKGROUND
           ========================================================= */

    .register-page {
        background: #f6f8fb;
        min-height: 100vh;
        padding: 40px 0 70px;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .register-header {
        background: linear-gradient( 135deg, #0d6efd, #084298 );
        border-radius: 20px;
        padding: 30px 35px;
        color: #ffffff;
        margin-bottom: 30px;
        box-shadow: 0 12px 35px rgba(13, 110, 253, 0.18);
    }

    .register-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .register-header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .register-header-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .register-header h2 {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
    }

    .register-header p {
        margin: 6px 0 0;
        opacity: 0.88;
        font-size: 14px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border: 1px solid rgba(255,255,255,0.35);
        border-radius: 10px;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .back-btn:hover {
            background: rgba(255,255,255,0.14);
            color: #ffffff;
        }


    /* =========================================================
           COMMON CARD
           ========================================================= */

    .register-card {
        background: #ffffff;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        margin-bottom: 25px;
    }

    .register-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .register-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #eaf3ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .register-card-header h5 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #172033;
    }

    .register-card-header p {
        margin: 3px 0 0;
        font-size: 12px;
        color: #7b8494;
    }

    .register-card-body {
        padding: 24px;
    }


    /* =========================================================
           CAMP IMAGE
           ========================================================= */

    .camp-image-wrapper {
        width: 100%;
        height: 270px;
        border-radius: 15px;
        overflow: hidden;
        background: #eef2f7;
        position: relative;
    }

        .camp-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .camp-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #8993a4;
        gap: 10px;
    }

        .camp-image-placeholder i {
            font-size: 42px;
        }


    /* =========================================================
           CAMP TITLE
           ========================================================= */

    .camp-title {
        font-size: 25px;
        font-weight: 750;
        color: #172033;
        margin-bottom: 8px;
    }

    .camp-subtitle {
        font-size: 14px;
        color: #727c8d;
        line-height: 1.6;
        margin-bottom: 18px;
    }


    /* =========================================================
           INFORMATION ITEM
           ========================================================= */

    .camp-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 13px;
    }

    .camp-info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px;
        background: #f8fafc;
        border: 1px solid #edf1f5;
        border-radius: 12px;
    }

    .camp-info-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eaf3ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .camp-info-label {
        font-size: 11px;
        color: #8a93a2;
        margin-bottom: 2px;
    }

    .camp-info-value {
        font-size: 13px;
        font-weight: 650;
        color: #273142;
        word-break: break-word;
    }


    /* =========================================================
           FEE BOX
           ========================================================= */

    .fee-box {
        margin-top: 18px;
        padding: 18px;
        border-radius: 13px;
        background: #f0f7ff;
        border: 1px solid #d9eaff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .fee-label {
        font-size: 12px;
        color: #6f7a8b;
        margin-bottom: 3px;
    }

    .fee-value {
        font-size: 24px;
        font-weight: 750;
        color: #0d6efd;
    }

    .seat-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #d9eaff;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991px) {
        .register-page

    {
        padding: 25px 0 50px;
    }

    .register-header {
        padding: 25px;
    }

    .register-header-content {
        align-items: flex-start;
    }

    .camp-image-wrapper {
        height: 230px;
    }

    }


    @@media (max-width: 767px) {
        .register-header-content

    {
        flex-direction: column;
    }

    .back-btn {
        width: 100%;
        justify-content: center;
    }

    .register-header h2 {
        font-size: 22px;
    }

    .register-header {
        padding: 22px;
    }

    .register-card-body {
        padding: 18px;
    }

    .camp-info-grid {
        grid-template-columns: 1fr;
    }

    .fee-box {
        align-items: flex-start;
        flex-direction: column;
    }

    .seat-badge {
        width: 100%;
        justify-content: center;
    }

    }
</style>


<!-- ========================================================= -->
<!-- PAGE -->
<!-- ========================================================= -->

<div class="register-page">

    <div class="container">


        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->

        <div class="register-header">

            <div class="register-header-content">

                <div class="register-header-left">

                    <div class="register-header-icon">

                        <i class="fa-solid fa-user-plus"></i>

                    </div>

                    <div>

                        <h2>
                            Register for Medical Camp
                        </h2>

                        <p>
                            Complete your details to register
                            for this medical camp.
                        </p>

                    </div>

                </div>


                <a asp-action="MedicalCamps"
                   class="back-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Camps

                </a>

            </div>

        </div>



        <!-- ================================================= -->
        <!-- CAMP INFORMATION -->
        <!-- ================================================= -->

        <div class="register-card">

            <div class="register-card-header">

                <div class="register-card-icon">

                    <i class="fa-solid fa-hospital"></i>

                </div>

                <div>

                    <h5>
                        Medical Camp Information
                    </h5>

                    <p>
                        Review the camp details before registration.
                    </p>

                </div>

            </div>


            <div class="register-card-body">

                <div class="row g-4">


                    <!-- ===================================== -->
                    <!-- CAMP IMAGE -->
                    <!-- ===================================== -->

                    <div class="col-lg-4">

                        <div class="camp-image-wrapper">

                            @if (!string.IsNullOrWhiteSpace(Model.CampImage))
                            {
                                <img src="@Url.Content(
                                                                         "~/MedicalCampImages/" +
                                                                         Model.CampImage)"
                                 alt="@Model.CampTitle" />
                                                        }
                            else
                            {
                                <div class="camp-image-placeholder">

                                    <i class="fa-solid fa-hospital"></i>

                                    <span>
                                        No Camp Image
                                    </span>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- ===================================== -->
                    <!-- CAMP DETAILS -->
                    <!-- ===================================== -->

                    <div class="col-lg-8">

                        <div class="camp-title">

                            @Model.CampTitle

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                                                Model.CampDescription))
                        {
                            <div class="camp-subtitle">

                                @Model.CampDescription

                            </div>
                        }


                        <div class="camp-info-grid">


                            <!-- DATE -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-regular fa-calendar"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Camp Date
                                    </div>

                                    <div class="camp-info-value">

                                        @if (Model.CampDate != null)
                                        {
                                            @Model.CampDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span>Not Available</span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- TIME -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-regular fa-clock"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Camp Time
                                    </div>

                                    <div class="camp-info-value">

                                        @if (Model.StartTime.HasValue)
                                        {
                                            @Model.StartTime.Value.ToString(@"hh\:mm")

                                            @if (Model.EndTime.HasValue)
                                            {
                                                <span> - </span>

                                                @Model.EndTime.Value.ToString(@"hh\:mm")
                                            }
                                        }
                                        else
                                        {
                                            <span>Not Available</span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- VENUE -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Venue
                                    </div>

                                    <div class="camp-info-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                                Model.Venue))
                                        {
                                            @Model.Venue
                                        }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- DOCTOR -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-solid fa-user-doctor"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Doctor
                                    </div>

                                    <div class="camp-info-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                                Model.DoctorName))
                                        {
                                            @Model.DoctorName
                                        }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- DEPARTMENT -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-solid fa-stethoscope"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Department
                                    </div>

                                    <div class="camp-info-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                                Model.DepartmentName))
                                        {
                                            @Model.DepartmentName
                                        }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- ORGANIZER -->
                            <div class="camp-info-item">

                                <div class="camp-info-icon">

                                    <i class="fa-solid fa-building"></i>

                                </div>

                                <div>

                                    <div class="camp-info-label">
                                        Organizer
                                    </div>

                                    <div class="camp-info-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                                Model.Organizer))
                                        {
                                            @Model.Organizer
                                        }
                                        else
                                        {
                                            <span>
                                                Not specified
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                        </div>


                        <!-- ================================= -->
                        <!-- FEE + SEATS -->
                        <!-- ================================= -->

                        <div class="fee-box">

                            <div>

                                <div class="fee-label">
                                    Registration Fee
                                </div>

                                <div class="fee-value">

                                    @if (Model.RegistrationFee > 0)
                                    {
                                        <span>
                                            ₹@Model.RegistrationFee
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Free
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="seat-badge">

                                <i class="fa-solid fa-chair"></i>

                                @Model.AvailableSeats
                                seats available

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- PART 2 WILL CONTINUE HERE -->
        <!-- ================================================= -->
        <!-- ================================================= -->
        <!-- REGISTRATION FORM - PART 2                        -->
        <!-- ================================================= -->

        <form action="/Customer/RegisterCamp"
              method="post"
              id="registerCampForm">

            @Html.AntiForgeryToken()

            <!-- ============================================= -->
            <!-- HIDDEN VALUES                                  -->
            <!-- ============================================= -->

            <input type="hidden"
                   asp-for="CampId" />

            <input type="hidden"
                   asp-for="CustomerId" />

            <input type="hidden"
                   asp-for="Amount" />


            <!-- ============================================= -->
            <!-- PARTICIPANT INFORMATION                        -->
            <!-- ============================================= -->

            <div class="register-card">

                <div class="register-card-header">

                    <div class="register-card-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <div>

                        <h5>
                            Participant Information
                        </h5>

                        <p>
                            Please provide the participant's
                            personal details.
                        </p>

                    </div>

                </div>


                <div class="register-card-body">

                    <div class="row g-4">


                        <!-- ================================= -->
                        <!-- PARTICIPANT NAME                   -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <label asp-for="ParticipantName"
                                   class="form-label">

                                <i class="fa-solid fa-user me-1 text-primary"></i>

                                Participant Name

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input asp-for="ParticipantName"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter participant name"
                                   autocomplete="name" />

                            <span asp-validation-for="ParticipantName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- MOBILE NUMBER                      -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <label asp-for="MobileNo"
                                   class="form-label">

                                <i class="fa-solid fa-phone me-1 text-success"></i>

                                Mobile Number

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input asp-for="MobileNo"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter mobile number"
                                   autocomplete="tel" />

                            <span asp-validation-for="MobileNo"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- EMAIL                               -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label">

                                <i class="fa-solid fa-envelope me-1 text-danger"></i>

                                Email Address

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter email address"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- AGE                                 -->
                        <!-- ================================= -->

                        <div class="col-md-3">

                            <label asp-for="Age"
                                   class="form-label">

                                <i class="fa-solid fa-calendar-days me-1 text-info"></i>

                                Age

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input asp-for="Age"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   max="120"
                                   placeholder="Age" />

                            <span asp-validation-for="Age"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- GENDER                              -->
                        <!-- ================================= -->

                        <div class="col-md-3">

                            <label asp-for="Gender"
                                   class="form-label">

                                <i class="fa-solid fa-venus-mars me-1 text-warning"></i>

                                Gender

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select asp-for="Gender"
                                    asp-items="ViewBag.GenderList"
                                    class="form-select">

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- HEALTH CONCERN                     -->
                        <!-- ================================= -->

                        <div class="col-12">

                            <label asp-for="HealthConcern"
                                   class="form-label">

                                <i class="fa-solid fa-notes-medical me-1 text-primary"></i>

                                Health Concern

                                <span class="text-muted">
                                    (Optional)
                                </span>

                            </label>

                            <textarea asp-for="HealthConcern"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Mention any relevant health concerns, allergies, existing conditions, or special requirements..."></textarea>

                            <div class="form-text">

                                Please mention any information
                                that may help the medical team.

                            </div>

                            <span asp-validation-for="HealthConcern"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- REGISTRATION SUMMARY                              -->
            <!-- ================================================= -->

            <div class="register-card">

                <div class="register-card-header">

                    <div class="register-card-icon">

                        <i class="fa-solid fa-clipboard-check"></i>

                    </div>

                    <div>

                        <h5>
                            Registration Summary
                        </h5>

                        <p>
                            Please review your registration details.
                        </p>

                    </div>

                </div>


                <div class="register-card-body">

                    <div class="row g-3">


                        <!-- ================================= -->
                        <!-- CAMP                               -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <div class="summary-box">

                                <div class="summary-icon">

                                    <i class="fa-solid fa-hospital"></i>

                                </div>

                                <div>

                                    <div class="summary-label">
                                        Medical Camp
                                    </div>

                                    <div class="summary-value">

                                        @Model.CampTitle

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- DATE                               -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <div class="summary-box">

                                <div class="summary-icon">

                                    <i class="fa-regular fa-calendar"></i>

                                </div>

                                <div>

                                    <div class="summary-label">
                                        Camp Date
                                    </div>

                                    <div class="summary-value">

                                        @if (Model.CampDate != null)
                                        {
                                            @Model.CampDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span>Not Available</span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- REGISTRATION FEE                   -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <div class="summary-box">

                                <div class="summary-icon">

                                    <i class="fa-solid fa-indian-rupee-sign"></i>

                                </div>

                                <div>

                                    <div class="summary-label">
                                        Registration Fee
                                    </div>

                                    <div class="summary-value">

                                        @if (Model.RegistrationFee > 0)
                                        {
                                            <span>
                                                ₹@Model.RegistrationFee.ToString("0.00")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-success">
                                                Free
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- PAYMENT STATUS                     -->
                        <!-- ================================= -->

                        <div class="col-md-6">

                            <div class="summary-box">

                                <div class="summary-icon">

                                    <i class="fa-solid fa-credit-card"></i>

                                </div>

                                <div>

                                    <div class="summary-label">
                                        Payment Status
                                    </div>

                                    <div class="summary-value">

                                        @if (Model.RegistrationFee > 0)
                                        {
                                            <span class="text-warning">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-success">
                                                Not Required
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <!-- ================================================= -->
            <!-- IMPORTANT INFORMATION                              -->
            <!-- ================================================= -->

            <div class="important-information">

                <div class="important-header">

                    <div class="important-icon">

                        <i class="fa-solid fa-shield-heart"></i>

                    </div>

                    <div>

                        <h6>
                            Important Information
                        </h6>

                        <p>
                            Please read the following information
                            before confirming your registration.
                        </p>

                    </div>

                </div>


                <ul class="important-list">

                    <li>
                        <i class="fa-solid fa-circle-check"></i>

                        Please provide accurate and valid
                        contact information.
                    </li>

                    <li>
                        <i class="fa-solid fa-circle-check"></i>

                        Your registration is subject to
                        seat availability.
                    </li>

                    <li>
                        <i class="fa-solid fa-circle-check"></i>

                        Please arrive at the venue before
                        the scheduled camp time.
                    </li>

                    <li>
                        <i class="fa-solid fa-circle-check"></i>

                        Bring previous medical reports or
                        prescriptions if required.
                    </li>

                    <li>
                        <i class="fa-solid fa-circle-check"></i>

                        Please inform the medical team about
                        any existing health concerns.
                    </li>

                </ul>

            </div>


            <!-- ================================================= -->
            <!-- CONFIRMATION                                      -->
            <!-- ================================================= -->

            <div class="confirmation-box">

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           id="confirmDetails"
                           required />

                    <label class="form-check-label"
                           for="confirmDetails">

                        I confirm that the information provided
                        above is correct and I agree to the
                        medical camp registration terms.

                    </label>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BUTTONS                                           -->
            <!-- ================================================= -->

            <div class="registration-actions">

                <!-- BACK -->

                <a asp-action="MedicalCampDetails"
                   asp-route-id="@Model.CampId"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left me-2"></i>

                    Back

                </a>


                <!-- SUBMIT -->

                <button type="submit"
                        id="registerButton"
                        class="btn btn-primary">

                    <i class="fa-solid fa-calendar-check me-2"></i>

                    Confirm Registration

                </button>

            </div>


        </form>

    </div>

</div>


<!-- ========================================================= -->
<!-- PART-3 CSS                                                -->
