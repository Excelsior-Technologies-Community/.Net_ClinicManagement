@model ClinicManagementSystem.Models.CustomerModel
@{
    ViewData["Title"] = "Patient Dashboard";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var profileImage = !string.IsNullOrEmpty(Model.ProfileImage)
        ? Url.Content("~/CustomerProfile/" + Model.ProfileImage)
        : "https://cdn-icons-png.flaticon.com/512/3135/3135715.png";

    int? age = null;
    if (Model.DateOfBirth.HasValue)
    {
        var today = DateTime.Today;
        age = today.Year - Model.DateOfBirth.Value.Year;
        if (Model.DateOfBirth.Value.Date > today.AddYears(-age.Value)) age--;
    }
}

<!-- Welcome Banner Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
    <div class="card-body p-4 p-md-5" style="background: linear-gradient(135deg, rgba(2,132,199,0.05) 0%, rgba(13,148,136,0.05) 100%);">
        <div class="row align-items-center g-4">
            <div class="col-auto">
                <div class="position-relative">
                    <img src="@profileImage" alt="@Model.FullName" class="rounded-circle shadow-sm border border-3 border-white object-fit-cover" style="width: 100px; height: 100px;" />
                    <span class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle p-2" title="Account Active"></span>
                </div>
            </div>
            <div class="col">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h2 class="fw-bold mb-0 text-dark">Welcome back, @Model.FullName!</h2>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">
                        <i class="fa-solid fa-circle-check me-1"></i> Verified Patient
                    </span>
                </div>
                <p class="text-muted mb-2">
                    <i class="fa-solid fa-envelope me-1 text-primary"></i> @Model.Email
                    <span class="mx-2">|</span>
                    <i class="fa-solid fa-phone me-1 text-success"></i> @Model.MobileNo
                </p>
                <div class="d-flex flex-wrap gap-3 small text-secondary">
                    <span><i class="fa-solid fa-calendar-day me-1"></i> Registered: @Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                    @if (!string.IsNullOrEmpty(Model.BloodGroup))
                    {
                        <span><i class="fa-solid fa-droplet text-danger me-1"></i> Blood Group: <strong>@Model.BloodGroup</strong></span>
                    }
                </div>
            </div>
            <div class="col-md-auto ms-auto">
                <a asp-action="EditProfile" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="fa-solid fa-user-pen me-2"></i> Edit Profile
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Overview Stats -->
<div class="row g-3 mb-4">
    <!-- Stat 1: Blood Group -->
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3.5 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 bg-danger-subtle text-danger">
                    <i class="fa-solid fa-droplet fa-2xl"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 fw-medium d-block">Blood Group</span>
                    <h4 class="fw-bold mb-0 text-dark">@(string.IsNullOrEmpty(Model.BloodGroup) ? "N/A" : Model.BloodGroup)</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 2: Active Doctors -->
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3.5 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 bg-primary-subtle text-primary">
                    <i class="fa-solid fa-user-doctor fa-2xl"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 fw-medium d-block">Available Doctors</span>
                    <h4 class="fw-bold mb-0 text-dark">@(ViewBag.TotalDoctors ?? 0)</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 3: Departments -->
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3.5 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 bg-teal-subtle text-teal" style="background-color: #ccfbf1; color: #0d9488;">
                    <i class="fa-solid fa-hospital-user fa-2xl"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 fw-medium d-block">Specialties</span>
                    <h4 class="fw-bold mb-0 text-dark">@(ViewBag.TotalDepartments ?? 0)</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 4: Account Status -->
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3.5 d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 bg-success-subtle text-success">
                    <i class="fa-solid fa-shield-halved fa-2xl"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 fw-medium d-block">Account Status</span>
                    <h4 class="fw-bold mb-0 text-success fs-5">Active</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Details Grid -->
<div class="row g-4">
    <!-- Customer Profile Info Card -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-address-card me-2 text-primary"></i> Personal Details</h5>
                <a asp-action="EditProfile" class="btn btn-sm btn-light rounded-pill fw-medium text-secondary">
                    <i class="fa-solid fa-pen me-1"></i> Update
                </a>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Full Name</small>
                            <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-user text-primary me-2"></i>@Model.FullName</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Gender</small>
                            <span class="fw-bold text-dark fs-6">
                                @if (Model.Gender == "Male")
                                {
                                    <i class="fa-solid fa-mars text-primary me-2"></i>
                                }
                                else if (Model.Gender == "Female")
                                {
                                    <i class="fa-solid fa-venus text-danger me-2"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-genderless text-warning me-2"></i>
                                }
                                @(string.IsNullOrEmpty(Model.Gender) ? "Not Specified" : Model.Gender)
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Email Address</small>
                            <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-envelope text-info me-2"></i>@Model.Email</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Mobile Number</small>
                            <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-phone text-success me-2"></i>@Model.MobileNo</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Date of Birth</small>
                            <span class="fw-bold text-dark fs-6">
                                <i class="fa-solid fa-cake-candles text-warning me-2"></i>
                                @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "Not provided")
                                @(age.HasValue ? $" ({age} yrs)" : "")
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Blood Group</small>
                            <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-droplet text-danger me-2"></i>@(string.IsNullOrEmpty(Model.BloodGroup) ? "Not provided" : Model.BloodGroup)</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block uppercase fs-8 font-monospace text-uppercase fw-semibold mb-1">Address & Location</small>
                            <div class="fw-medium text-dark">
                                <i class="fa-solid fa-location-dot text-danger me-2"></i>
                                @(string.IsNullOrEmpty(Model.Address) ? "No address specified." : Model.Address)
                                @if (!string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.State) || !string.IsNullOrEmpty(Model.Pincode))
                                {
                                    <br /><span class="ms-4 text-muted">@Model.City, @Model.State @(string.IsNullOrEmpty(Model.Pincode) ? "" : $"- {Model.Pincode}")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side Actions & Clinic Information -->
    <div class="col-lg-4">
        <div class="d-flex flex-column gap-4">
            <!-- Patient Quick Actions Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-bolt me-2 text-warning"></i> Quick Actions</h5>
                </div>
                <div class="card-body p-4 d-grid gap-2">
                    <a asp-action="EditProfile" class="btn btn-outline-primary text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-dark"><i class="fa-solid fa-user-pen me-2 text-primary"></i> Edit Profile</div>
                            <small class="text-muted">Update your phone, photo & address</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>

                    <a href="#" class="btn btn-outline-teal text-start p-3 rounded-3 d-flex align-items-center justify-content-between" style="border-color: #0d9488; color: #0d9488;">
                        <div>
                            <div class="fw-bold" style="color: #0d9488;"><i class="fa-solid fa-calendar-check me-2"></i> Book Appointment</div>
                            <small class="text-muted">Schedule consultation with specialist</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>

                    <a asp-action="Logout" class="btn btn-outline-danger text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out</div>
                            <small class="text-muted">Securely log out from portal</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>

            <!-- Clinic Help & Helpline Card -->
            <div class="card border-0 shadow-sm rounded-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-primary bg-opacity-25 rounded-circle p-3 text-primary">
                            <i class="fa-solid fa-headset fa-2xl"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-white">Need Assistance?</h6>
                            <small class="text-white-50">24/7 Clinic Helpline</small>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">Reach out to our patient care desk for emergency bookings, ambulance, or queries.</p>
                    <a href="tel:+18001234567" class="btn btn-light text-primary fw-bold w-100 rounded-pill py-2">
                        <i class="fa-solid fa-phone me-2"></i> Call +1 800 123 4567
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
