@model ClinicManagementSystem.Models.LabReportModel
@{
    ViewData["Title"] = "Lab Report #" + Model.ReportNo;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="MyLabReports" class="btn btn-outline-secondary rounded-pill"><i class="fa-solid fa-arrow-left me-1"></i> Back to My Reports</a>
    <a asp-action="DownloadLabReport" asp-route-id="@Model.LabReportId" target="_blank" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
        <i class="fa-solid fa-file-pdf me-2"></i> Download Official PDF Report
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-success text-white p-4 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-light text-success fw-semibold px-3 py-1 rounded-pill mb-2">Verified Report No: @Model.ReportNo</span>
                    <h3 class="fw-bold mb-0">@Model.TestName</h3>
                </div>
                <div class="text-end">
                    <span class="badge bg-white text-success fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-check-circle me-1"></i>Report Completed</span>
                </div>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <div class="row g-4 mb-4">
                    <!-- Report Info -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-file-medical me-2"></i>Report Summary</h6>
                            <table class="table table-borderless mb-0 fs-7">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Report Number:</th>
                                    <td class="fw-bold text-dark">@Model.ReportNo</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Report Title:</th>
                                    <td class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.ReportTitle) ? Model.TestName + " Report" : Model.ReportTitle)</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Report Date:</th>
                                    <td>@(Model.ReportDate.HasValue ? Model.ReportDate.Value.ToString("dd MMM yyyy, hh:mm tt") : "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Technician / Specialist:</th>
                                    <td class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.TechnicianName) ? "Diagnostic Specialist" : Model.TechnicianName)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Associated Patient & Booking -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border h-100">
                            <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-user-injured me-2"></i>Patient & Booking Info</h6>
                            <table class="table table-borderless mb-0 fs-7">
                                <tr>
                                    <th class="ps-0 text-secondary" style="width: 45%;">Patient Name:</th>
                                    <td class="fw-bold text-dark">@Model.PatientName</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Booking Reference:</th>
                                    <td class="fw-bold text-dark">@Model.BookingNo</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Contact Mobile:</th>
                                    <td>@Model.MobileNo</td>
                                </tr>
                                <tr>
                                    <th class="ps-0 text-secondary">Diagnostic Category:</th>
                                    <td><span class="badge bg-primary-subtle text-primary">@Model.TestCategory</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Report Remarks / Notes -->
                    @if (!string.IsNullOrEmpty(Model.ReportRemark))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-info-subtle border border-info rounded-4">
                                <h6 class="fw-bold text-info-emphasis mb-2"><i class="fa-solid fa-notes-medical me-2"></i>Pathologist Remarks & Clinical Notes</h6>
                                <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.ReportRemark</p>
                            </div>
                        </div>
                    }

                    <!-- PDF Action Box -->
                    <div class="col-12">
                        <div class="p-4 bg-light rounded-4 border d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa-solid fa-file-pdf fa-3x text-danger"></i>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Attached PDF File: @(string.IsNullOrEmpty(Model.ReportFile) ? "lab_report.pdf" : Model.ReportFile)</h6>
                                    <small class="text-muted">Download and print the official signed laboratory test report.</small>
                                </div>
                            </div>
                            <a asp-action="DownloadLabReport" asp-route-id="@Model.LabReportId" target="_blank" class="btn btn-success px-4 rounded-pill fw-semibold">
                                <i class="fa-solid fa-download me-1"></i> Download Report
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
