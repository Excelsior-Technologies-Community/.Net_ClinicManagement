@model ClinicManagementSystem.Models.DoctorModel

@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-lg-12">

            <div class="bg-primary text-white rounded-4 shadow p-4">

                <h2 class="fw-bold mb-2">
                    <i class="fa-solid fa-user-doctor me-2"></i>
                    Doctor Profile
                </h2>

                <p class="mb-0">
                    View complete doctor information and book your appointment.
                </p>

            </div>

        </div>
    </div>

    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-5">

            <div class="row">

                <!-- Doctor Image -->
                <div class="col-lg-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.DoctorImage))
                    {
                        <img src="~/Department/@Model.DoctorImage"
                             class="doctor-image shadow"
                             alt="Doctor Image" />
                    }
                    else
                    {
                        <img src="https://cdn-icons-png.flaticon.com/512/387/387561.png"
                             class="doctor-image shadow"
                             alt="Doctor Image" />
                    }

                    <h3 class="fw-bold mt-4 mb-2">
                        @Model.DoctorName
                    </h3>

                    <span class="badge bg-primary fs-6 px-3 py-2">
                        @Model.DepartmentName
                    </span>

                </div>

                <!-- Doctor Information -->
                <div class="col-lg-8">

                    <h4 class="fw-bold mb-4 text-primary">
                        Doctor Information
                    </h4>

                    <table class="table table-bordered align-middle">

                        <tr>
                            <th width="30%">Department</th>
                            <td>@Model.DepartmentName</td>
                        </tr>

                        <tr>
                            <th>Qualification</th>
                            <td>@Model.Qualification</td>
                        </tr>

                        <tr>
                            <th>Specialization</th>
                            <td>@Model.Specialization</td>
                        </tr>

                        <tr>
                            <th>Experience</th>
                            <td>@Model.Experience Years</td>
                        </tr>

                        <tr>
                            <th>Consultation Fee</th>
                            <td class="text-success fw-bold">
                                ₹@Model.ConsultationFee
                            </td>
                        </tr>

                        <tr>
                            <th>Available Time</th>
                            <td>
                                @Model.AvailableFrom -
                                @Model.AvailableTo
                            </td>
                        </tr>

                        <tr>
                            <th>Mobile Number</th>
                            <td>@Model.MobileNo</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>

                    </table>
                    <tr>
                        <th>Description</th>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">
                                    No description available.
                                </span>
                            }
                        </td>
                    </tr>

                    </table>

                    <!-- About Doctor -->
                    <div class="card border-0 bg-light rounded-4 mt-4">

                        <div class="card-body">

                            <h4 class="fw-bold text-primary mb-3">
                                <i class="fa-solid fa-stethoscope me-2"></i>
                                About Doctor
                            </h4>

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="mb-0 text-muted" style="text-align:justify;">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">
                                    This doctor is committed to providing
                                    high-quality medical care with compassion
                                    and professionalism.
                                </p>
                            }

                        </div>

                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-4">

                        <a asp-action="BookAppointment"
                           asp-route-doctorId="@Model.DoctorId"
                           class="btn btn-success btn-lg me-2">

                            <i class="fa-solid fa-calendar-check me-2"></i>

                            Book Appointment

                        </a>

                        <a asp-action="Doctors"
                           class="btn btn-outline-secondary btn-lg">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back to Doctors

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@section Styles {

    <style>

        .doctor-image {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            object-fit: cover;
            border: 6px solid #0d6efd;
            transition: .4s;
        }

            .doctor-image:hover {
                transform: scale(1.05);
                box-shadow: 0 15px 35px rgba(13,110,253,.30);
            }

        .card {
            border-radius: 20px;
        }

        .table th {
            background: #f8f9fa;
            color: #0d6efd;
            font-weight: 600;
            vertical-align: middle;
        }

        .table td {
            vertical-align: middle;
            color: #555;
        }

        .badge {
            font-size: 15px;
            letter-spacing: .5px;
        }

        .btn {
            border-radius: 10px;
            padding: 12px 28px;
            font-weight: 600;
            transition: .3s;
        }

        .btn-success:hover {
            transform: translateY(-2px);
        }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
        }

        .bg-primary {
            background: linear-gradient(135deg,#0d6efd,#3b82f6) !important;
        }

        .card-body h4 {
            border-left: 5px solid #0d6efd;
            padding-left: 12px;
        }

        .shadow {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

        .table tr:hover {
            background: #f8fbff;
        }

        .bg-light {
            border-left: 5px solid #0d6efd;
        }

        @@media(max-width:991px) {

            .doctor-image {
                width: 220px;
                height: 220px;
                margin-bottom: 25px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

        @@media(max-width:768px) {

            .doctor-image {
                width: 180px;
                height: 180px;
            }

            .table th,
            .table td {
                font-size: 14px;
            }

            h2 {
                font-size: 26px;
            }

            .card-body {
                padding: 25px !important;
            }
        }

        @@media(max-width:576px) {

            .doctor-image {
                width: 150px;
                height: 150px;
            }

            h2 {
                font-size: 22px;
            }

            h3 {
                font-size: 22px;
            }

            h4 {
                font-size: 18px;
            }

            .btn {
                font-size: 14px;
                padding: 10px;
            }
        }

    </style>

}