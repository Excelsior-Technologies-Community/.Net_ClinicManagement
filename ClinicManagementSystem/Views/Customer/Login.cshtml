@model ClinicManagementSystem.Models.CustomerModel
@{
    ViewData["Title"] = "Patient Sign In";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row justify-content-center align-items-center my-4" style="min-height: 70vh;">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Top Gradient Header -->
            <div class="card-header bg-gradient text-white p-4 text-center" style="background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%);">
                <div class="mb-2">
                    <span class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-user-shield fa-2xl"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-1">Patient Sign In</h3>
                <p class="text-white-50 small mb-0">Enter your credentials to access CarePoint Portal</p>
            </div>

            <div class="card-body p-4 p-sm-5 bg-white">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post" class="needs-validation">
                    @Html.AntiForgeryToken()

                    <!-- Email Input -->
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="e.g. patient@example.com" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold text-dark mb-1"></label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-key"></i></span>
                            <input asp-for="Password" id="loginPassword" type="password" class="form-control border-start-0 border-end-0 ps-0" placeholder="Enter your password" required />
                            <button class="btn btn-outline-secondary border-start-0 bg-light text-muted" type="button" id="toggleLoginPassword">
                                <i class="fa-solid fa-eye" id="loginEyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Login Button -->
                    <div class="d-grid gap-2 mb-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%); border: none;">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In to Portal
                        </button>
                    </div>

                    <!-- Register Link -->
                    <div class="text-center">
                        <p class="text-muted mb-0">Don't have an account yet? 
                            <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Create Account</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#toggleLoginPassword').on('click', function () {
            const passInput = $('#loginPassword');
            const eyeIcon = $('#loginEyeIcon');
            if (passInput.attr('type') === 'password') {
                passInput.attr('type', 'text');
                eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passInput.attr('type', 'password');
                eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });
    </script>
}
