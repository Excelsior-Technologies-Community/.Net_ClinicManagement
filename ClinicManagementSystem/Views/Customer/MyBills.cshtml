@model IEnumerable<ClinicManagementSystem.Models.BillingModel>

@{
    ViewData["Title"] = "My Bills";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="card border-0 shadow-lg mb-4">

        <div class="card-body text-white rounded"
             style="background:linear-gradient(135deg,#0d6efd,#4f8cff);">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <h2 class="fw-bold mb-2">

                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>

                        My Bills

                    </h2>

                    <p class="mb-0">

                        View all your medical bills, payment status and download invoices.

                    </p>

                </div>

                <div class="col-lg-4 text-end">

                    <a asp-action="Dashboard"
                       class="btn btn-light">

                        <i class="fa-solid fa-house me-2"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Dashboard Cards -->

    <div class="row mb-4">

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-file-invoice-dollar
                              fa-3x text-primary mb-3"></i>

                    <h3 class="fw-bold">

                        @ViewBag.TotalBills

                    </h3>

                    <h6 class="text-muted">

                        Total Bills

                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-circle-check
                              fa-3x text-success mb-3"></i>

                    <h3 class="fw-bold">

                        @ViewBag.PaidBills

                    </h3>

                    <h6 class="text-muted">

                        Paid Bills

                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-clock
                              fa-3x text-warning mb-3"></i>

                    <h3 class="fw-bold">

                        @ViewBag.PendingBills

                    </h3>

                    <h6 class="text-muted">

                        Pending Bills

                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-indian-rupee-sign
                              fa-3x text-danger mb-3"></i>

                    <h4 class="fw-bold text-success">

                        ₹ @ViewBag.TotalAmount

                    </h4>

                    <h6 class="text-muted">

                        Total Amount

                    </h6>

                </div>

            </div>

        </div>

    </div>

    <!-- Search & Filter -->

    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="MyBills">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">

                            Search

                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search Bill No or Doctor Name" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-bold">

                            Payment Status

                        </label>

                        <select name="paymentStatus"
                                class="form-select">

                            <option value="">All</option>

                            <option value="Paid"
                                    selected="@(ViewBag.PaymentStatus=="Paid")">

                                Paid

                            </option>

                            <option value="Pending"
                                    selected="@(ViewBag.PaymentStatus=="Pending")">

                                Pending

                            </option>

                        </select>

                    </div>

                    <div class="col-md-2 d-grid mb-3">

                        <label>&nbsp;</label>

                        <button class="btn btn-primary">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Bills Table -->

    <div class="card border-0 shadow">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="fa-solid fa-list me-2"></i>

                My Bill List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-primary">

                        <tr>

                            <th>#</th>

                            <th>Bill No</th>

                            <th>Appointment</th>

                            <th>Doctor</th>

                            <th>Department</th>

                            <th>Total</th>

                            <th>Payment</th>

                            <th>Date</th>

                            <th width="160">

                                Action

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">
                                        @sr
                                    </td>

                                    <td>
                                        <span class="fw-bold text-primary">
                                            @item.BillNo
                                        </span>
                                    </td>

                                    <td>
                                        @item.AppointmentNo
                                    </td>

                                    <td>
                                        Dr. @item.DoctorName
                                    </td>

                                    <td>
                                        @item.DepartmentName
                                    </td>

                                    <td>
                                        <span class="fw-bold text-success">
                                            ₹ @item.TotalAmount.ToString("0.00")
                                        </span>
                                    </td>

                                    <td>

                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fa-solid fa-clock me-1"></i>
                                                Pending
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.BillDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="ViewBill"
                                           asp-route-id="@item.BillingId"
                                           class="btn btn-info btn-sm mb-1"
                                           title="View Bill">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                        <a asp-action="DownloadBillPDF"
                                           asp-route-id="@item.BillingId"
                                           class="btn btn-danger btn-sm mb-1"
                                           title="Download PDF">

                                            <i class="fa-solid fa-file-pdf"></i>

                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9" class="text-center py-5">

                                    <i class="fa-solid fa-file-circle-xmark fa-4x text-secondary mb-3"></i>

                                    <h4 class="text-muted">
                                        No Bills Found
                                    </h4>

                                    <p class="text-muted mb-0">
                                        No billing records are available.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

    @section Styles {

        <style>

            body {
                background: #f5f7fb;
            }

            .card {
                border: none;
                border-radius: 18px;
                overflow: hidden;
                transition: .35s;
            }

                .card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 35px rgba(0,0,0,.10) !important;
                }

            .card-header {
                font-weight: 600;
            }

            .form-control,
            .form-select {
                min-height: 46px;
                border-radius: 10px;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 .15rem rgba(13,110,253,.20);
                }

            .table th {
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

            .table td {
                vertical-align: middle;
            }

            .table-hover tbody tr:hover {
                background: #f8fbff;
            }

            .badge {
                font-size: 13px;
                padding: 8px 15px;
                border-radius: 30px;
            }

            .btn {
                border-radius: 8px;
                transition: .30s;
            }

                .btn:hover {
                    transform: translateY(-2px);
                }

            .text-success {
                font-weight: 600;
            }

            @@media(max-width:992px) {

                .table {
                    min-width: 1100px;
                }
            }

            @@media(max-width:768px) {

                h2 {
                    font-size: 24px;
                }

                .btn {
                    margin-bottom: 5px;
                }
            }

        </style>

    }

    @section Scripts {

        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        @if (TempData["Success"] != null)
        {
            <script>

                Swal.fire({

                icon:'success',

                title:'Success',

                text:'@TempData["Success"]',

                confirmButtonColor:'#198754'

                });

            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>

                Swal.fire({

                icon:'error',

                title:'Error',

                text:'@TempData["Error"]',

                confirmButtonColor:'#dc3545'

                });

            </script>
        }

        <script>

            $(document).ready(function () {

                // Auto hide alerts

                window.setTimeout(function () {

                    $(".alert").fadeTo(500,0).slideUp(500,function(){

                        $(this).remove();

                    });

                },3000);

            });

        </script>

    }