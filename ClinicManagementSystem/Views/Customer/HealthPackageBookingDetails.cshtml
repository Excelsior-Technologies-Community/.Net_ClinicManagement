@model ClinicManagementSystem.Models.HealthPackageBookingModel

@{
    ViewData["Title"] = "Health Package Booking Details";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-file-medical text-primary me-2"></i>
                Booking Details
            </h3>

            <p class="text-muted mb-0">
                Complete details of your health package booking.
            </p>
        </div>

        <a asp-action="MyHealthPackageBookings"
           class="btn btn-outline-secondary rounded-pill px-4">

            <i class="fa-solid fa-arrow-left me-1"></i>
            My Bookings

        </a>

    </div>


    <!-- BOOKING HEADER -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

        <div class="booking-header">

            <div>
                <small class="text-white-50 d-block mb-1">
                    Booking Number
                </small>

                <h4 class="fw-bold mb-0">
                    @(string.IsNullOrWhiteSpace(Model.BookingNo)
                        ? "N/A"
                        : Model.BookingNo)
                </h4>
            </div>


            <div class="text-md-end mt-3 mt-md-0">

                <small class="text-white-50 d-block mb-2">
                    Booking Status
                </small>

                @if (Model.BookingStatus == "Confirmed")
                {
                    <span class="badge bg-success rounded-pill px-3 py-2">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Confirmed
                    </span>
                }
                else if (Model.BookingStatus == "Completed")
                {
                    <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                        <i class="fa-solid fa-flag-checkered me-1"></i>
                        Completed
                    </span>
                }
                else if (Model.BookingStatus == "Cancelled")
                {
                    <span class="badge bg-danger rounded-pill px-3 py-2">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                        <i class="fa-solid fa-clock me-1"></i>
                        Pending
                    </span>
                }

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- PACKAGE DETAILS -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-heart-pulse text-danger me-2"></i>
                        Health Package
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="package-box mb-4">

                        <div class="package-icon">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Package Name
                            </small>

                            <h5 class="fw-bold mb-0">
                                @(string.IsNullOrWhiteSpace(Model.PackageName)
                                    ? "N/A"
                                    : Model.PackageName)
                            </h5>

                        </div>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Package ID
                        </span>

                        <strong>
                            @Model.HealthPackageId
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Booking Amount
                        </span>

                        <strong class="text-success">
                            ₹@Model.Amount.ToString("N2")
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Payment Status
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                ? "Pending"
                                : Model.PaymentStatus)
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- PATIENT DETAILS -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-user text-primary me-2"></i>
                        Patient Information
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="detail-row">

                        <span class="text-muted">
                            Patient Name
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.PatientName)
                                ? "N/A"
                                : Model.PatientName)
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Mobile Number
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.MobileNo)
                                ? "N/A"
                                : Model.MobileNo)
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Email
                        </span>

                        <strong class="text-break">
                            @(string.IsNullOrWhiteSpace(Model.Email)
                                ? "N/A"
                                : Model.Email)
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="text-muted">
                            Customer ID
                        </span>

                        <strong>
                            @Model.CustomerId
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- SCHEDULE -->
        <div class="col-12">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-calendar-days text-primary me-2"></i>
                        Preferred Schedule
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="schedule-box">

                                <div class="schedule-icon">
                                    <i class="fa-regular fa-calendar"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Preferred Date
                                    </small>

                                    <strong>
                                        @(Model.PreferredDate.HasValue
                                            ? Model.PreferredDate.Value.ToString("dd MMM yyyy")
                                            : "Not Selected")
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="schedule-box">

                                <div class="schedule-icon">
                                    <i class="fa-regular fa-clock"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Preferred Time
                                    </small>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(Model.PreferredTime)
                                            ? "Not Selected"
                                            : Model.PreferredTime)
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- HEALTH CONCERN -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-notes-medical text-primary me-2"></i>
                        Health Concern
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (!string.IsNullOrWhiteSpace(Model.HealthConcern))
                    {
                        <div class="notes-box">
                            @Model.HealthConcern
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fa-regular fa-note-sticky me-2"></i>
                            No health concern provided.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ADMIN REMARK -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-comment-medical text-primary me-2"></i>
                        Clinic Remark
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (!string.IsNullOrWhiteSpace(Model.AdminRemark))
                    {
                        <div class="notes-box">
                            @Model.AdminRemark
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fa-regular fa-comment me-2"></i>
                            No remark added by clinic.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- BOOKING INFORMATION -->
        <div class="col-12">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>
                        Booking Information
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Booking Date
                            </small>

                            <strong>
                                @(Model.BookingDate.HasValue
                                    ? Model.BookingDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    : "Not Available")
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Created Date
                            </small>

                            <strong>
                                @(Model.CreatedDate.HasValue
                                    ? Model.CreatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    : "Not Available")
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Updated Date
                            </small>

                            <strong>
                                @(Model.UpdatedDate.HasValue
                                    ? Model.UpdatedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    : "Not Updated")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ACTION BUTTONS -->

    <div class="d-flex justify-content-between align-items-center mt-4">

        <a asp-action="MyHealthPackageBookings"
           class="btn btn-outline-secondary rounded-pill px-4">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to My Bookings

        </a>


        @if (Model.BookingStatus == "Pending")
        {
            <a asp-controller="Customer"
               asp-action="CancelHealthPackageBooking"
               asp-route-id="@Model.PackageBookingId"
               class="btn btn-outline-danger rounded-pill px-4"
               onclick="return confirm('Are you sure you want to cancel this booking?');">

                <i class="fa-solid fa-xmark me-1"></i>
                Cancel Booking

            </a>
        }

    </div>

</div>


<style>

    .booking-header {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: #fff;
        padding: 26px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .package-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        background: #fff5f6;
        border: 1px solid #f1d8dc;
        border-radius: 15px;
    }

    .package-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffe1e5;
        color: #dc3545;
        border-radius: 14px;
        font-size: 21px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f2;
    }

    .detail-row:last-child {
        border-bottom: 0;
    }

    .schedule-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        height: 100%;
    }

    .schedule-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f1ff;
        color: #0d6efd;
        border-radius: 12px;
        font-size: 19px;
    }

    .notes-box {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 18px;
        line-height: 1.7;
        color: #495057;
        white-space: pre-line;
    }

    .empty-box {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 18px;
        color: #6c757d;
    }

    @@media (max-width: 768px) {

        .booking-header {
            display: block;
        }

        .detail-row {
            flex-direction: column;
            gap: 5px;
        }

    }

</style>