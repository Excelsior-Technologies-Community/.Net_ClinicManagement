@model ClinicManagementSystem.Models.CustomerModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var currentImage = !string.IsNullOrEmpty(Model.ProfileImage)
        ? Url.Content("~/CustomerProfile/" + Model.ProfileImage)
        : "https://cdn-icons-png.flaticon.com/512/3135/3135715.png";
}

<div class="row justify-content-center my-3">
    <div class="col-lg-10 col-xl-9">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header bg-gradient text-white p-4" style="background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="fw-bold mb-1"><i class="fa-solid fa-user-pen me-2"></i>Edit Profile</h3>
                        <p class="mb-0 text-white-50 fs-6">Update your contact details and profile picture</p>
                    </div>
                    <a asp-action="Dashboard" class="btn btn-light rounded-pill px-3 fw-semibold text-primary shadow-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="fa-solid fa-circle-xmark me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />

                    <!-- Profile Image Section -->
                    <div class="text-center mb-4 pb-3 border-bottom">
                        <div class="position-relative d-inline-block">
                            <img id="editImgPreview" src="@currentImage" alt="Profile Image" class="rounded-circle shadow border border-4 border-light object-fit-cover" style="width: 120px; height: 120px;" />
                        </div>
                        <div class="mt-3 col-md-6 mx-auto">
                            <label class="form-label fw-semibold text-dark">Change Profile Picture</label>
                            <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" onchange="previewEditImage(this);" />
                            <small class="text-muted">Allowed formats: JPG, PNG, WEBP</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email (Read Only) -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Email address cannot be changed</small>
                        </div>

                        <!-- Mobile Number -->
                        <div class="col-md-6">
                            <label asp-for="MobileNo" class="form-label fw-semibold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="MobileNo" class="form-control" maxLength="10" />
                            <span asp-validation-for="MobileNo" class="text-danger small"></span>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold text-dark"></label> <span class="text-danger">*</span>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <!-- Blood Group -->
                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label fw-semibold text-dark"></label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">-- Select Blood Group --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-semibold text-dark"></label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <!-- State -->
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <!-- Pincode -->
                        <div class="col-md-4">
                            <label asp-for="Pincode" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Pincode" class="form-control" maxLength="6" />
                            <span asp-validation-for="Pincode" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Dashboard" class="btn btn-light px-4 rounded-pill fw-semibold">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%); border: none;">
                            <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewEditImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#editImgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
